---
import { getToolBySlug, type ToolMetadata } from '../lib/tools/registry';
import { url } from '../lib/url';

export interface Props {
  toolSlug: string;
  customHeading?: string;
  customText?: string;
}

const { toolSlug, customHeading, customText } = Astro.props;
const tool = getToolBySlug(toolSlug);
---

{tool && (
  <div class="tool-callout-box bg-slate-900/90 border-2 border-brand-500/40 rounded-xl p-5 my-8 shadow-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="flex-1">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-2xl">{tool.icon}</span>
        <h3 class="text-base font-bold text-slate-100 m-0">{customHeading || `Try the Free ${tool.name}`}</h3>
      </div>
      <p class="text-xs text-slate-300 m-0 leading-relaxed">
        {customText || tool.description} 100% private in-browser execution with zero file uploads.
      </p>
    </div>
    <a 
      href={url(tool.route)} 
      class="whitespace-nowrap px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold rounded-lg transition-colors shadow"
    >
      Open Tool &rarr;
    </a>
  </div>
)}
