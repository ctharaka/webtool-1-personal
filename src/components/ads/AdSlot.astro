---
/**
 * AdSlot.astro — Reusable Semantic Ad Unit
 * 
 * Invariant: If advertising is disabled in ad-config.ts, this component
 * renders NOTHING to ensure zero layout shifts, zero DOM bloat, and zero console errors.
 */
import { AD_CONFIG, isAdSlotActive, type AdSlotPosition } from './ad-config';

export interface Props {
  position: AdSlotPosition;
  customClass?: string;
  label?: boolean;
}

const { position, customClass = '', label = true } = Astro.props;
const active = isAdSlotActive(position);
const slotConfig = AD_CONFIG.slots[position];
---

{active && slotConfig && (
  <aside 
    class={`ad-slot-wrapper ad-slot--${position} ${customClass}`} 
    aria-label="Advertisement"
    data-ad-position={position}
  >
    {label && (
      <div class="ad-disclosure">
        <span>Advertisement</span>
      </div>
    )}
    
    <div 
      class="ad-slot-container"
      style={`min-height: ${slotConfig.minHeight}px; max-width: ${slotConfig.maxWidth ? slotConfig.maxWidth + 'px' : '100%'};`}
    >
      <!-- Google AdSense Tag Injection (Rendered only when client ID is valid) -->
      <ins
        class="adsbygoogle"
        style="display:block; text-align:center;"
        data-ad-client={AD_CONFIG.adsenseClientId}
        data-ad-slot={slotConfig.id}
        data-ad-format={slotConfig.format || 'auto'}
        data-full-width-responsive={slotConfig.responsive ? 'true' : 'false'}
      ></ins>
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  </aside>
)}

<style>
  .ad-slot-wrapper {
    margin: var(--space-6) auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ad-disclosure {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted, #64748b);
    margin-bottom: 0.25rem;
    user-select: none;
  }

  .ad-slot-container {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.02);
    border-radius: var(--radius-md, 0.5rem);
    border: 1px dashed var(--border-subtle, rgba(255, 255, 255, 0.08));
  }
</style>
