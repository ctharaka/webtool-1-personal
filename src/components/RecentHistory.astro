---
/**
 * RecentHistory.astro — Privacy-Preserving Recent Tool Activity Widget
 * Displays recent local tool usage metadata from localStorage.
 */
---

<div class="recent-history-widget" id="recent-history-widget" style="display: none;">
  <div class="recent-history-header">
    <div class="recent-history-title-wrap">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
        <polyline points="12 6 12 12 16 14" />
      </svg>
      <h3 class="recent-history-title">Recent Local Activity</h3>
    </div>
    <button type="button" class="clear-history-btn" id="clear-history-btn">Clear</button>
  </div>

  <p class="recent-history-privacy-note">
    🛡️ Processed locally on this device. File contents are never stored or uploaded.
  </p>

  <div class="recent-history-list" id="recent-history-list"></div>
</div>

<script>
  import { getRecentHistory, clearRecentHistory } from '../lib/history';

  document.addEventListener('DOMContentLoaded', () => {
    const widget = document.getElementById('recent-history-widget');
    const listEl = document.getElementById('recent-history-list');
    const clearBtn = document.getElementById('clear-history-btn');

    if (!widget || !listEl) return;

    function render() {
      const history = getRecentHistory();
      if (history.length === 0) {
        widget.style.display = 'none';
        return;
      }

      widget.style.display = 'block';
      while (listEl.firstChild) listEl.removeChild(listEl.firstChild);

      history.forEach((item) => {
        const row = document.createElement('a');
        row.href = item.toolUrl;
        row.className = 'history-item-row';

        const info = document.createElement('div');
        info.className = 'history-item-info';

        const toolName = document.createElement('span');
        toolName.className = 'history-item-tool';
        toolName.textContent = item.toolName;

        const meta = document.createElement('span');
        meta.className = 'history-item-meta';
        meta.textContent = `${item.filename}${item.summary ? ` (${item.summary})` : ''} · ${item.timestamp}`;

        info.appendChild(toolName);
        info.appendChild(meta);
        row.appendChild(info);

        listEl.appendChild(row);
      });
    }

    render();

    window.addEventListener('fft:history_updated', render);
    clearBtn?.addEventListener('click', () => {
      clearRecentHistory();
    });
  });
</script>

<style>
  .recent-history-widget {
    background: var(--surface-1);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    margin-top: var(--space-8);
  }

  .recent-history-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .recent-history-title-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-brand-400);
  }

  .recent-history-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
  }

  .clear-history-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    cursor: pointer;
    text-decoration: underline;
  }
  .clear-history-btn:hover {
    color: var(--color-error-400);
  }

  .recent-history-privacy-note {
    font-size: var(--font-size-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .recent-history-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .history-item-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2.5) var(--space-3);
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }

  .history-item-row:hover {
    border-color: var(--color-brand-400);
  }

  .history-item-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .history-item-tool {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
  }

  .history-item-meta {
    font-size: 11px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
