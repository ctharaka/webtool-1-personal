---
/**
 * Breadcrumbs component – renders a clean breadcrumb trail based on current URL.
 * Automatically outputs BreadcrumbList JSON-LD schema for search engines.
 */
const pathname = Astro.url.pathname;
const segments = pathname.split('/').filter(Boolean);

const knownLabels: Record<string, string> = {
  'heic-to-jpg': 'HEIC to JPG Converter',
  'mp4-to-mp3': 'MP4 to MP3 Converter',
  'zip-creator': 'ZIP Creator',
  'zip-extractor': 'ZIP Extractor',
  'social-image-resizer': 'Social Image Resizer',
  'favicon-generator': 'Favicon Generator',
  'image-crop-rotate': 'Image Crop & Rotate',
  'svg-to-png': 'SVG to PNG Converter',
  'png-to-jpg': 'PNG to JPG Converter',
  'jpg-to-png': 'JPG to PNG Converter',
  'pdf': 'PDF Tools',
  'image': 'Image Tools',
  'image-tools': 'Image Tools',
  'text-tools': 'Text Tools',
  'audio-tools': 'Audio Tools',
  'privacy-tools': 'Privacy Tools',
  'guides': 'Guides',
  'organize': 'Organize PDF',
  'sign': 'Sign PDF',
  'page-numbers': 'PDF Page Numbers',
  'watermark': 'PDF Watermark',
  'to-text': 'PDF to Text',
  'text-to-pdf': 'Text to PDF',
  'exif-remover': 'EXIF Remover'
};

function formatLabel(segment: string): string {
  if (knownLabels[segment]) return knownLabels[segment];
  return segment
    .split('-')
    .map(word => {
      const upper = word.toUpperCase();
      if (['PDF', 'JPG', 'JPEG', 'PNG', 'HEIC', 'MP3', 'MP4', 'WAV', 'SVG', 'ZIP', 'QR', 'JSON', 'CSV', 'AVIF', 'WEBP', 'EXIF', 'JWT', 'UUID', 'URL'].includes(upper)) {
        return upper === 'WEBP' ? 'WebP' : upper;
      }
      return word.charAt(0).toUpperCase() + word.slice(1);
    })
    .join(' ');
}

function getSegmentHref(segments: string[], index: number): string {
  let segPath = segments.slice(0, index + 1).join('/');
  if (segPath === 'image') segPath = 'image-tools';
  return '/' + segPath + '/';
}

const items = [
  { name: 'Home', url: 'https://freefiletool.app/' },
  ...segments.map((segment, index) => {
    const href = getSegmentHref(segments, index);
    return {
      name: formatLabel(segment),
      url: `https://freefiletool.app${href}`
    };
  })
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url
  }))
};
---

{segments.length > 0 && (
  <>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <nav aria-label="Breadcrumb" class="breadcrumb-nav mb-4 text-xs sm:text-sm font-medium">
      <ol class="flex flex-wrap items-center gap-2 text-slate-400">
        <li>
          <a href="/" class="hover:text-brand-400 transition-colors">Home</a>
        </li>
        {segments.map((segment, index) => {
          const href = getSegmentHref(segments, index);
          const isLast = index === segments.length - 1;
          const label = formatLabel(segment);
          return (
            <li class="flex items-center gap-2">
              <span class="text-slate-600">/</span>
              {isLast ? (
                <span class="text-slate-200 font-semibold" aria-current="page">
                  {label}
                </span>
              ) : (
                <a href={href} class="hover:text-brand-400 transition-colors">
                  {label}
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  </>
)}
