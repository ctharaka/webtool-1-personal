---
/**
 * PrivacyBadge.astro — Verified Local Processing Trust Indicator
 * 
 * Visually confirms that file processing occurs 100% inside client memory
 * with zero server uploads, building transparent user trust.
 */
export interface Props {
  variant?: 'badge' | 'banner' | 'card';
  showDetailsButton?: boolean;
  tech?: string;
}

const { 
  variant = 'badge', 
  showDetailsButton = true,
  tech = 'HTML5 Canvas & Client JavaScript'
} = Astro.props;
---

<div class={`privacy-trust-wrapper privacy-trust--${variant}`}>
  <div class="privacy-trust-pill" role="status" aria-label="Privacy guarantee">
    <span class="privacy-icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        <path d="M9 12l2 2 4-4" />
      </svg>
    </span>
    <span class="privacy-text">
      <strong>100% Private</strong> &middot; Runs locally in your browser
    </span>
    <span class="privacy-badge-tag">0 KB Uploaded</span>

    {showDetailsButton && (
      <button 
        type="button" 
        class="privacy-explain-trigger" 
        id="privacy-explain-btn"
        aria-label="Learn how local browser processing protects your privacy"
        title="Click to see how local processing works"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="16" x2="12" y2="12" />
          <line x1="12" y1="8" x2="12.01" y2="8" />
        </svg>
        <span>How it works</span>
      </button>
    )}
  </div>

  <!-- Accessible Modal / Backdrop -->
  <dialog class="privacy-modal" id="privacy-modal" aria-labelledby="privacy-modal-title">
    <div class="privacy-modal-content">
      <div class="privacy-modal-header">
        <div class="modal-title-wrap">
          <span class="modal-shield-icon" aria-hidden="true">🛡️</span>
          <h2 id="privacy-modal-title" class="privacy-modal-heading">How Local Processing Works</h2>
        </div>
        <button type="button" class="privacy-modal-close" id="privacy-modal-close" aria-label="Close dialog">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>

      <div class="privacy-modal-body">
        <div class="privacy-step-card">
          <span class="step-num">1</span>
          <div>
            <h3>Selected in Browser Memory</h3>
            <p>When you select or drop a file, your browser creates a temporary local <code>Blob</code> / <code>ArrayBuffer</code> pointer directly in your device's RAM.</p>
          </div>
        </div>

        <div class="privacy-step-card">
          <span class="step-num">2</span>
          <div>
            <h3>Processed Client-Side</h3>
            <p>Our client-side engine ({tech}) processes the data directly using your computer or phone's CPU.</p>
          </div>
        </div>

        <div class="privacy-step-card">
          <span class="step-num">3</span>
          <div>
            <h3>Saved Directly to Your Downloads</h3>
            <p>The resulting output is downloaded immediately to your device. When you close or refresh the tab, memory is cleared automatically.</p>
          </div>
        </div>

        <div class="privacy-verify-box">
          <h4 class="verify-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            Verify It Yourself
          </h4>
          <p>
            Open your browser's Developer Tools (<code>F12</code> or <code>Ctrl+Shift+I</code>), switch to the <strong>Network</strong> tab, and convert any file. You will see <strong>zero network POST requests</strong> carrying file data.
          </p>
        </div>
      </div>

      <div class="privacy-modal-footer">
        <button type="button" class="btn-primary" id="privacy-modal-ok">Got it, thanks</button>
      </div>
    </div>
  </dialog>
</div>

<script>
  function initPrivacyModal() {
    const trigger = document.getElementById('privacy-explain-btn');
    const modal = document.getElementById('privacy-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('privacy-modal-close');
    const okBtn = document.getElementById('privacy-modal-ok');

    if (!trigger || !modal) return;

    trigger.addEventListener('click', () => {
      if (typeof modal.showModal === 'function') {
        modal.showModal();
      } else {
        modal.setAttribute('open', 'true');
      }
    });

    const closeModal = () => {
      if (typeof modal.close === 'function') {
        modal.close();
      } else {
        modal.removeAttribute('open');
      }
    };

    closeBtn?.addEventListener('click', closeModal);
    okBtn?.addEventListener('click', closeModal);

    // Close on clicking backdrop
    modal.addEventListener('click', (e) => {
      const rect = modal.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        closeModal();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initPrivacyModal);
</script>

<style>
  .privacy-trust-wrapper {
    display: inline-flex;
    align-items: center;
    margin: var(--space-3, 0.75rem) 0;
  }

  .privacy-trust-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    padding: 0.35rem 0.85rem;
    background: rgba(45, 212, 191, 0.08);
    border: 1px solid rgba(45, 212, 191, 0.25);
    border-radius: var(--radius-full, 9999px);
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--text-secondary, #94a3b8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    flex-wrap: wrap;
  }

  .privacy-icon {
    color: var(--color-accent-400, #2dd4bf);
    display: flex;
    align-items: center;
  }

  .privacy-text strong {
    color: #f8fafc;
    font-weight: 600;
  }

  .privacy-badge-tag {
    background: rgba(34, 197, 94, 0.15);
    color: var(--color-success-400, #4ade80);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm, 0.375rem);
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
  }

  .privacy-explain-trigger {
    background: transparent;
    border: none;
    color: var(--color-brand-400, #818cf8);
    font-size: 0.75rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.1rem 0.3rem;
    border-radius: var(--radius-sm, 0.375rem);
    transition: all var(--transition-fast, 150ms ease);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .privacy-explain-trigger:hover {
    color: #fff;
    background: rgba(129, 140, 248, 0.15);
  }

  /* ── Modal Dialog ────────────────────────────────────────── */
  .privacy-modal {
    background: var(--surface-1, #121526);
    color: var(--text-primary, #f8fafc);
    border: 1px solid var(--border-default, rgba(255, 255, 255, 0.14));
    border-radius: var(--radius-xl, 1rem);
    padding: 0;
    max-width: 34rem;
    width: 90vw;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.85);
  }

  .privacy-modal::backdrop {
    background: rgba(11, 13, 23, 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .privacy-modal-content {
    padding: var(--space-6, 1.5rem);
  }

  .privacy-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4, 1rem);
    border-bottom: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    padding-bottom: var(--space-3, 0.75rem);
  }

  .modal-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .privacy-modal-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }

  .privacy-modal-close {
    background: transparent;
    border: none;
    color: var(--text-muted, #64748b);
    cursor: pointer;
    padding: 0.35rem;
    border-radius: var(--radius-md, 0.5rem);
    display: flex;
  }

  .privacy-modal-close:hover {
    color: #fff;
    background: var(--surface-2, #1a1e35);
  }

  .privacy-modal-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
  }

  .privacy-step-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3, 0.75rem);
    background: var(--surface-2, #1a1e35);
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    border-radius: var(--radius-lg, 0.75rem);
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
  }

  .step-num {
    width: 24px;
    height: 24px;
    background: var(--color-brand-600, #4f46e5);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8125rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .privacy-step-card h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 0.15rem;
  }

  .privacy-step-card p {
    font-size: 0.8125rem;
    color: var(--text-secondary, #94a3b8);
    line-height: 1.4;
    margin: 0;
  }

  .privacy-step-card code {
    background: rgba(0, 0, 0, 0.35);
    padding: 0.1rem 0.3rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-accent-400, #2dd4bf);
  }

  .privacy-verify-box {
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.25);
    border-radius: var(--radius-lg, 0.75rem);
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    margin-top: 0.25rem;
  }

  .verify-title {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-success-400, #4ade80);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .privacy-verify-box p {
    font-size: 0.8125rem;
    color: var(--text-secondary, #94a3b8);
    line-height: 1.4;
    margin: 0;
  }

  .privacy-modal-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-4, 1rem);
    padding-top: var(--space-3, 0.75rem);
    border-top: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
  }

  .btn-primary {
    background: var(--color-brand-600, #4f46e5);
    color: #fff;
    border: none;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-md, 0.5rem);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--transition-fast, 150ms ease);
  }

  .btn-primary:hover {
    background: var(--color-brand-500, #6366f1);
  }
</style>
