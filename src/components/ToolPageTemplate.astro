---
/**
 * ToolPageTemplate.astro — Unified compact layout for FreeFileTool developer & utility tools
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PrivacyBadge from '../components/PrivacyBadge.astro';
import RelatedTools from '../components/RelatedTools.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

export interface Props {
  toolSlug: string;
  toolName: string;
  title: string;
  description: string;
  badge?: string;
  faqItems: Array<{ question: string; answer: string }>;
  featureList?: string[];
}

const {
  toolSlug,
  toolName,
  title,
  description,
  badge = "Developer & Text Tools",
  faqItems = [],
  featureList = [
    "100% in-browser processing with zero file uploads",
    "Instant real-time execution",
    "Fully private client-side execution"
  ]
} = Astro.props;

const canonicalURL = `https://freefiletool.app/${toolSlug}`;
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "name": `FreeFileTool ${toolName}`,
        "url": canonicalURL,
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "All",
        "browserRequirements": "Requires JavaScript",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "featureList": featureList
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqItems.map((item) => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ]
  })} />

  <div class="tool-page-container max-w-6xl mx-auto px-4 py-8">
    <Breadcrumbs />

    <header class="tool-hero text-center mb-8">
      <div class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-400 border border-brand-500/20 mb-3">
        {badge}
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-100 mb-3">{toolName}</h1>
      <p class="text-slate-400 max-w-2xl mx-auto text-base sm:text-lg mb-4">{description}</p>
      <div class="flex justify-center">
        <PrivacyBadge variant="badge" />
      </div>
    </header>

    <AdSlot position="top-leaderboard" />

    <main class="tool-workspace my-8 bg-slate-900/60 border border-slate-800 rounded-xl p-4 sm:p-6 shadow-xl">
      <slot />
    </main>

    <AdSlot position="in-content" />

    <section class="tool-guide-content prose prose-invert max-w-none my-12 bg-slate-900/40 border border-slate-800/80 rounded-xl p-6 sm:p-8">
      <slot name="guide" />

      {faqItems.length > 0 && (
        <div class="tool-faq-block mt-10 pt-8 border-t border-slate-800">
          <h2 class="text-2xl font-bold text-slate-100 mb-6">Frequently Asked Questions</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {faqItems.map((item) => (
              <div class="faq-item-card bg-slate-800/50 border border-slate-700/50 rounded-lg p-5">
                <h3 class="text-lg font-semibold text-slate-200 mb-2">{item.question}</h3>
                <p class="text-slate-400 text-sm leading-relaxed">{item.answer}</p>
              </div>
            ))}
          </div>
        </div>
      )}
    </section>

    <RelatedTools currentSlug={toolSlug} limit={4} />
  </div>
</BaseLayout>
