---
/**
 * RecentlyUsedStrip.astro — Displays recently used tools saved in browser localStorage.
 */
---

<div id="recently-used-container" class="hidden my-6 p-4 bg-slate-900/60 border border-slate-800 rounded-xl">
  <div class="flex items-center justify-between mb-3">
    <div class="flex items-center gap-2">
      <span class="text-sm">🕒</span>
      <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider">Recently Used Tools</h3>
    </div>
    <button id="clear-recent-btn" class="text-[11px] text-slate-500 hover:text-slate-300 underline">Clear history</button>
  </div>
  <div id="recently-used-list" class="flex flex-wrap gap-2"></div>
</div>

<script>
  function renderRecentlyUsed() {
    const container = document.getElementById('recently-used-container');
    const list = document.getElementById('recently-used-list');
    const clearBtn = document.getElementById('clear-recent-btn');

    if (!container || !list) return;

    try {
      const stored = localStorage.getItem('fft_recent_tools');
      if (!stored) {
        container.classList.add('hidden');
        return;
      }
      const items: Array<{ slug: string; name: string; route: string; icon: string }> = JSON.parse(stored);
      if (!Array.isArray(items) || items.length === 0) {
        container.classList.add('hidden');
        return;
      }

      list.innerHTML = '';
      items.slice(0, 6).forEach(item => {
        const chip = document.createElement('a');
        chip.href = item.route;
        chip.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-800 hover:bg-slate-700 border border-slate-700/80 rounded-full text-xs font-medium text-slate-300 hover:text-slate-100 transition-colors';
        chip.innerHTML = `<span>${item.icon || '⚡'}</span><span>${item.name}</span>`;
        list.appendChild(chip);
      });

      container.classList.remove('hidden');

      clearBtn?.addEventListener('click', () => {
        try {
          localStorage.removeItem('fft_recent_tools');
          container.classList.add('hidden');
        } catch (e) {}
      });
    } catch (err) {
      container.classList.add('hidden');
    }
  }

  document.addEventListener('DOMContentLoaded', renderRecentlyUsed);
</script>
