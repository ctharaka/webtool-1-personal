---
/**
 * RecommendationCard.astro — Ethical Transparent Recommendation Unit
 * 
 * Complies with FTC disclosure requirements for optional partner tools.
 */
export interface Props {
  title: string;
  description: string;
  link: string;
  badge?: string;
  ctaText?: string;
  isSponsored?: boolean;
}

const { 
  title, 
  description, 
  link, 
  badge = "Recommended Resource", 
  ctaText = "Learn More", 
  isSponsored = true 
} = Astro.props;
---

<div class="recommendation-card-wrapper" role="complementary" aria-label={title}>
  {isSponsored && (
    <div class="rec-disclosure">
      <span>Sponsored Recommendation</span>
    </div>
  )}

  <div class="rec-card-inner">
    <div class="rec-card-body">
      <span class="rec-badge">{badge}</span>
      <h3 class="rec-title">{title}</h3>
      <p class="rec-desc">{description}</p>
    </div>

    <div class="rec-card-cta">
      <a 
        href={link} 
        target="_blank" 
        rel="noopener noreferrer sponsored" 
        class="rec-btn"
      >
        <span>{ctaText}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          <polyline points="15 3 21 3 21 9" />
          <line x1="10" y1="14" x2="21" y2="3" />
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  .recommendation-card-wrapper {
    margin: var(--space-6, 1.5rem) 0;
  }

  .rec-disclosure {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted, #64748b);
    margin-bottom: 0.25rem;
  }

  .rec-card-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4, 1rem);
    background: var(--surface-1, #121526);
    border: 1px solid var(--border-default, rgba(255, 255, 255, 0.14));
    border-radius: var(--radius-lg, 0.75rem);
    padding: var(--space-4, 1rem) var(--space-5, 1.25rem);
    flex-wrap: wrap;
  }

  .rec-card-body {
    max-width: 40rem;
  }

  .rec-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-accent-400, #2dd4bf);
    background: rgba(45, 212, 191, 0.1);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm, 0.375rem);
    display: inline-block;
    margin-bottom: 0.35rem;
  }

  .rec-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #f8fafc);
    margin: 0 0 0.2rem 0;
  }

  .rec-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary, #94a3b8);
    margin: 0;
    line-height: 1.4;
  }

  .rec-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--color-brand-600, #4f46e5);
    color: #fff;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-md, 0.5rem);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition: background var(--transition-fast, 150ms ease);
    white-space: nowrap;
  }

  .rec-btn:hover {
    background: var(--color-brand-500, #6366f1);
  }
</style>
