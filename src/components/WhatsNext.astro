---
import { getToolBySlug, getRelatedTools, type ToolMetadata } from '../lib/tools/registry';
import { url } from '../lib/url';

export interface Props {
  currentSlug: string;
  customNextSlugs?: string[];
  limit?: number;
}

const { currentSlug, customNextSlugs, limit = 3 } = Astro.props;

const currentTool = getToolBySlug(currentSlug);
let nextTools: ToolMetadata[] = [];

if (customNextSlugs && customNextSlugs.length > 0) {
  nextTools = customNextSlugs.map(s => getToolBySlug(s)).filter((t): t is ToolMetadata => Boolean(t));
}

if (nextTools.length === 0 && currentTool?.nextSteps) {
  nextTools = currentTool.nextSteps.map(s => getToolBySlug(s)).filter((t): t is ToolMetadata => Boolean(t));
}

if (nextTools.length < limit) {
  const fallback = getRelatedTools(currentSlug, limit);
  fallback.forEach(t => {
    if (!nextTools.some(n => n.slug === t.slug)) {
      nextTools.push(t);
    }
  });
}

nextTools = nextTools.slice(0, limit);
---

{nextTools.length > 0 && (
  <div class="whats-next-panel bg-slate-900/80 border border-brand-500/30 rounded-xl p-5 my-6 shadow-lg">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-xl">🚀</span>
      <h3 class="text-base font-bold text-slate-100">What's Next? (Recommended Workflow)</h3>
    </div>
    <p class="text-xs text-slate-400 mb-4">
      Your file is processed! Continue your document or image workflow with these recommended next steps:
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {nextTools.map(tool => (
        <a 
          href={url(tool.route)} 
          class="block bg-slate-800/80 hover:bg-slate-700/90 border border-slate-700/80 hover:border-brand-500/50 rounded-lg p-3 transition-all group"
        >
          <div class="flex items-center justify-between mb-1">
            <span class="text-lg">{tool.icon}</span>
            <span class="text-xs text-brand-400 font-semibold group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
          <h4 class="text-xs font-bold text-slate-200 group-hover:text-brand-300">{tool.name}</h4>
          <p class="text-[11px] text-slate-400 line-clamp-2 mt-1">{tool.oneLiner}</p>
        </a>
      ))}
    </div>
  </div>
)}
