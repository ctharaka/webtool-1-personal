<!-- src/components/ConsentBanner.astro -->
---
// No frontmatter needed
---
<div id="consent-banner" class="fixed bottom-0 left-0 w-full bg-surface-2 text-text-primary p-4 flex items-center justify-between md:max-w-2xl md:mx-auto md:rounded-lg md:shadow-xl hidden">
  <p class="text-sm mr-4">
    We use cookies to improve your experience and may show personalized ads. By continuing you accept our <a href="/privacy-policy" class="underline" target="_blank">Privacy Policy</a>.
  </p>
  <button id="consent-accept" class="px-3 py-1 bg-brand-500 text-white rounded hover:bg-brand-400 transition">Accept</button>
</div>
<script>
  const banner = document.getElementById('consent-banner');
  const acceptBtn = document.getElementById('consent-accept');
  if (!localStorage.getItem('fftools_consent')) {
    banner.classList.remove('hidden');
  }
  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem('fftools_consent', 'true');
    banner.classList.add('hidden');
  });
</script>
