---
/**
 * pdf-tools/pdf-to-images.astro — Dedicated PDF to Images Tool Landing Page
 * Full client-side PDF rasterization to PNG or JPG via PDF.js and Canvas.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PdfZone from '../../components/PdfZone.astro';
---

<BaseLayout
  title="PDF to Images Converter — Convert PDF to PNG or JPG Online | FreeFileTools"
  description="Convert PDF pages to high-resolution PNG or JPG images in your browser. 100% client-side rasterization, customizable DPI, and batch ZIP download."
  canonicalURL="https://freefiletool.app/pdf-tools/pdf-to-images"
>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "HowTo",
          "name": "How to Convert PDF Pages to Images Online in Your Browser",
          "description": "Step-by-step instructions to convert PDF pages into PNG or JPG image files using client-side HTML5 Canvas and PDF.js.",
          "step": [
            {
              "@type": "HowToStep",
              "name": "Select or Drop PDF File",
              "text": "Upload your PDF document into the dropzone."
            },
            {
              "@type": "HowToStep",
              "name": "Choose Format & Resolution",
              "text": "Select PNG (lossless) or JPG (compressed), and pick your desired DPI scale (72, 108, or 144 DPI)."
            },
            {
              "@type": "HowToStep",
              "name": "Convert Pages",
              "text": "Click Convert to Images to render each page locally on HTML5 Canvas."
            },
            {
              "@type": "HowToStep",
              "name": "Download Images",
              "text": "Download individual page images or retrieve all pages in a single ZIP file."
            }
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Should I choose PNG or JPG format?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Choose PNG for blueprints, text-heavy scans, and charts to preserve razor-sharp lines and avoid compression artifacts. Choose JPG for photographs or scanned books to keep file sizes small."
              }
            },
            {
              "@type": "Question",
              "name": "What resolution does FreeFileTools render at?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "You can select Standard (108 DPI, 1.5x scale), High-Res (144 DPI, 2.0x scale), or Compact (72 DPI, 1.0x scale) depending on your needs."
              }
            },
            {
              "@type": "Question",
              "name": "Are my files kept private?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes! The entire rasterization process uses Mozilla PDF.js locally in your browser. No image data is sent to external servers."
              }
            }
          ]
        }
      ]
    }
  </script>

  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
      <li><a href="/">Home</a></li>
      <li aria-hidden="true">&rsaquo;</li>
      <li><a href="/pdf-tools">PDF Tools</a></li>
      <li aria-hidden="true">&rsaquo;</li>
      <li aria-current="page">PDF to Images</li>
    </ol>
  </nav>

  <section class="tool-hero">
    <div class="tool-hero__badge">PDF to Raster</div>
    <h1 class="tool-hero__title">PDF to Images Converter</h1>
    <p class="tool-hero__desc">
      Render PDF pages into sharp PNG or JPG image files directly in your web browser. 100% private, with selectable resolution and instant ZIP export.
    </p>
  </section>

  <!-- AdSense Slot: Above main tool -->
  <div class="adsense-slot" aria-label="Advertisement"></div>

  <section class="upload-section">
    <PdfZone mode="pdf-to-images" outputFormat="png" id="pdf-to-images-zone" />
  </section>

  <!-- Quick Answer Box -->
  <div class="quick-answer" role="note">
    <p class="quick-answer__label">✦ Quick Answer</p>
    <p class="quick-answer__q">How does browser-side PDF-to-Image rendering work?</p>
    <p class="quick-answer__a">
      FreeFileTools dynamically loads <code>pdfjs-dist</code> in an isolated client-side worker thread. Each vector PDF page is painted onto an off-screen HTML5 <code>&lt;canvas&gt;</code> element at your specified resolution and converted directly to an image blob.
    </p>
  </div>

  <!-- Related Tools -->
  <section class="related-tools">
    <h2 class="related-tools__title">Related PDF Utilities</h2>
    <div class="related-grid">
      <a href="/pdf-tools/images-to-pdf" class="related-card">
        <span class="related-card__name">Images to PDF &rarr;</span>
        <span class="related-card__desc">Convert JPG and PNG photos into a PDF.</span>
      </a>
      <a href="/pdf-tools/pdf-page-extractor" class="related-card">
        <span class="related-card__name">Page Extractor &rarr;</span>
        <span class="related-card__desc">Extract a single page as an independent PDF.</span>
      </a>
      <a href="/pdf-tools/split-pdf" class="related-card">
        <span class="related-card__name">Split PDF &rarr;</span>
        <span class="related-card__desc">Split pages or custom ranges.</span>
      </a>
      <a href="/pdf-tools" class="related-card">
        <span class="related-card__name">All PDF Tools &rarr;</span>
        <span class="related-card__desc">Browse the complete suite of PDF tools.</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  @import '../../styles/pdf-tools.css';

  .breadcrumb-nav {
    max-width: 800px;
    margin: 1.5rem auto 0;
    padding: 0 1.25rem;
  }
  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    font-size: 0.875rem;
    color: var(--text-muted, #64748b);
  }
  .breadcrumb-list a {
    color: var(--color-brand-400, #38bdf8);
    text-decoration: none;
  }
  .breadcrumb-list a:hover {
    text-decoration: underline;
  }
  .tool-hero {
    text-align: center;
    padding: 2rem 1.25rem 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }
  .tool-hero__badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand-400, #38bdf8);
    background: rgba(56, 189, 248, 0.1);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }
  .tool-hero__title {
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.75rem;
  }
  .tool-hero__desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary, #94a3b8);
  }
  .upload-section {
    max-width: 800px;
    margin: 1.5rem auto 2.5rem;
    padding: 0 1.25rem;
  }
  .quick-answer {
    max-width: 800px;
    margin: 2rem auto;
    padding: 1.5rem;
    background: var(--surface-1, #1e1e24);
    border: 1px solid var(--border-color, #2a2a35);
    border-radius: 0.75rem;
  }
  .quick-answer__label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-accent-400, #a855f7);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }
  .quick-answer__q {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .quick-answer__a {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary, #94a3b8);
  }
  .related-tools {
    max-width: 800px;
    margin: 3rem auto 4rem;
    padding: 0 1.25rem;
    border-top: 1px solid var(--border-color, #2a2a35);
    padding-top: 2rem;
  }
  .related-tools__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 1rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .related-card {
    background: var(--surface-1, #1e1e24);
    border: 1px solid var(--border-color, #2a2a35);
    border-radius: 0.5rem;
    padding: 1rem;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .related-card:hover {
    border-color: var(--color-brand-400, #38bdf8);
  }
  .related-card__name {
    display: block;
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--color-brand-400, #38bdf8);
    margin-bottom: 0.25rem;
  }
  .related-card__desc {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-secondary, #94a3b8);
  }
</style>
