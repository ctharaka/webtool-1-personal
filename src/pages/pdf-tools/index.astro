---
/**
 * pdf-tools/index.astro — PDF Tools Category Hub Page
 * Centralized hub for FreeFileTools' client-side PDF tool cluster.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Free Online PDF Tools — 100% Private Client-Side PDF Suite | FreeFileTools"
  description="Merge, split, compress, extract pages, and convert PDF files directly in your web browser. 100% private, zero server uploads, lightning-fast client-side execution."
  canonicalURL="https://freefiletool.app/pdf-tools"
>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Free Online PDF Tools",
      "description": "Comprehensive suite of client-side PDF manipulation tools for merging, splitting, compressing, extracting pages, and converting PDF documents in your browser.",
      "url": "https://freefiletool.app/pdf-tools",
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Merge PDF",
            "url": "https://freefiletool.app/pdf-tools/merge-pdf"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Split PDF",
            "url": "https://freefiletool.app/pdf-tools/split-pdf"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Compress PDF",
            "url": "https://freefiletool.app/pdf-tools/compress-pdf"
          },
          {
            "@type": "ListItem",
            "position": 4,
            "name": "PDF to Images",
            "url": "https://freefiletool.app/pdf-tools/pdf-to-images"
          },
          {
            "@type": "ListItem",
            "position": 5,
            "name": "Images to PDF",
            "url": "https://freefiletool.app/pdf-tools/images-to-pdf"
          },
          {
            "@type": "ListItem",
            "position": 6,
            "name": "PDF Page Extractor",
            "url": "https://freefiletool.app/pdf-tools/pdf-page-extractor"
          }
        ]
      }
    }
  </script>

  <section class="hub-hero">
    <div class="hub-hero__badge">Client-Side PDF Suite</div>
    <h1 class="hub-hero__title">Free Online PDF Tools</h1>
    <p class="hub-hero__desc">
      Powerful PDF utilities running entirely inside your browser. No files are uploaded to any server. Your sensitive contracts, invoices, and documents stay 100% confidential.
    </p>

    <div class="pdf-privacy-callout" role="note">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
      </svg>
      <div>
        <strong>100% Client-Side Privacy:</strong> All processing is done locally in your browser RAM using WebAssembly and JavaScript (<code>pdf-lib</code> and <code>pdf.js</code>). Zero tracking, zero telemetry, zero server uploads.
      </div>
    </div>
  </section>

  <!-- Hub Grid -->
  <section class="pdf-tools-hub">
    <div class="pdf-tools-grid">
      <!-- Merge PDF -->
      <a href="/pdf-tools/merge-pdf" class="pdf-tool-card">
        <span class="pdf-tool-card__badge">Combine</span>
        <h2 class="pdf-tool-card__title">Merge PDF</h2>
        <p class="pdf-tool-card__desc">
          Combine two or more PDF files into a single organized document. Reorder pages and files before merging.
        </p>
        <div class="pdf-tool-card__footer">
          <span>Open Tool &rarr;</span>
          <span class="badge-tag">pdf-lib</span>
        </div>
      </a>

      <!-- Split PDF -->
      <a href="/pdf-tools/split-pdf" class="pdf-tool-card">
        <span class="pdf-tool-card__badge">Divide</span>
        <h2 class="pdf-tool-card__title">Split PDF</h2>
        <p class="pdf-tool-card__desc">
          Split a PDF file by custom page ranges (e.g., 1-3, 5) or separate all pages into individual files bundled in a ZIP archive.
        </p>
        <div class="pdf-tool-card__footer">
          <span>Open Tool &rarr;</span>
          <span class="badge-tag">Ranges &amp; ZIP</span>
        </div>
      </a>

      <!-- Compress PDF -->
      <a href="/pdf-tools/compress-pdf" class="pdf-tool-card">
        <span class="pdf-tool-card__badge">Optimize</span>
        <h2 class="pdf-tool-card__title">Compress PDF</h2>
        <p class="pdf-tool-card__desc">
          Reduce PDF file size by optimizing object streams and stripping redundant structural metadata while preserving vector clarity.
        </p>
        <div class="pdf-tool-card__footer">
          <span>Open Tool &rarr;</span>
          <span class="badge-tag">Stream Optimization</span>
        </div>
      </a>

      <!-- PDF to Images -->
      <a href="/pdf-tools/pdf-to-images" class="pdf-tool-card">
        <span class="pdf-tool-card__badge">Convert</span>
        <h2 class="pdf-tool-card__title">PDF to Images</h2>
        <p class="pdf-tool-card__desc">
          Convert PDF pages into high-resolution PNG or JPG graphics. Selectable DPI resolution and batch ZIP download.
        </p>
        <div class="pdf-tool-card__footer">
          <span>Open Tool &rarr;</span>
          <span class="badge-tag">PNG / JPG</span>
        </div>
      </a>

      <!-- Images to PDF -->
      <a href="/pdf-tools/images-to-pdf" class="pdf-tool-card">
        <span class="pdf-tool-card__badge">Create</span>
        <h2 class="pdf-tool-card__title">Images to PDF</h2>
        <p class="pdf-tool-card__desc">
          Convert JPG and PNG photos into a clean multi-page PDF document with custom page sizing and orientation options.
        </p>
        <div class="pdf-tool-card__footer">
          <span>Open Tool &rarr;</span>
          <span class="badge-tag">Multi-Image</span>
        </div>
      </a>

      <!-- PDF Page Extractor -->
      <a href="/pdf-tools/pdf-page-extractor" class="pdf-tool-card">
        <span class="pdf-tool-card__badge">Extract</span>
        <h2 class="pdf-tool-card__title">PDF Page Extractor</h2>
        <p class="pdf-tool-card__desc">
          Extract any single specific page from a PDF document and instantly download it as an independent PDF file.
        </p>
        <div class="pdf-tool-card__footer">
          <span>Open Tool &rarr;</span>
          <span class="badge-tag">Single Page</span>
        </div>
      </a>
    </div>

    <!-- Editorial Guide Section -->
    <div class="guide-banner">
      <div class="guide-banner__content">
        <span class="guide-banner__tag">Educational Resource</span>
        <h3 class="guide-banner__title">Mastering Client-Side PDF Tools</h3>
        <p class="guide-banner__desc">
          Read our in-depth technical guide on how in-browser PDF manipulation works, privacy standards, stream compaction, and vector font preservation.
        </p>
        <a href="/guides/pdf-tools" class="guide-banner__link">Read the Complete PDF Guide &rarr;</a>
      </div>
    </div>

    <!-- Hub FAQ Section -->
    <section class="hub-faq">
      <h2 class="hub-faq__title">Frequently Asked Questions</h2>
      <div class="faq-grid">
        <div class="faq-item">
          <h3 class="faq-item__q">Are my files uploaded to FreeFileTools servers?</h3>
          <p class="faq-item__a">
            No. Every PDF operation runs 100% locally inside your browser memory. Your documents never touch our servers or any third-party infrastructure.
          </p>
        </div>
        <div class="faq-item">
          <h3 class="faq-item__q">What is the maximum file size supported?</h3>
          <p class="faq-item__a">
            We support PDF documents up to 50 MB. Because processing uses your device's memory, this boundary ensures smooth performance even on smartphones and tablets.
          </p>
        </div>
        <div class="faq-item">
          <h3 class="faq-item__q">Can I process password-protected PDFs?</h3>
          <p class="faq-item__a">
            Due to privacy and security constraints, password-encrypted PDF files cannot be processed until they are decrypted by their author.
          </p>
        </div>
        <div class="faq-item">
          <h3 class="faq-item__q">Is there any fee or usage limit?</h3>
          <p class="faq-item__a">
            FreeFileTools is completely free to use without registration, subscriptions, or daily limits.
          </p>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  @import '../../styles/pdf-tools.css';

  .hub-hero {
    text-align: center;
    padding: 3rem 1.25rem 2rem;
    max-width: 800px;
    margin: 0 auto;
  }
  .hub-hero__badge {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand-400, #38bdf8);
    background: rgba(56, 189, 248, 0.1);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }
  .hub-hero__title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--text-primary, #ffffff);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .hub-hero__desc {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text-secondary, #94a3b8);
    margin-bottom: 1.5rem;
  }
  .badge-tag {
    font-size: 0.75rem;
    background: var(--surface-2, #262630);
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    color: var(--text-muted, #64748b);
  }
  .guide-banner {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.08), rgba(168, 85, 247, 0.08));
    border: 1px solid var(--border-color, #2a2a35);
    border-radius: 1rem;
    padding: 2rem;
    margin-top: 3.5rem;
  }
  .guide-banner__tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-brand-400, #38bdf8);
  }
  .guide-banner__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin: 0.5rem 0;
  }
  .guide-banner__desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary, #94a3b8);
    margin-bottom: 1.25rem;
    max-width: 700px;
  }
  .guide-banner__link {
    display: inline-block;
    color: var(--color-brand-400, #38bdf8);
    font-weight: 600;
    text-decoration: none;
  }
  .guide-banner__link:hover {
    text-decoration: underline;
  }
  .hub-faq {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-color, #2a2a35);
  }
  .hub-faq__title {
    font-size: 1.75rem;
    font-weight: 700;
    text-align: center;
    color: #fff;
    margin-bottom: 2rem;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .faq-item {
    background: var(--surface-1, #1e1e24);
    border: 1px solid var(--border-color, #2a2a35);
    border-radius: 0.5rem;
    padding: 1.25rem;
  }
  .faq-item__q {
    font-size: 1.05rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .faq-item__a {
    font-size: 0.925rem;
    line-height: 1.5;
    color: var(--text-secondary, #94a3b8);
  }
</style>
