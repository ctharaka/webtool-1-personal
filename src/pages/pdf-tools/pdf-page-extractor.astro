---
/**
 * pdf-tools/pdf-page-extractor.astro — Dedicated PDF Page Extractor Tool Landing Page
 * Full client-side extraction of a single specific page as an independent PDF document.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PdfZone from '../../components/PdfZone.astro';
---

<BaseLayout
  title="PDF Page Extractor — Extract Single Page from PDF Online | FreeFileTools"
  description="Extract any single page from a PDF document and save it as a new PDF file. 100% private in-browser extraction, instant download, zero file uploads."
  canonicalURL="https://freefiletool.app/pdf-tools/pdf-page-extractor"
>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "HowTo",
          "name": "How to Extract a Single Page from a PDF Document Online",
          "description": "Step-by-step instructions to extract a specific page from a PDF file using client-side JavaScript.",
          "step": [
            {
              "@type": "HowToStep",
              "name": "Upload PDF File",
              "text": "Drop your PDF document into the upload zone."
            },
            {
              "@type": "HowToStep",
              "name": "Select Page Number",
              "text": "Enter the exact page number you wish to isolate from the document."
            },
            {
              "@type": "HowToStep",
              "name": "Extract Page",
              "text": "Click Extract Page as PDF to copy and isolate the page in memory."
            },
            {
              "@type": "HowToStep",
              "name": "Download PDF",
              "text": "Save the single-page PDF document directly to your device."
            }
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "How is this different from the Split PDF tool?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "While the Split PDF tool handles multi-page intervals and batch ZIP splits, the PDF Page Extractor is specialized for quickly isolating and downloading a single page with minimal clicks."
              }
            },
            {
              "@type": "Question",
              "name": "Will the extracted page keep its original quality?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes! The extracted page is copied verbatim directly from the original document tree, preserving all vector fonts, shapes, high-resolution imagery, and text searchability."
              }
            },
            {
              "@type": "Question",
              "name": "Are my confidential files uploaded to any server?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. The extraction runs 100% in your device's browser memory using pdf-lib. No document data is ever sent across the network."
              }
            }
          ]
        }
      ]
    }
  </script>

  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
      <li><a href="/">Home</a></li>
      <li aria-hidden="true">&rsaquo;</li>
      <li><a href="/pdf-tools">PDF Tools</a></li>
      <li aria-hidden="true">&rsaquo;</li>
      <li aria-current="page">PDF Page Extractor</li>
    </ol>
  </nav>

  <section class="tool-hero">
    <div class="tool-hero__badge">Single Page Extractor</div>
    <h1 class="tool-hero__title">PDF Page Extractor</h1>
    <p class="tool-hero__desc">
      Extract any single page from your PDF file and save it as a brand-new PDF document. Fast, lightweight, and completely private inside your browser.
    </p>
  </section>

  <!-- AdSense Slot: Above main tool -->
  <div class="adsense-slot" aria-label="Advertisement"></div>

  <section class="upload-section">
    <PdfZone mode="page-extractor" id="pdf-page-extractor-zone" />
  </section>

  <!-- Quick Answer Box -->
  <div class="quick-answer" role="note">
    <p class="quick-answer__label">✦ Quick Answer</p>
    <p class="quick-answer__q">How does browser-side page extraction work?</p>
    <p class="quick-answer__a">
      FreeFileTools parses the PDF catalog using <code>pdf-lib</code>, clones the requested page object and its associated font/image dependencies into a fresh PDF document container, and triggers a local file download. Zero network round-trips.
    </p>
  </div>

  <!-- Related Tools -->
  <section class="related-tools">
    <h2 class="related-tools__title">Related PDF Utilities</h2>
    <div class="related-grid">
      <a href="/pdf-tools/split-pdf" class="related-card">
        <span class="related-card__name">Split PDF &rarr;</span>
        <span class="related-card__desc">Split PDF by ranges or extract all pages to ZIP.</span>
      </a>
      <a href="/pdf-tools/merge-pdf" class="related-card">
        <span class="related-card__name">Merge PDF &rarr;</span>
        <span class="related-card__desc">Combine multiple PDF files into one.</span>
      </a>
      <a href="/pdf-tools/compress-pdf" class="related-card">
        <span class="related-card__name">Compress PDF &rarr;</span>
        <span class="related-card__desc">Reduce file weight with stream optimization.</span>
      </a>
      <a href="/pdf-tools" class="related-card">
        <span class="related-card__name">All PDF Tools &rarr;</span>
        <span class="related-card__desc">Browse the complete suite of PDF tools.</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  @import '../../styles/pdf-tools.css';

  .breadcrumb-nav {
    max-width: 800px;
    margin: 1.5rem auto 0;
    padding: 0 1.25rem;
  }
  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    font-size: 0.875rem;
    color: var(--text-muted, #64748b);
  }
  .breadcrumb-list a {
    color: var(--color-brand-400, #38bdf8);
    text-decoration: none;
  }
  .breadcrumb-list a:hover {
    text-decoration: underline;
  }
  .tool-hero {
    text-align: center;
    padding: 2rem 1.25rem 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }
  .tool-hero__badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand-400, #38bdf8);
    background: rgba(56, 189, 248, 0.1);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }
  .tool-hero__title {
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.75rem;
  }
  .tool-hero__desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary, #94a3b8);
  }
  .upload-section {
    max-width: 800px;
    margin: 1.5rem auto 2.5rem;
    padding: 0 1.25rem;
  }
  .quick-answer {
    max-width: 800px;
    margin: 2rem auto;
    padding: 1.5rem;
    background: var(--surface-1, #1e1e24);
    border: 1px solid var(--border-color, #2a2a35);
    border-radius: 0.75rem;
  }
  .quick-answer__label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-accent-400, #a855f7);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }
  .quick-answer__q {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .quick-answer__a {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary, #94a3b8);
  }
  .related-tools {
    max-width: 800px;
    margin: 3rem auto 4rem;
    padding: 0 1.25rem;
    border-top: 1px solid var(--border-color, #2a2a35);
    padding-top: 2rem;
  }
  .related-tools__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 1rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .related-card {
    background: var(--surface-1, #1e1e24);
    border: 1px solid var(--border-color, #2a2a35);
    border-radius: 0.5rem;
    padding: 1rem;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .related-card:hover {
    border-color: var(--color-brand-400, #38bdf8);
  }
  .related-card__name {
    display: block;
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--color-brand-400, #38bdf8);
    margin-bottom: 0.25rem;
  }
  .related-card__desc {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-secondary, #94a3b8);
  }
</style>
