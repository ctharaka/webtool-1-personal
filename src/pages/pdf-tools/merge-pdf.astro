---
/**
 * pdf-tools/merge-pdf.astro — Dedicated Merge PDF Tool Landing Page
 * Full client-side PDF combination with reordering and privacy guarantees.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PdfZone from '../../components/PdfZone.astro';
---

<BaseLayout
  title="Merge PDF Files Online — Free Browser-Side PDF Joiner | FreeFileTools"
  description="Combine multiple PDF documents into a single PDF file directly in your browser. 100% private, reorder pages, no file uploads to external servers."
  canonicalURL="https://freefiletool.app/pdf-tools/merge-pdf"
>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "HowTo",
          "name": "How to Merge PDF Files Online in Your Browser",
          "description": "Step-by-step instructions to merge multiple PDF files locally using browser-side client execution without server uploads.",
          "step": [
            {
              "@type": "HowToStep",
              "name": "Select or Drop PDF Files",
              "text": "Add two or more PDF files using the file picker or drag and drop into the upload box."
            },
            {
              "@type": "HowToStep",
              "name": "Reorder Files",
              "text": "Use the up and down arrow controls to adjust the exact sequence of your documents."
            },
            {
              "@type": "HowToStep",
              "name": "Click Merge PDF Files Now",
              "text": "Your browser compiles all pages into a consolidated PDF in memory."
            },
            {
              "@type": "HowToStep",
              "name": "Download Merged PDF",
              "text": "Save the merged document directly to your device without network delay."
            }
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Can I rearrange the order of PDF files before merging?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes! Once you drop your files, use the up and down arrows next to each document in the queue list to arrange them in your preferred order."
              }
            },
            {
              "@type": "Question",
              "name": "Does merging PDFs upload my documents to any server?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. FreeFileTools merges PDFs 100% locally inside your browser's JavaScript environment using pdf-lib. Your documents never leave your computer or phone."
              }
            },
            {
              "@type": "Question",
              "name": "Can I merge password-protected PDF files?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Encrypted or password-locked PDF files cannot be merged until you remove the password using your original document creator."
              }
            }
          ]
        }
      ]
    }
  </script>

  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
      <li><a href="/">Home</a></li>
      <li aria-hidden="true">&rsaquo;</li>
      <li><a href="/pdf-tools">PDF Tools</a></li>
      <li aria-hidden="true">&rsaquo;</li>
      <li aria-current="page">Merge PDF</li>
    </ol>
  </nav>

  <section class="tool-hero">
    <div class="tool-hero__badge">PDF Merger</div>
    <h1 class="tool-hero__title">Merge PDF Files Online</h1>
    <p class="tool-hero__desc">
      Combine multiple PDF documents into one organized file in seconds. 100% private in-browser merging with zero server uploads.
    </p>
  </section>

  <!-- AdSense Slot: Above main tool -->
  <div class="adsense-slot" aria-label="Advertisement"></div>

  <section class="upload-section">
    <PdfZone mode="merge" id="pdf-merge-zone" />
  </section>

  <!-- Quick Answer Box -->
  <div class="quick-answer" role="note">
    <p class="quick-answer__label">✦ Quick Answer</p>
    <p class="quick-answer__q">How does browser-side PDF merging work?</p>
    <p class="quick-answer__a">
      FreeFileTools reads your PDF documents into browser memory using pure JavaScript (<code>pdf-lib</code>). It extracts each page, reassembles them sequentially into a single document structure, and generates a local download link. No file data is ever transmitted over the network.
    </p>
  </div>

  <!-- AdSense Slot: Mid-content -->
  <div class="adsense-slot" aria-label="Advertisement"></div>

  <!-- How It Works Section -->
  <section class="info-section">
    <h2 class="info-section__title">How to Merge PDF Documents in 4 Simple Steps</h2>
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-card__num" aria-hidden="true">1</div>
        <h3 class="step-card__title">Add Your PDF Files</h3>
        <p class="step-card__desc">
          Drag and drop two or more PDF files into the dropzone above, or click browse to choose files from your local storage.
        </p>
      </div>
      <div class="step-card">
        <div class="step-card__num" aria-hidden="true">2</div>
        <h3 class="step-card__title">Reorder Your Queue</h3>
        <p class="step-card__desc">
          Use the up and down arrow buttons next to each document to put them into your exact desired sequence.
        </p>
      </div>
      <div class="step-card">
        <div class="step-card__num" aria-hidden="true">3</div>
        <h3 class="step-card__title">Merge in Browser</h3>
        <p class="step-card__desc">
          Click the "Merge PDF Files Now" button. The assembly takes place instantly within your device's memory.
        </p>
      </div>
      <div class="step-card">
        <div class="step-card__num" aria-hidden="true">4</div>
        <h3 class="step-card__title">Instant Download</h3>
        <p class="step-card__desc">
          Click download to save your consolidated PDF document. No waiting for remote servers or cloud queues.
        </p>
      </div>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="related-tools">
    <h2 class="related-tools__title">Related PDF Utilities</h2>
    <div class="related-grid">
      <a href="/pdf-tools/split-pdf" class="related-card">
        <span class="related-card__name">Split PDF &rarr;</span>
        <span class="related-card__desc">Extract pages or intervals from any PDF.</span>
      </a>
      <a href="/pdf-tools/compress-pdf" class="related-card">
        <span class="related-card__name">Compress PDF &rarr;</span>
        <span class="related-card__desc">Reduce file weight via stream optimization.</span>
      </a>
      <a href="/pdf-tools/pdf-page-extractor" class="related-card">
        <span class="related-card__name">PDF Page Extractor &rarr;</span>
        <span class="related-card__desc">Extract a single page as a separate PDF.</span>
      </a>
      <a href="/pdf-tools" class="related-card">
        <span class="related-card__name">All PDF Tools &rarr;</span>
        <span class="related-card__desc">Browse the full suite of client-side PDF utilities.</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  @import '../../styles/pdf-tools.css';

  .breadcrumb-nav {
    max-width: 800px;
    margin: 1.5rem auto 0;
    padding: 0 1.25rem;
  }
  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    font-size: 0.875rem;
    color: var(--text-muted, #64748b);
  }
  .breadcrumb-list a {
    color: var(--color-brand-400, #38bdf8);
    text-decoration: none;
  }
  .breadcrumb-list a:hover {
    text-decoration: underline;
  }
  .tool-hero {
    text-align: center;
    padding: 2rem 1.25rem 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }
  .tool-hero__badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand-400, #38bdf8);
    background: rgba(56, 189, 248, 0.1);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }
  .tool-hero__title {
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.75rem;
  }
  .tool-hero__desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary, #94a3b8);
  }
  .upload-section {
    max-width: 800px;
    margin: 1.5rem auto 2.5rem;
    padding: 0 1.25rem;
  }
  .quick-answer {
    max-width: 800px;
    margin: 2rem auto;
    padding: 1.5rem;
    background: var(--surface-1, #1e1e24);
    border: 1px solid var(--border-color, #2a2a35);
    border-radius: 0.75rem;
  }
  .quick-answer__label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-accent-400, #a855f7);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }
  .quick-answer__q {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .quick-answer__a {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary, #94a3b8);
  }
  .info-section {
    max-width: 800px;
    margin: 3rem auto;
    padding: 0 1.25rem;
  }
  .info-section__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 1.5rem;
    text-align: center;
  }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .step-card {
    background: var(--surface-1, #1e1e24);
    border: 1px solid var(--border-color, #2a2a35);
    border-radius: 0.5rem;
    padding: 1.25rem;
    position: relative;
  }
  .step-card__num {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-brand-400, #38bdf8);
    opacity: 0.4;
    margin-bottom: 0.25rem;
  }
  .step-card__title {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .step-card__desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-secondary, #94a3b8);
  }
  .related-tools {
    max-width: 800px;
    margin: 3rem auto 4rem;
    padding: 0 1.25rem;
    border-top: 1px solid var(--border-color, #2a2a35);
    padding-top: 2rem;
  }
  .related-tools__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 1rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .related-card {
    background: var(--surface-1, #1e1e24);
    border: 1px solid var(--border-color, #2a2a35);
    border-radius: 0.5rem;
    padding: 1rem;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .related-card:hover {
    border-color: var(--color-brand-400, #38bdf8);
  }
  .related-card__name {
    display: block;
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--color-brand-400, #38bdf8);
    margin-bottom: 0.25rem;
  }
  .related-card__desc {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-secondary, #94a3b8);
  }
</style>
