---
/**
 * pdf-tools/split-pdf.astro — Dedicated Split PDF Tool Landing Page
 * Full client-side page range extraction and all-pages ZIP splitting.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PdfZone from '../../components/PdfZone.astro';
---

<BaseLayout
  title="Split PDF Online — Free In-Browser PDF Page Extractor | FreeFileTools"
  description="Split PDF files by custom page ranges or extract all pages into separate PDFs with ZIP download. 100% private client-side processing."
  canonicalURL="https://freefiletool.app/pdf-tools/split-pdf"
>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "HowTo",
          "name": "How to Split PDF Pages Online in Your Browser",
          "description": "Step-by-step instructions to split PDF files or extract page intervals locally using client-side WebAssembly and JavaScript.",
          "step": [
            {
              "@type": "HowToStep",
              "name": "Upload PDF File",
              "text": "Drop a single PDF document into the upload zone or select it from your device."
            },
            {
              "@type": "HowToStep",
              "name": "Choose Split Mode",
              "text": "Select 'Extract Page Range' (e.g. 1-3, 5) or 'Extract All Pages' to split every page."
            },
            {
              "@type": "HowToStep",
              "name": "Split Document",
              "text": "Click 'Split PDF Now' to slice the pages inside your browser."
            },
            {
              "@type": "HowToStep",
              "name": "Download Output",
              "text": "Download your split PDF file or grab the complete multi-page ZIP archive."
            }
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "How do page range expressions work?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "You can enter individual page numbers separated by commas (e.g., 1, 3, 7) or intervals separated by hyphens (e.g., 1-5, 8-12)."
              }
            },
            {
              "@type": "Question",
              "name": "Are my split files saved as a ZIP archive?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "When you choose 'Extract All Pages', all individual page PDFs are bundled into a convenient, clean ZIP file for one-click downloading."
              }
            },
            {
              "@type": "Question",
              "name": "Does FreeFileTools upload my PDF to any server?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Never. All page copying and document building is handled locally in your browser RAM."
              }
            }
          ]
        }
      ]
    }
  </script>

  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
      <li><a href="/">Home</a></li>
      <li aria-hidden="true">&rsaquo;</li>
      <li><a href="/pdf-tools">PDF Tools</a></li>
      <li aria-hidden="true">&rsaquo;</li>
      <li aria-current="page">Split PDF</li>
    </ol>
  </nav>

  <section class="tool-hero">
    <div class="tool-hero__badge">PDF Splitter</div>
    <h1 class="tool-hero__title">Split PDF Pages Online</h1>
    <p class="tool-hero__desc">
      Extract specific page ranges or separate every single page into individual documents. 100% private, client-side, and instant.
    </p>
  </section>

  <!-- AdSense Slot: Above main tool -->
  <div class="adsense-slot" aria-label="Advertisement"></div>

  <section class="upload-section">
    <PdfZone mode="split" id="pdf-split-zone" />
  </section>

  <!-- Quick Answer Box -->
  <div class="quick-answer" role="note">
    <p class="quick-answer__label">✦ Quick Answer</p>
    <p class="quick-answer__q">How does browser-side PDF splitting work?</p>
    <p class="quick-answer__a">
      FreeFileTools loads your document using <code>pdf-lib</code>, extracts only the specified page indices from the document tree, writes them into new PDF binary structures, and delivers them via instant browser blob URLs. No network upload is needed.
    </p>
  </div>

  <!-- Related Tools -->
  <section class="related-tools">
    <h2 class="related-tools__title">Related PDF Utilities</h2>
    <div class="related-grid">
      <a href="/pdf-tools/pdf-page-extractor" class="related-card">
        <span class="related-card__name">Page Extractor &rarr;</span>
        <span class="related-card__desc">Extract a single page as a standalone PDF.</span>
      </a>
      <a href="/pdf-tools/merge-pdf" class="related-card">
        <span class="related-card__name">Merge PDF &rarr;</span>
        <span class="related-card__desc">Combine multiple PDF files into one.</span>
      </a>
      <a href="/pdf-tools/compress-pdf" class="related-card">
        <span class="related-card__name">Compress PDF &rarr;</span>
        <span class="related-card__desc">Shrink PDF size without sacrificing clarity.</span>
      </a>
      <a href="/pdf-tools" class="related-card">
        <span class="related-card__name">All PDF Tools &rarr;</span>
        <span class="related-card__desc">Browse the complete suite of PDF tools.</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  @import '../../styles/pdf-tools.css';

  .breadcrumb-nav {
    max-width: 800px;
    margin: 1.5rem auto 0;
    padding: 0 1.25rem;
  }
  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    font-size: 0.875rem;
    color: var(--text-muted, #64748b);
  }
  .breadcrumb-list a {
    color: var(--color-brand-400, #38bdf8);
    text-decoration: none;
  }
  .breadcrumb-list a:hover {
    text-decoration: underline;
  }
  .tool-hero {
    text-align: center;
    padding: 2rem 1.25rem 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }
  .tool-hero__badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand-400, #38bdf8);
    background: rgba(56, 189, 248, 0.1);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }
  .tool-hero__title {
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.75rem;
  }
  .tool-hero__desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary, #94a3b8);
  }
  .upload-section {
    max-width: 800px;
    margin: 1.5rem auto 2.5rem;
    padding: 0 1.25rem;
  }
  .quick-answer {
    max-width: 800px;
    margin: 2rem auto;
    padding: 1.5rem;
    background: var(--surface-1, #1e1e24);
    border: 1px solid var(--border-color, #2a2a35);
    border-radius: 0.75rem;
  }
  .quick-answer__label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-accent-400, #a855f7);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }
  .quick-answer__q {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .quick-answer__a {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary, #94a3b8);
  }
  .related-tools {
    max-width: 800px;
    margin: 3rem auto 4rem;
    padding: 0 1.25rem;
    border-top: 1px solid var(--border-color, #2a2a35);
    padding-top: 2rem;
  }
  .related-tools__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 1rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .related-card {
    background: var(--surface-1, #1e1e24);
    border: 1px solid var(--border-color, #2a2a35);
    border-radius: 0.5rem;
    padding: 1rem;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .related-card:hover {
    border-color: var(--color-brand-400, #38bdf8);
  }
  .related-card__name {
    display: block;
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--color-brand-400, #38bdf8);
    margin-bottom: 0.25rem;
  }
  .related-card__desc {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-secondary, #94a3b8);
  }
</style>
