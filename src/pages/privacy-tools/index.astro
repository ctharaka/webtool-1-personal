---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy & Security Tools — FreeFileTools"
  description="100% private browser-side privacy and security tools. Remove EXIF data, strip metadata, and protect your digital footprint locally."
>
  <header class="hub-hero">
    <h1 class="hub-title">Privacy &amp; Security Tools</h1>
    <p class="hub-desc">
      Protect your digital footprint. All privacy-focused tools run 100% locally in your browser. Your data never leaves your device.
    </p>
  </header>

  <section class="tools-hub" aria-label="Privacy & Security Tools">
    <div class="category-block">
      <h2 class="category-title">
        <span class="category-icon">🛡️</span> Image Privacy
      </h2>
      <p class="category-desc">Remove tracking data and personal information from your photos before sharing.</p>
      
      <div class="category-grid">
        <div class="tool-card tool-card--featured">
          <div class="tool-badge">Featured</div>
          <h3 class="tool-title"><a href="/privacy-tools/exif-remover">Free EXIF Remover</a></h3>
          <p class="tool-desc">
            Strip hidden EXIF camera metadata, timestamps, and GPS location data from JPG, PNG, and WebP images.
          </p>
          <a href="/privacy-tools/exif-remover" class="tool-link">Strip EXIF Data &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hub-hero { text-align: center; padding: var(--space-10) 0 var(--space-8); }
  .hub-title { font-size: var(--font-size-3xl); font-weight: var(--font-weight-bold); margin-bottom: var(--space-3); }
  .hub-desc { font-size: var(--font-size-lg); color: var(--text-secondary); max-width: 50ch; margin-inline: auto; }
  .tools-hub { display: flex; flex-direction: column; gap: var(--space-12); padding-bottom: var(--space-16); }
  .category-block { border-top: 1px solid var(--border-default); padding-top: var(--space-8); }
  .category-title { font-size: var(--font-size-xl); font-weight: var(--font-weight-bold); margin-bottom: var(--space-2); }
  .category-desc { font-size: var(--font-size-sm); color: var(--text-muted); margin-bottom: var(--space-6); }
  .category-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-6); }
  .tool-card { background: var(--surface-1); border: 1px solid var(--border-default); border-radius: var(--radius-xl); padding: var(--space-6); }
  .tool-card--featured { border-color: var(--color-brand-400); }
  .tool-title { font-weight: var(--font-weight-bold); margin-bottom: var(--space-2); }
  .tool-desc { font-size: var(--font-size-sm); color: var(--text-secondary); margin-bottom: var(--space-4); }
  .tool-link { font-weight: var(--font-weight-semibold); color: var(--color-brand-400); }
</style>
