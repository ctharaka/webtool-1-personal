---
import ToolPageTemplate from '../components/ToolPageTemplate.astro';

const faqItems = [
  {
    question: "Why convert JPG photos to PNG format?",
    answer: "Converting JPEG images to PNG is beneficial when you need to edit master assets repeatedly without incurring further lossy JPEG compression artifacts."
  },
  {
    question: "Does converting JPG to PNG improve photo quality?",
    answer: "Converting a JPEG to PNG prevents further loss of visual detail during subsequent edits, though it cannot restore details already lost during initial JPEG compression."
  },
  {
    question: "Are my files uploaded to an external server?",
    answer: "No. Your files are processed on your device and are never uploaded."
  },
  {
    question: "Can I convert multiple JPG files at once?",
    answer: "Yes, you can select or drag multiple JPG files to convert them in batch mode."
  }
];
---

<ToolPageTemplate
  toolSlug="jpg-to-png"
  toolName="JPG to PNG Converter"
  title="JPG to PNG Converter — Convert JPEG to PNG Online Free"
  description="Convert JPG and JPEG photos to lossless PNG format 100% locally in your browser with fast batch processing and zero server uploads."
  badge="Image Studio"
  faqItems={faqItems}
>
  <div class="space-y-6">
    <!-- Drop Zone -->
    <div
      id="j2p-dropzone"
      class="border-2 border-dashed border-slate-700 hover:border-brand-500 rounded-xl p-8 text-center bg-slate-950/50 cursor-pointer transition"
    >
      <div class="space-y-3">
        <span class="text-4xl block">🖼️</span>
        <p class="text-base font-semibold text-slate-200">Drag &amp; Drop JPG photos here to convert to PNG</p>
        <p class="text-xs text-slate-400">Batch conversion to lossless PNG graphics</p>
        <input type="file" id="j2p-file-input" accept="image/jpeg,.jpg,.jpeg" multiple class="hidden" />
      </div>
    </div>

    <!-- Results Grid -->
    <div id="j2p-results-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
  </div>

  <div slot="guide">
    <h2 class="text-2xl font-bold text-slate-100 mb-4">Converting Lossy JPEGs to Lossless PNG Master Assets</h2>
    <p class="text-slate-300 leading-relaxed mb-4">
      JPEG is a lossy compression format designed to minimize photographic image sizes by discarding subtle color variations. When saving a JPEG file multiple times in image editors, compression degradation accumulates (generation loss).
    </p>

    <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Preserving Master Assets with PNG</h3>
    <p class="text-slate-300 leading-relaxed mb-4">
      Converting JPEG photographs to PNG establishes a stable, lossless baseline for graphic designers, digital artists, and publishers who plan to overlay text elements, apply transparency masks, or perform repeated editing operations.
    </p>

    <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Data Privacy Guarantee</h3>
    <p class="text-slate-300 leading-relaxed mb-4">
      All canvas decoding and PNG encoding run 100% locally in your browser's RAM memory space. Your files are processed on your device and are never uploaded.
    </p>
  </div>
</ToolPageTemplate>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dropzone = document.getElementById('j2p-dropzone');
    const fileInput = document.getElementById('j2p-file-input') as HTMLInputElement;
    const resultsGrid = document.getElementById('j2p-results-grid') as HTMLElement;

    dropzone?.addEventListener('click', () => fileInput?.click());

    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-brand-500', 'bg-brand-500/10');
    });

    dropzone?.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-brand-500', 'bg-brand-500/10');
    });

    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-brand-500', 'bg-brand-500/10');
      if (e.dataTransfer?.files?.length) {
        convertFiles(Array.from(e.dataTransfer.files));
      }
    });

    fileInput?.addEventListener('change', () => {
      if (fileInput.files?.length) {
        convertFiles(Array.from(fileInput.files));
      }
    });

    function convertFiles(files: File[]) {
      const jpgFiles = files.filter(f => f.type === 'image/jpeg' || f.name.match(/\.(jpg|jpeg)$/i));
      if (jpgFiles.length === 0) {
        alert('Please select valid JPG/JPEG image files.');
        return;
      }

      if (resultsGrid) resultsGrid.innerHTML = '';

      jpgFiles.forEach(file => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = img.width;
            canvas.height = img.height;
            const ctx = canvas.getContext('2d');
            if (ctx) {
              ctx.drawImage(img, 0, 0);
            }

            const dataUrl = canvas.toDataURL('image/png');
            const outName = file.name.replace(/\.(jpg|jpeg)$/i, '.png');

            renderResultCard(outName, dataUrl);
          };
          img.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);
      });
    }

    function renderResultCard(name: string, dataUrl: string) {
      if (!resultsGrid) return;
      const card = document.createElement('div');
      card.className = 'bg-slate-950 border border-slate-800 rounded-lg p-3 space-y-2';

      const img = document.createElement('img');
      img.src = dataUrl;
      img.className = 'w-full h-36 object-cover rounded border border-slate-800';

      const title = document.createElement('div');
      title.className = 'text-xs font-semibold text-slate-200 truncate';
      title.textContent = name;

      const btn = document.createElement('a');
      btn.href = dataUrl;
      btn.download = name;
      btn.className = 'block text-center py-1.5 bg-brand-600 hover:bg-brand-500 text-white rounded text-xs font-semibold transition';
      btn.textContent = 'Download PNG';

      card.appendChild(img);
      card.appendChild(title);
      card.appendChild(btn);
      resultsGrid.appendChild(card);
    }
  });
</script>
