---
/**
 * hash-generator.astro — Client-Side Hash Generator
 * Generates MD5, SHA-1, SHA-256, and SHA-512 hashes for text and files in your browser.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Free Online Hash Generator — MD5, SHA-1, SHA-256 & SHA-512"
  description="Generate cryptographic checksums and hashes for text or files directly in your browser. Compute MD5, SHA-1, SHA-256, and SHA-512 with 100% privacy and zero server uploads."
>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebApplication",
          "name": "FreeFileTools Hash Generator",
          "url": "https://freefiletool.app/hash-generator",
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "All",
          "browserRequirements": "Requires Web Crypto API and JavaScript",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "featureList": [
            "Compute MD5, SHA-1, SHA-256, and SHA-512 checksums",
            "Real-time hashing of text and strings",
            "Client-side file integrity hashing via ArrayBuffer",
            "Uppercase and lowercase hex toggling",
            "100% browser-local processing using Web Crypto API"
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Are my files or passwords uploaded to compute the hash?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. All hashes are computed locally inside your browser using the native Web Crypto API and client-side JavaScript. Your data never touches a server."
              }
            },
            {
              "@type": "Question",
              "name": "What is the difference between MD5 and SHA-256?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "MD5 produces a 128-bit hash and is widely used for legacy file checksums, though it is no longer secure against intentional collision attacks. SHA-256 produces a 256-bit hash and is currently the industry standard for cryptographic security, blockchain, and digital signatures."
              }
            },
            {
              "@type": "Question",
              "name": "Can I verify downloaded software integrity with this tool?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Drop any downloaded installer or archive into the file input. The tool computes the SHA-256 and MD5 hashes so you can compare them against the official release checksum."
              }
            }
          ]
        }
      ]
    }
  </script>

  <section class="tool-hero">
    <div class="tool-hero__badge">Data &amp; Text Tools</div>
    <h1 class="tool-hero__title">Online Hash &amp; Checksum Generator</h1>
    <p class="tool-hero__desc">
      Compute MD5, SHA-1, SHA-256, and SHA-512 hashes for text, passwords, and files instantly in your browser. Fast, cryptographically sound, and 100% private.
    </p>
  </section>

  <div class="tool-workspace">
    <!-- Input Section -->
    <div class="panel">
      <div class="panel-header">
        <h2 class="panel-title">1. Input Data or File</h2>
        <div class="input-mode-toggles">
          <label class="btn btn--file">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
            </svg>
            Choose File to Hash
            <input type="file" id="file-input" style="display: none;" />
          </label>
          <button type="button" id="btn-clear" class="btn btn--ghost">Clear</button>
        </div>
      </div>

      <div id="file-indicator" class="file-indicator" style="display: none;">
        <span id="file-name-label">File: filename.bin</span>
        <button type="button" id="btn-remove-file" class="btn-remove">✕</button>
      </div>

      <textarea
        id="text-input"
        class="form-textarea"
        rows="4"
        placeholder="Type or paste text here to compute real-time hashes..."
      >FreeFileTools</textarea>

      <div class="options-bar">
        <label class="checkbox-label">
          <input type="checkbox" id="chk-uppercase" />
          <span>Uppercase Hex</span>
        </label>
        <span id="calc-status" class="calc-status">Hashes updated</span>
      </div>
    </div>

    <!-- Output Hashes Section -->
    <div class="panel">
      <h2 class="panel-title">2. Cryptographic Hashes</h2>

      <div class="hashes-list">
        <!-- MD5 -->
        <div class="hash-row">
          <div class="hash-meta">
            <span class="hash-algo">MD5</span>
            <span class="hash-length">128-bit / 32 hex</span>
          </div>
          <div class="hash-value-wrapper">
            <input type="text" id="hash-md5" class="hash-input" readonly />
            <button type="button" class="btn-copy" data-target="hash-md5" title="Copy MD5">Copy</button>
          </div>
        </div>

        <!-- SHA-1 -->
        <div class="hash-row">
          <div class="hash-meta">
            <span class="hash-algo">SHA-1</span>
            <span class="hash-length">160-bit / 40 hex</span>
          </div>
          <div class="hash-value-wrapper">
            <input type="text" id="hash-sha1" class="hash-input" readonly />
            <button type="button" class="btn-copy" data-target="hash-sha1" title="Copy SHA-1">Copy</button>
          </div>
        </div>

        <!-- SHA-256 -->
        <div class="hash-row">
          <div class="hash-meta">
            <span class="hash-algo hash-algo--featured">SHA-256</span>
            <span class="hash-length">256-bit / 64 hex (Standard)</span>
          </div>
          <div class="hash-value-wrapper">
            <input type="text" id="hash-sha256" class="hash-input" readonly />
            <button type="button" class="btn-copy" data-target="hash-sha256" title="Copy SHA-256">Copy</button>
          </div>
        </div>

        <!-- SHA-512 -->
        <div class="hash-row">
          <div class="hash-meta">
            <span class="hash-algo">SHA-512</span>
            <span class="hash-length">512-bit / 128 hex</span>
          </div>
          <div class="hash-value-wrapper">
            <input type="text" id="hash-sha512" class="hash-input" readonly />
            <button type="button" class="btn-copy" data-target="hash-sha512" title="Copy SHA-512">Copy</button>
          </div>
        </div>
      </div>

      <div class="privacy-badge">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        </svg>
        <span>Runs entirely in your browser — nothing is uploaded</span>
      </div>
    </div>
  </div>

  <!-- Educational Section -->
  <section class="info-section">
    <div class="info-grid">
      <div class="info-card">
        <h3>Hardware-Accelerated Web Crypto</h3>
        <p>
          SHA-1, SHA-256, and SHA-512 are calculated using your browser's native <code>crypto.subtle.digest()</code> engine, ensuring microsecond execution speeds and hardware-grade security without network requests.
        </p>
      </div>
      <div class="info-card">
        <h3>File Integrity &amp; Verification</h3>
        <p>
          Ensure software downloads and document archives haven't been tampered with or corrupted during transfer by computing the SHA-256 checksum locally on your device.
        </p>
      </div>
      <div class="info-card">
        <h3>Learn More About Hashing</h3>
        <p>
          Curious how one-way cryptographic algorithms protect data? Read our complete deep dive:
          <a href="/guides/what-is-a-hash-and-when-do-you-need-one" class="text-link">What is a Hash and When Do You Need One? →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="related-tools-section">
    <h2 class="related-tools-title">More Data &amp; Text Utilities</h2>
    <div class="related-tools-grid">
      <a href="/text-tools" class="related-tool-card">
        <span class="related-tool-name">Text Tools Hub</span>
        <span class="related-tool-desc">View all text, developer, and data utilities</span>
      </a>
      <a href="/json-formatter" class="related-tool-card">
        <span class="related-tool-name">JSON Formatter</span>
        <span class="related-tool-desc">Validate, format, and minify JSON data</span>
      </a>
      <a href="/base64-encoder-decoder" class="related-tool-card">
        <span class="related-tool-name">Base64 Encoder/Decoder</span>
        <span class="related-tool-desc">Encode and decode text and binary files</span>
      </a>
    </div>
  </section>

  <script>
    let md5Module = null;

    async function getMD5() {
      if (!md5Module) {
        md5Module = await import('../lib/hash/md5.js');
      }
      return md5Module.md5;
    }

    function bufToHex(buffer) {
      const byteArray = new Uint8Array(buffer);
      const hexCodes = [...byteArray].map(value => value.toString(16).padStart(2, '0'));
      return hexCodes.join('');
    }

    const textInput = document.getElementById('text-input');
    const fileInput = document.getElementById('file-input');
    const fileIndicator = document.getElementById('file-indicator');
    const fileNameLabel = document.getElementById('file-name-label');
    const btnRemoveFile = document.getElementById('btn-remove-file');
    const btnClear = document.getElementById('btn-clear');
    const chkUppercase = document.getElementById('chk-uppercase');
    const calcStatus = document.getElementById('calc-status');

    const outMD5 = document.getElementById('hash-md5');
    const outSHA1 = document.getElementById('hash-sha1');
    const outSHA256 = document.getElementById('hash-sha256');
    const outSHA512 = document.getElementById('hash-sha512');

    let activeFileBuffer = null;

    async function calculateHashes() {
      calcStatus.textContent = 'Computing hashes...';

      let buffer;
      if (activeFileBuffer) {
        buffer = activeFileBuffer;
      } else {
        const text = textInput.value;
        buffer = new TextEncoder().encode(text).buffer;
      }

      try {
        const md5Fn = await getMD5();
        let hMD5 = md5Fn(buffer);

        const sha1Buf = await crypto.subtle.digest('SHA-1', buffer);
        let hSHA1 = bufToHex(sha1Buf);

        const sha256Buf = await crypto.subtle.digest('SHA-256', buffer);
        let hSHA256 = bufToHex(sha256Buf);

        const sha512Buf = await crypto.subtle.digest('SHA-512', buffer);
        let hSHA512 = bufToHex(sha512Buf);

        if (chkUppercase.checked) {
          hMD5 = hMD5.toUpperCase();
          hSHA1 = hSHA1.toUpperCase();
          hSHA256 = hSHA256.toUpperCase();
          hSHA512 = hSHA512.toUpperCase();
        }

        outMD5.value = hMD5;
        outSHA1.value = hSHA1;
        outSHA256.value = hSHA256;
        outSHA512.value = hSHA512;
        calcStatus.textContent = 'Hashes updated';
      } catch (err) {
        calcStatus.textContent = 'Calculation error: ' + err.message;
      }
    }

    let debounceTimer;
    textInput.addEventListener('input', () => {
      activeFileBuffer = null;
      fileIndicator.style.display = 'none';
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(calculateHashes, 150);
    });

    chkUppercase.addEventListener('change', calculateHashes);

    btnClear.addEventListener('click', () => {
      textInput.value = '';
      activeFileBuffer = null;
      fileIndicator.style.display = 'none';
      fileInput.value = '';
      calculateHashes();
    });

    fileInput.addEventListener('change', (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      fileNameLabel.textContent = `File: ${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
      fileIndicator.style.display = 'flex';
      textInput.value = `[Hashing File: ${file.name}]`;

      const reader = new FileReader();
      reader.onload = () => {
        activeFileBuffer = reader.result;
        calculateHashes();
      };
      reader.readAsArrayBuffer(file);
    });

    btnRemoveFile.addEventListener('click', () => {
      activeFileBuffer = null;
      fileIndicator.style.display = 'none';
      fileInput.value = '';
      textInput.value = '';
      calculateHashes();
    });

    document.querySelectorAll('.btn-copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const targetId = btn.getAttribute('data-target');
        const input = document.getElementById(targetId);
        if (!input || !input.value) return;
        await navigator.clipboard.writeText(input.value);
        const originalText = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = originalText; }, 1500);
      });
    });

    // Initial calculation
    calculateHashes();
  </script>

  <style>
    .tool-hero {
      text-align: center;
      padding: var(--space-8) var(--space-4) var(--space-6);
      max-width: 800px;
      margin: 0 auto;
    }
    .tool-hero__badge {
      display: inline-block;
      font-size: var(--font-size-xs);
      font-weight: 600;
      color: var(--color-brand-400);
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.2);
      border-radius: var(--radius-full);
      padding: var(--space-1) var(--space-3);
      margin-bottom: var(--space-3);
    }
    .tool-hero__title {
      font-size: var(--font-size-3xl);
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1.2;
      margin-bottom: var(--space-3);
    }
    .tool-hero__desc {
      font-size: var(--font-size-base);
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .tool-workspace {
      max-width: 1040px;
      margin: 0 auto var(--space-12);
      padding: 0 var(--space-4);
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .panel {
      background: var(--surface-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: var(--space-6);
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .panel-title {
      font-size: var(--font-size-lg);
      font-weight: 600;
      color: var(--text-primary);
      margin: 0;
    }
    .input-mode-toggles {
      display: flex;
      gap: var(--space-2);
      align-items: center;
    }

    .file-indicator {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(34, 197, 94, 0.08);
      border: 1px solid rgba(34, 197, 94, 0.2);
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      font-size: var(--font-size-xs);
      color: var(--color-brand-400);
      font-weight: 500;
    }
    .btn-remove {
      background: transparent;
      border: none;
      color: var(--text-secondary);
      cursor: pointer;
      font-size: var(--font-size-sm);
    }
    .btn-remove:hover {
      color: #f87171;
    }

    .form-textarea {
      width: 100%;
      background: var(--surface-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      color: var(--text-primary);
      padding: var(--space-3);
      font-size: var(--font-size-sm);
      font-family: inherit;
      line-height: 1.6;
      box-sizing: border-box;
      resize: vertical;
      outline: none;
    }
    .form-textarea:focus {
      border-color: var(--color-brand-500);
    }

    .options-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: var(--font-size-xs);
      color: var(--text-secondary);
    }
    .checkbox-label {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      cursor: pointer;
    }

    .hashes-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .hash-row {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }
    .hash-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .hash-algo {
      font-size: var(--font-size-xs);
      font-weight: 700;
      color: var(--text-primary);
    }
    .hash-algo--featured {
      color: var(--color-brand-400);
    }
    .hash-length {
      font-size: 11px;
      color: var(--text-secondary);
    }

    .hash-value-wrapper {
      display: flex;
      gap: var(--space-2);
    }
    .hash-input {
      flex: 1;
      background: var(--surface-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      color: var(--text-primary);
      padding: var(--space-2) var(--space-3);
      font-family: monospace;
      font-size: var(--font-size-xs);
      outline: none;
    }
    .btn-copy {
      background: var(--surface-elevated);
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
      font-size: var(--font-size-xs);
      font-weight: 500;
      padding: 0 var(--space-3);
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: all var(--transition-base);
    }
    .btn-copy:hover {
      background: var(--surface-card);
      border-color: var(--color-brand-500);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--font-size-xs);
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      cursor: pointer;
      border: none;
      transition: all var(--transition-base);
    }
    .btn--ghost {
      background: transparent;
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
    }
    .btn--ghost:hover {
      color: var(--text-primary);
    }
    .btn--file {
      background: var(--surface-elevated);
      color: var(--text-primary);
      border: 1px solid var(--border-subtle);
    }
    .btn--file:hover {
      border-color: var(--color-brand-500);
    }

    .privacy-badge {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--font-size-xs);
      color: var(--color-brand-400);
      background: rgba(34, 197, 94, 0.06);
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      border: 1px solid rgba(34, 197, 94, 0.15);
      margin-top: var(--space-2);
    }

    .info-section {
      max-width: 1040px;
      margin: 0 auto var(--space-12);
      padding: 0 var(--space-4);
    }
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-6);
    }
    .info-card {
      background: var(--surface-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
    }
    .info-card h3 {
      font-size: var(--font-size-md);
      font-weight: 600;
      color: var(--text-primary);
      margin: 0 0 var(--space-2);
    }
    .info-card p {
      font-size: var(--font-size-sm);
      color: var(--text-secondary);
      line-height: 1.6;
      margin: 0;
    }
    .text-link {
      color: var(--color-brand-400);
      text-decoration: none;
      display: inline-block;
      margin-top: var(--space-1);
    }
    .text-link:hover {
      text-decoration: underline;
    }

    .related-tools-section {
      max-width: 1040px;
      margin: 0 auto var(--space-12);
      padding: 0 var(--space-4);
    }
    .related-tools-title {
      font-size: var(--font-size-xl);
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: var(--space-6);
    }
    .related-tools-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: var(--space-4);
    }
    .related-tool-card {
      background: var(--surface-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: var(--space-4);
      text-decoration: none;
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      transition: all var(--transition-base);
    }
    .related-tool-card:hover {
      border-color: var(--color-brand-500);
      transform: translateY(-2px);
    }
    .related-tool-name {
      font-size: var(--font-size-sm);
      font-weight: 600;
      color: var(--text-primary);
    }
    .related-tool-desc {
      font-size: var(--font-size-xs);
      color: var(--text-secondary);
    }
  </style>
</BaseLayout>
