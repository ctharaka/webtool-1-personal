---
/**
 * avif-to-png.astro — Dedicated AVIF to PNG Converter Landing Page
 * Pre-sets default format to PNG (Lossless) with transparency preservation.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import UploadZone from '../components/UploadZone.astro';
---

<BaseLayout
  title="AVIF to PNG Converter — Convert AVIF to Lossless PNG Online"
  description="Convert AVIF images to lossless PNG format in your browser. Preserve transparent backgrounds and extract full-fidelity graphics for photo editing. 100% free and private."
>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "HowTo",
          "name": "How to Convert AVIF to PNG Online",
          "description": "Step-by-step instructions to convert AVIF images to lossless PNG format in your browser.",
          "step": [
            {
              "@type": "HowToStep",
              "name": "Select AVIF Files",
              "text": "Drag and drop your AVIF files into the upload box or select files using the file picker."
            },
            {
              "@type": "HowToStep",
              "name": "Confirm PNG Target",
              "text": "The converter defaults to PNG to ensure 100% lossless reproduction and transparent background retention."
            },
            {
              "@type": "HowToStep",
              "name": "Convert & Download",
              "text": "Click 'Convert All Files Now' to decode locally and download your lossless PNG images."
            }
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Does converting AVIF to PNG retain transparency?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes! Any transparent alpha channels in your AVIF files will be cleanly decoded and preserved in the resulting 32-bit RGBA PNG files."
              }
            },
            {
              "@type": "Question",
              "name": "Why convert AVIF to PNG?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "PNG is supported by every graphic design tool, video editor, and presentation software on the market. Converting AVIF to PNG makes your assets immediately usable in Figma, Photoshop, Illustrator, and Premiere without compatibility errors."
              }
            }
          ]
        }
      ]
    }
  </script>

  <section class="tool-hero">
    <div class="tool-hero__badge">AVIF to PNG Converter</div>
    <h1 class="tool-hero__title">Convert AVIF to PNG Online</h1>
    <p class="tool-hero__desc">
      Convert next-generation AVIF files into lossless Portable Network Graphics (PNG). Preserve full transparency, eliminate software compatibility barriers, and prepare assets for graphics editing.
    </p>
  </section>

  <!-- AdSense Slot: Above main tool card -->
  <div class="adsense-slot" aria-label="Advertisement"></div>

  <section class="upload-section">
    <UploadZone allowedTypes={['avif']} defaultFormat="png" />
  </section>

  <!-- Quick Answer Box -->
  <div class="quick-answer" role="note">
    <p class="quick-answer__label">✦ Quick Answer</p>
    <p class="quick-answer__q">Why convert AVIF to PNG?</p>
    <p class="quick-answer__a">
      When you download an <code>.avif</code> illustration, icon, or transparent graphic and need to import it into desktop editing software like Photoshop, Illustrator, Figma, or GIMP, converting to <strong>PNG</strong> guarantees 100% lossless quality and complete alpha transparency.
    </p>
  </div>

  <article class="tool-content">
    <section class="content-block">
      <h2>Lossless Conversion with Alpha Transparency</h2>
      <p>
        AVIF provides remarkable file size reduction for the web, but importing AVIF files into legacy software or production pipelines can cause error dialogs.
      </p>
      <p>
        The FreeFileTools AVIF to PNG converter translates your AVIF files into standard 32-bit PNG graphics with complete transparency preserved. The decoding process runs client-side in your browser, maintaining full privacy and zero waiting time.
      </p>
    </section>

    <section class="content-block">
      <h2>How to Convert AVIF to PNG (Step-by-Step)</h2>
      <ol class="steps-list">
        <li><strong>Add AVIF files:</strong> Drag and drop your <code>.avif</code> files into the converter area above.</li>
        <li><strong>Verify settings:</strong> Target format is preset to PNG for lossless reproduction.</li>
        <li><strong>Convert:</strong> Click <em>Convert All Files Now</em> to decode the images in local memory.</li>
        <li><strong>Download:</strong> Download individual PNG files or save the entire batch in a single ZIP archive.</li>
      </ol>
    </section>

    <section class="content-block faq-section">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-details">
          <summary class="faq-summary">Is there any quality loss when converting AVIF to PNG?</summary>
          <div class="faq-answer">
            <p>No. PNG is a lossless format, so every decoded pixel from your AVIF file is rendered with 100% fidelity without introducing additional compression artifacts.</p>
          </div>
        </details>
        <details class="faq-details">
          <summary class="faq-summary">Are my files kept secure and private?</summary>
          <div class="faq-answer">
            <p>Yes. All conversions happen entirely inside your web browser. No files are uploaded to any server.</p>
          </div>
        </details>
      </div>
    </section>

    <section class="content-block related-links">
      <h2>Related Converters &amp; Guides</h2>
      <ul class="related-list">
        <li>🔄 <a href="/image-converter">Universal Image Converter</a> — Convert between any combination of JPG, PNG, WebP, and AVIF.</li>
        <li>🖼️ <a href="/avif-to-jpg">AVIF to JPG Converter</a> — Convert AVIF images to standard JPEG format.</li>
        <li>✨ <a href="/png-to-avif">PNG to AVIF Converter</a> — Convert PNG graphics to next-gen AVIF files.</li>
        <li>📐 <a href="/image/resize">Resize Images</a> — Resize image pixel dimensions with aspect-ratio locking.</li>
        <li>📖 <a href="/guides/image-format-converter-guide">Image Format Converter Guide</a> — Complete guide on image formats and optimization.</li>
      </ul>
    </section>
  </article>

  <!-- AdSense Slot: Below article content -->
  <div class="adsense-slot" aria-label="Advertisement"></div>
</BaseLayout>

<style>
  .tool-hero { text-align: center; padding: var(--space-8) 0 var(--space-6); }
  .tool-hero__badge { display: inline-block; padding: var(--space-1) var(--space-3); background: color-mix(in srgb, var(--color-brand-500) 15%, transparent); border: 1px solid color-mix(in srgb, var(--color-brand-400) 30%, transparent); border-radius: var(--radius-full); font-size: var(--font-size-xs); font-weight: var(--font-weight-semibold); color: var(--color-brand-300); margin-bottom: var(--space-3); }
  .tool-hero__title { font-size: var(--font-size-3xl); font-weight: var(--font-weight-bold); color: var(--text-primary); margin-bottom: var(--space-3); }
  .tool-hero__desc { font-size: var(--font-size-base); color: var(--text-secondary); max-width: 58ch; margin-inline: auto; line-height: var(--line-height-loose); }
  .upload-section { max-width: 680px; margin-inline: auto; margin-bottom: var(--space-8); }
  .quick-answer { max-width: 680px; margin: 0 auto var(--space-10); padding: var(--space-5) var(--space-6); background: color-mix(in srgb, var(--color-brand-500) 8%, var(--surface-1)); border: 1px solid color-mix(in srgb, var(--color-brand-400) 25%, transparent); border-radius: var(--radius-xl); }
  .quick-answer__label { font-size: var(--font-size-xs); font-weight: var(--font-weight-semibold); color: var(--color-brand-400); text-transform: uppercase; letter-spacing: var(--letter-spacing-wide); margin-bottom: var(--space-1); }
  .quick-answer__q { font-size: var(--font-size-base); font-weight: var(--font-weight-semibold); color: var(--text-primary); margin-bottom: var(--space-2); }
  .quick-answer__a { font-size: var(--font-size-sm); color: var(--text-secondary); line-height: var(--line-height-loose); margin: 0; }
  .tool-content { max-width: 760px; margin-inline: auto; padding-bottom: var(--space-12); }
  .content-block { margin-bottom: var(--space-10); }
  .content-block h2 { font-size: var(--font-size-xl); font-weight: var(--font-weight-bold); color: var(--text-primary); margin-bottom: var(--space-4); }
  .content-block p { font-size: var(--font-size-base); color: var(--text-secondary); line-height: var(--line-height-loose); margin-bottom: var(--space-4); }
  .steps-list { padding-left: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); }
  .steps-list li { font-size: var(--font-size-base); color: var(--text-secondary); line-height: var(--line-height-loose); }
  .faq-list { display: flex; flex-direction: column; gap: var(--space-3); }
  .faq-details { background: var(--surface-1); border: 1px solid var(--border-default); border-radius: var(--radius-lg); overflow: hidden; }
  .faq-summary { padding: var(--space-4) var(--space-5); font-size: var(--font-size-base); font-weight: var(--font-weight-semibold); color: var(--text-primary); cursor: pointer; user-select: none; display: flex; justify-content: space-between; align-items: center; }
  .faq-summary::after { content: '+'; font-size: var(--font-size-lg); color: var(--color-brand-400); font-weight: var(--font-weight-bold); }
  .faq-details[open] .faq-summary::after { content: '\u2212'; }
  .faq-answer { padding: 0 var(--space-5) var(--space-5); font-size: var(--font-size-sm); color: var(--text-secondary); line-height: var(--line-height-loose); }
  .related-links { border-top: 1px solid var(--border-default); padding-top: var(--space-8); }
  .related-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .related-list li { font-size: var(--font-size-sm); color: var(--text-secondary); }
  .related-list a { color: var(--color-brand-400); font-weight: var(--font-weight-semibold); text-decoration: none; }
  .related-list a:hover { text-decoration: underline; }
</style>
