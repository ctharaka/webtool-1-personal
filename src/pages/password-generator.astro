---
import ToolPageTemplate from '../components/ToolPageTemplate.astro';

const faqItems = [
  {
    question: "Is this password generator cryptographically secure?",
    answer: "Yes. FreeFileTool uses window.crypto.getRandomValues(), a Cryptographically Secure Pseudo-Random Number Generator (CSPRNG) built directly into your operating system and web browser."
  },
  {
    question: "Are generated passwords saved or sent to any server?",
    answer: "Never. Passwords are generated exclusively inside your browser tab's RAM memory and are never stored, logged, or transmitted across any network connection."
  },
  {
    question: "How long should a strong password be?",
    answer: "Security experts recommend a minimum password length of 16 characters with a mix of uppercase letters, lowercase letters, numbers, and symbols to achieve over 90 bits of cryptographic entropy."
  },
  {
    question: "What is password entropy?",
    answer: "Password entropy measures the cryptographic strength and unpredictability of a password in bits. Higher entropy means exponential resistance against brute-force cracking attempts."
  }
];
---

<ToolPageTemplate
  toolSlug="password-generator"
  toolName="Secure Password Generator"
  title="Secure Password Generator — Strong Random Passwords Online"
  description="Generate cryptographically strong, random passwords using window.crypto.getRandomValues. Custom length, character sets, and entropy meter."
  faqItems={faqItems}
>
  <div class="space-y-6">
    <!-- Generated Password Display -->
    <div class="p-4 bg-slate-950 border border-slate-800 rounded-lg space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Generated Secure Password</span>
        <span id="pwd-entropy-tag" class="text-xs font-mono font-bold text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-800">
          95 Bits (Strong)
        </span>
      </div>

      <div class="flex items-center gap-3">
        <input
          type="text"
          id="pwd-output"
          readonly
          class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-lg font-mono text-emerald-300 font-bold tracking-wider focus:outline-none"
        />
        <button type="button" id="btn-regen-pwd" class="p-3 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg transition" title="Regenerate Password">
          🔄
        </button>
        <button type="button" id="btn-copy-pwd" class="px-5 py-3 bg-brand-600 hover:bg-brand-500 text-white font-bold rounded-lg transition text-sm whitespace-nowrap">
          Copy
        </button>
      </div>
    </div>

    <!-- Options Controls -->
    <div class="p-4 bg-slate-950 border border-slate-800 rounded-lg space-y-5">
      <!-- Length Slider -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-sm font-semibold">
          <label for="pwd-length" class="text-slate-200">Password Length:</label>
          <span id="pwd-length-val" class="font-mono text-brand-400 font-bold text-base">16 Characters</span>
        </div>
        <input
          type="range"
          id="pwd-length"
          min="8"
          max="128"
          value="16"
          class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-brand-500"
        />
      </div>

      <!-- Character Sets Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 pt-2 text-sm text-slate-300">
        <label class="flex items-center space-x-2 cursor-pointer">
          <input type="checkbox" id="chk-upper" checked class="rounded border-slate-700 text-brand-500 bg-slate-900" />
          <span>Uppercase (A-Z)</span>
        </label>
        <label class="flex items-center space-x-2 cursor-pointer">
          <input type="checkbox" id="chk-lower" checked class="rounded border-slate-700 text-brand-500 bg-slate-900" />
          <span>Lowercase (a-z)</span>
        </label>
        <label class="flex items-center space-x-2 cursor-pointer">
          <input type="checkbox" id="chk-numbers" checked class="rounded border-slate-700 text-brand-500 bg-slate-900" />
          <span>Numbers (0-9)</span>
        </label>
        <label class="flex items-center space-x-2 cursor-pointer">
          <input type="checkbox" id="chk-symbols" checked class="rounded border-slate-700 text-brand-500 bg-slate-900" />
          <span>Symbols (!@#$%^&amp;*)</span>
        </label>
        <label class="flex items-center space-x-2 cursor-pointer">
          <input type="checkbox" id="chk-avoid-ambiguous" class="rounded border-slate-700 text-brand-500 bg-slate-900" />
          <span>Exclude Ambiguous (O,0,l,1)</span>
        </label>
      </div>
    </div>
  </div>

  <div slot="guide">
    <h2 class="text-2xl font-bold text-slate-100 mb-4">Cryptographic Password Generation</h2>
    <p class="text-slate-300 leading-relaxed mb-4">
      Strong, unique passwords are the first line of defense against account takeover and credential stuffing attacks. Human-generated passwords often rely on predictable patterns, dictionary words, and familiar dates that automated cracking tools (such as Hashcat and John the Ripper) can crack in seconds.
    </p>

    <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">CSPRNG vs standard Math.random()</h3>
    <p class="text-slate-300 leading-relaxed mb-4">
      Many simple online password generators use JavaScript's standard <code>Math.random()</code> function. However, <code>Math.random()</code> is a pseudo-random number generator (PRNG) with a deterministic seed sequence, making generated passwords theoretically predictable. FreeFileTool uses the W3C Web Cryptography API (<code>window.crypto.getRandomValues</code>), which pulls entropy directly from kernel-level operating system noise pools (e.g. <code>/dev/urandom</code>).
    </p>

    <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Calculating Password Entropy</h3>
    <p class="text-slate-300 leading-relaxed mb-4">
      Password strength is calculated mathematically in bits of entropy using the formula:
    </p>
    <div class="bg-slate-950 border border-slate-800 rounded-lg p-3 font-mono text-center text-brand-400 mb-4">
      E = L &times; log<sub>2</sub>(R)
    </div>
    <p class="text-slate-300 leading-relaxed mb-4">
      Where <code>L</code> is the length of the password and <code>R</code> is the total size of the pool of available characters (e.g., 94 for full ASCII printable characters). A 16-character password drawn from a 94-character pool achieves over <strong>105 bits of entropy</strong>, requiring trillions of years to brute-force even with high-powered GPU clusters.
    </p>

    <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Best Practices for Password Security</h3>
    <ul class="list-disc list-inside text-slate-300 space-y-2 mb-4">
      <li><strong>Never Reuse Passwords:</strong> Use a unique random password for every online service.</li>
      <li><strong>Use a Password Manager:</strong> Store your generated passwords in an encrypted vault (e.g., Bitwarden, 1Password, or KeePass).</li>
      <li><strong>Enable Multi-Factor Authentication (MFA):</strong> Combine strong passwords with hardware security keys or authenticator apps.</li>
    </ul>
  </div>
</ToolPageTemplate>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pwdOut = document.getElementById('pwd-output') as HTMLInputElement;
    const pwdEntropy = document.getElementById('pwd-entropy-tag') as HTMLElement;
    const lenSlider = document.getElementById('pwd-length') as HTMLInputElement;
    const lenVal = document.getElementById('pwd-length-val') as HTMLElement;
    const chkUpper = document.getElementById('chk-upper') as HTMLInputElement;
    const chkLower = document.getElementById('chk-lower') as HTMLInputElement;
    const chkNum = document.getElementById('chk-numbers') as HTMLInputElement;
    const chkSym = document.getElementById('chk-symbols') as HTMLInputElement;
    const chkAmb = document.getElementById('chk-avoid-ambiguous') as HTMLInputElement;
    const btnRegen = document.getElementById('btn-regen-pwd');
    const btnCopy = document.getElementById('btn-copy-pwd');

    const UPPER_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const LOWER_CHARS = 'abcdefghijklmnopqrstuvwxyz';
    const NUM_CHARS = '0123456789';
    const SYM_CHARS = '!@#$%^&*()_+-=[]{}|;:,.<>?';
    const AMBIGUOUS_CHARS = /[O0l1I]/g;

    function generatePassword() {
      const length = parseInt(lenSlider?.value || '16', 10);
      lenVal.textContent = `${length} Characters`;

      let pool = '';
      if (chkUpper?.checked) pool += UPPER_CHARS;
      if (chkLower?.checked) pool += LOWER_CHARS;
      if (chkNum?.checked) pool += NUM_CHARS;
      if (chkSym?.checked) pool += SYM_CHARS;

      if (chkAmb?.checked) {
        pool = pool.replace(AMBIGUOUS_CHARS, '');
      }

      if (!pool) {
        pwdOut.value = 'Select at least one set!';
        pwdEntropy.textContent = '0 Bits';
        pwdEntropy.className = 'text-xs font-mono font-bold text-red-400 bg-red-950/60 px-2 py-0.5 rounded border border-red-800';
        return;
      }

      // CSPRNG character selection
      const randomValues = new Uint32Array(length);
      crypto.getRandomValues(randomValues);

      let pwd = '';
      for (let i = 0; i < length; i++) {
        pwd += pool[randomValues[i] % pool.length];
      }

      pwdOut.value = pwd;

      // Entropy calculation: E = L * log2(R)
      const entropyBits = Math.floor(length * Math.log2(pool.length));
      let category = 'Weak';
      let colorClass = 'text-red-400 bg-red-950/60 border-red-800';

      if (entropyBits >= 100) {
        category = 'Military-Grade';
        colorClass = 'text-cyan-400 bg-cyan-950/60 border-cyan-800';
      } else if (entropyBits >= 75) {
        category = 'Strong';
        colorClass = 'text-emerald-400 bg-emerald-950/60 border-emerald-800';
      } else if (entropyBits >= 50) {
        category = 'Good';
        colorClass = 'text-amber-400 bg-amber-950/60 border-amber-800';
      }

      pwdEntropy.textContent = `${entropyBits} Bits (${category})`;
      pwdEntropy.className = `text-xs font-mono font-bold px-2 py-0.5 rounded border ${colorClass}`;
    }

    lenSlider?.addEventListener('input', generatePassword);
    chkUpper?.addEventListener('change', generatePassword);
    chkLower?.addEventListener('change', generatePassword);
    chkNum?.addEventListener('change', generatePassword);
    chkSym?.addEventListener('change', generatePassword);
    chkAmb?.addEventListener('change', generatePassword);
    btnRegen?.addEventListener('click', generatePassword);

    btnCopy?.addEventListener('click', () => {
      if (!pwdOut?.value) return;
      navigator.clipboard.writeText(pwdOut.value).then(() => {
        const orig = btnCopy.textContent;
        btnCopy.textContent = 'Copied!';
        setTimeout(() => { btnCopy.textContent = orig; }, 2000);
      });
    });

    // Initial password
    generatePassword();
  });
</script>
