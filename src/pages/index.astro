---
/**
 * index.astro — FreeFileTool Landing Page Redesign
 * Modern, ultra-fast, mobile-first product hub for client-side file tools.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="FreeFileTool — Free Browser-Side Image, PDF, Audio & Text Utilities"
  description="Fast, free, and private online file tools. Convert images, merge & compress PDFs, trim audio, and format code 100% inside your browser. No file uploads."
  canonicalURL="https://freefiletool.app/"
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "name": "FreeFileTool",
        "url": "https://freefiletool.app/",
        "description": "Free browser-based file conversion, compression, and utility tools running 100% client-side."
      },
      {
        "@type": "SoftwareApplication",
        "name": "FreeFileTool Suite",
        "operatingSystem": "Any (Browser-based)",
        "applicationCategory": "UtilitiesApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        }
      }
    ]
  }
  </script>

  <!-- ── HERO SECTION ──────────────────────────────────────── -->
  <section class="hero-section">
    <div class="hero-badge">
      <span class="hero-badge__dot"></span>
      100% Private Client-Side Processing
    </div>
    <h1 class="hero-title">
      Simple file tools.<br />
      <span class="hero-title__accent">Right in your browser.</span>
    </h1>
    <p class="hero-desc">
      Convert images, manage PDFs, edit audio, and format data locally. Your files never touch a remote server—processing happens entirely in device memory.
    </p>

    <div class="hero-actions">
      <a href="#popular-tools" class="btn-hero primary">Choose a Tool &rarr;</a>
      <a href="#categories" class="btn-hero secondary">Browse Categories</a>
    </div>
  </section>

  <!-- ── SEARCH / FILTER BAR ───────────────────────────────── -->
  <section class="search-section" aria-label="Tool search" role="search">
    <div class="search-container">
      <label for="tool-search-input" class="sr-only">Search tools</label>
      <div class="search-box">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input
          type="search"
          id="tool-search-input"
          class="search-input"
          placeholder="Search tools (e.g. PDF, WebP, audio, JSON)..."
          aria-label="Search tools by name or format"
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="button"
          id="search-clear-btn"
          class="search-clear-btn"
          aria-label="Clear search"
          style="display: none;"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
        <kbd class="search-kbd" title="Press / or Ctrl+K to search" aria-hidden="true">⌘K</kbd>
      </div>
    </div>
  </section>

  <!-- ── POPULAR FEATURED TOOLS ────────────────────────────── -->
  <section class="hub-section" id="popular-tools" aria-label="Popular Tools">
    <div class="section-header">
      <h2 class="section-title">Popular Tools</h2>
      <p class="section-subtitle">Our most frequently used client-side file utilities.</p>
    </div>

    <div class="tools-grid" id="popular-tools-grid">
      <!-- 1. Image Converter -->
      <a href="/image-converter" class="tool-card" data-keywords="image convert jpg png webp avif batch">
        <div class="tool-card__header">
          <div class="tool-card__icon icon-image">IMG</div>
          <span class="tool-card__tag">Batch</span>
        </div>
        <h3 class="tool-card__title">Image Converter</h3>
        <p class="tool-card__desc">Convert between JPG, PNG, WebP, and AVIF formats with custom quality controls.</p>
        <span class="tool-card__action">Launch Tool &rarr;</span>
      </a>

      <!-- 2. Merge PDF -->
      <a href="/pdf/merge" class="tool-card" data-keywords="pdf merge combine join document split">
        <div class="tool-card__header">
          <div class="tool-card__icon icon-pdf">PDF</div>
          <span class="tool-card__tag">Reorder</span>
        </div>
        <h3 class="tool-card__title">Merge PDF Files</h3>
        <p class="tool-card__desc">Combine multiple PDF documents into a single organized file in seconds.</p>
        <span class="tool-card__action">Launch Tool &rarr;</span>
      </a>

      <!-- 3. Compress PDF -->
      <a href="/pdf/compress" class="tool-card" data-keywords="pdf compress shrink size optimize shrink">
        <div class="tool-card__header">
          <div class="tool-card__icon icon-pdf">PDF</div>
          <span class="tool-card__tag">Optimize</span>
        </div>
        <h3 class="tool-card__title">Compress PDF</h3>
        <p class="tool-card__desc">Reduce PDF byte weight while maintaining sharp vector fonts and layout clarity.</p>
        <span class="tool-card__action">Launch Tool &rarr;</span>
      </a>

      <!-- 4. Image Compressor -->
      <a href="/compress-image" class="tool-card" data-keywords="image compress shrink jpg png webp size">
        <div class="tool-card__header">
          <div class="tool-card__icon icon-compress">⚡</div>
          <span class="tool-card__tag">Size Tuning</span>
        </div>
        <h3 class="tool-card__title">Image Compressor</h3>
        <p class="tool-card__desc">Shrink PNG, JPG, and WebP files with side-by-side quality and target KB controls.</p>
        <span class="tool-card__action">Launch Tool &rarr;</span>
      </a>

      <!-- 5. Free EXIF Remover -->
      <a href="/privacy-tools/exif-remover" class="tool-card" data-keywords="exif metadata gps privacy location strip clean camera">
        <div class="tool-card__header">
          <div class="tool-card__icon icon-privacy">🛡️</div>
          <span class="tool-card__tag">Privacy</span>
        </div>
        <h3 class="tool-card__title">Free EXIF Remover</h3>
        <p class="tool-card__desc">Strip camera metadata, GPS location, device models, and timestamps from photos.</p>
        <span class="tool-card__action">Remove EXIF &rarr;</span>
      </a>

      <!-- 6. Audio Trimmer -->
      <a href="/audio-trimmer" class="tool-card" data-keywords="audio trim cut mp3 wav m4a sound clip editor">
        <div class="tool-card__header">
          <div class="tool-card__icon icon-audio">🎵</div>
          <span class="tool-card__tag">WebAudio</span>
        </div>
        <h3 class="tool-card__title">Audio Trimmer</h3>
        <p class="tool-card__desc">Cut and trim MP3 and WAV sound files directly in browser memory with visual waveform sliders.</p>
        <span class="tool-card__action">Trim Audio &rarr;</span>
      </a>

      <!-- 7. JPG to WebP -->
      <a href="/jpg-to-webp" class="tool-card" data-keywords="jpg jpeg webp image convert reencode">
        <div class="tool-card__header">
          <div class="tool-card__icon icon-image">JPG</div>
          <span class="tool-card__tag">WebP</span>
        </div>
        <h3 class="tool-card__title">JPG to WebP</h3>
        <p class="tool-card__desc">Convert legacy JPEG graphics into lightweight WebP format to save up to 40% bandwidth.</p>
        <span class="tool-card__action">Convert JPG &rarr;</span>
      </a>

      <!-- 8. JSON Formatter -->
      <a href="/json-formatter" class="tool-card" data-keywords="json format prettify minify validate developer text">
        <div class="tool-card__header">
          <div class="tool-card__icon icon-text">{ }</div>
          <span class="tool-card__tag">Developer</span>
        </div>
        <h3 class="tool-card__title">JSON Formatter</h3>
        <p class="tool-card__desc">Prettify, validate, and minify JSON data instantly with syntax error detection.</p>
        <span class="tool-card__action">Format JSON &rarr;</span>
      </a>
    </div>

    <!-- Hidden search empty state -->
    <div id="search-empty-state" class="search-empty-state" style="display: none;">
      <p>No tools matched "<span id="search-query-text"></span>". Try searching for "PDF", "image", "audio", "convert", or "compress".</p>
      <button type="button" id="search-empty-clear" class="search-empty-reset">
        Clear search &amp; view all tools
      </button>
    </div>
  </section>

  <!-- ── ALL CATEGORIES BREAKDOWN ──────────────────────────── -->
  <section class="hub-section" id="categories" aria-label="All Tool Categories">
    <div class="section-header">
      <h2 class="section-title">All Categories</h2>
      <p class="section-subtitle">Explore our complete collection of browser-based utilities.</p>
    </div>

    <div class="category-grid">
      <!-- Category 1: Image Tools -->
      <div class="category-card" data-keywords="image photo graphics png jpg webp avif resize convert compress">
        <div class="category-card__header">
          <span class="category-card__icon">🖼️</span>
          <h3 class="category-card__title">Image Tools</h3>
        </div>
        <p class="category-card__desc">Convert, compress, resize, and strip metadata from images.</p>
        <ul class="category-card__links">
          <li><a href="/image-converter">Image Converter (All Formats)</a></li>
          <li><a href="/jpg-to-webp">JPG to WebP Converter</a></li>
          <li><a href="/png-to-webp">PNG to WebP Converter</a></li>
          <li><a href="/compress-image">Image Compressor</a></li>
          <li><a href="/optimization-lab">Visual Quality Compare Lab</a></li>
          <li><a href="/image/resize">Image Resizer</a></li>
        </ul>
        <a href="/image-tools" class="category-card__more">Browse all Image Tools &rarr;</a>
      </div>

      <!-- Category 2: PDF Suite -->
      <div class="category-card" data-keywords="pdf merge split compress jpg png pages pdf-to-jpg pdf-to-png">
        <div class="category-card__header">
          <span class="category-card__icon">📑</span>
          <h3 class="category-card__title">PDF Suite</h3>
        </div>
        <p class="category-card__desc">Merge, split, compress, and convert PDF documents in your browser.</p>
        <ul class="category-card__links">
          <li><a href="/pdf/merge">Merge PDF Files</a></li>
          <li><a href="/pdf/split">Split PDF Pages</a></li>
          <li><a href="/pdf/compress">Compress PDF</a></li>
          <li><a href="/pdf/jpg-to-pdf">JPG to PDF</a></li>
          <li><a href="/pdf/png-to-pdf">PNG to PDF</a></li>
          <li><a href="/pdf/pdf-to-jpg">PDF to JPG</a></li>
          <li><a href="/pdf/pdf-to-png">PDF to PNG</a></li>
        </ul>
        <a href="/pdf" class="category-card__more">Browse complete PDF Suite &rarr;</a>
      </div>

      <!-- Category 3: Audio Tools -->
      <div class="category-card" data-keywords="audio sound mp3 wav m4a aac trim convert compress">
        <div class="category-card__header">
          <span class="category-card__icon">🎵</span>
          <h3 class="category-card__title">Audio Tools</h3>
        </div>
        <p class="category-card__desc">Convert formats, trim clips, and compress audio files locally.</p>
        <ul class="category-card__links">
          <li><a href="/audio-converter">Universal Audio Converter</a></li>
          <li><a href="/wav-to-mp3">WAV to MP3 Converter</a></li>
          <li><a href="/mp3-to-wav">MP3 to WAV Converter</a></li>
          <li><a href="/audio-trimmer">Audio Trimmer &amp; Cutter</a></li>
          <li><a href="/compress-audio">Compress Audio</a></li>
        </ul>
        <a href="/audio-tools" class="category-card__more">Browse all Audio Tools &rarr;</a>
      </div>

      <!-- Category 4: Privacy & Security -->
      <div class="category-card" data-keywords="privacy security exif metadata gps location photo clean">
        <div class="category-card__header">
          <span class="category-card__icon">🛡️</span>
          <h3 class="category-card__title">Privacy &amp; Security</h3>
        </div>
        <p class="category-card__desc">Clean file metadata and protect sensitive personal information.</p>
        <ul class="category-card__links">
          <li><a href="/privacy-tools/exif-remover">Free EXIF Remover</a></li>
          <li><a href="/about">Privacy Architecture Guide</a></li>
        </ul>
        <a href="/privacy-tools" class="category-card__more">Browse Privacy Tools &rarr;</a>
      </div>

      <!-- Category 5: Developer & Text Tools -->
      <div class="category-card" data-keywords="developer text json base64 hash qr code word counter case">
        <div class="category-card__header">
          <span class="category-card__icon">🛠️</span>
          <h3 class="category-card__title">Developer &amp; Text</h3>
        </div>
        <p class="category-card__desc">Format JSON, generate QR codes, encode base64, and compute hashes.</p>
        <ul class="category-card__links">
          <li><a href="/qr-code-generator">QR Code Generator</a></li>
          <li><a href="/json-formatter">JSON Formatter &amp; Validator</a></li>
          <li><a href="/base64-encoder-decoder">Base64 Encoder / Decoder</a></li>
          <li><a href="/hash-generator">Hash Generator (MD5 / SHA-256)</a></li>
          <li><a href="/word-counter">Word Counter</a></li>
          <li><a href="/case-converter">Case Converter</a></li>
        </ul>
        <a href="/text-tools" class="category-card__more">Browse Text Tools &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ── TRUST & PRIVACY VALUE PROPOSITION ──────────────────── -->
  <section class="trust-section" aria-label="Privacy guarantee">
    <div class="trust-container">
      <h2 class="trust-title">Your files stay in your browser.</h2>
      <p class="trust-subtitle">
        Unlike traditional online file converters that upload your documents to remote cloud servers, FreeFileTool processes your files locally using browser WebAssembly and JavaScript APIs.
      </p>

      <div class="trust-grid">
        <div class="trust-card">
          <div class="trust-card__icon">🔒</div>
          <h3 class="trust-card__title">100% Client-Side</h3>
          <p class="trust-card__desc">
            Your files remain strictly inside your browser's RAM memory. No network uploads, no cloud storage, zero telemetry.
          </p>
        </div>

        <div class="trust-card">
          <div class="trust-card__icon">⚡</div>
          <h3 class="trust-card__title">Instant Execution</h3>
          <p class="trust-card__desc">
            Skip file upload wait times. Operations process at native hardware speeds directly on your computer, tablet, or phone.
          </p>
        </div>

        <div class="trust-card">
          <div class="trust-card__icon">🆓</div>
          <h3 class="trust-card__title">Free &amp; Unlimited</h3>
          <p class="trust-card__desc">
            No registration, no accounts, no daily conversion caps, and no hidden subscriptions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ──────────────────────────────────────── -->
  <section class="hub-section" aria-label="How it works">
    <div class="section-header">
      <h2 class="section-title">How It Works</h2>
      <p class="section-subtitle">Three quick steps to process your files safely.</p>
    </div>

    <div class="steps-grid">
      <div class="step-card">
        <span class="step-card__num">1</span>
        <h3 class="step-card__title">Choose a Tool</h3>
        <p class="step-card__desc">Select an image, PDF, audio, or text tool from our catalog.</p>
      </div>

      <div class="step-card">
        <span class="step-card__num">2</span>
        <h3 class="step-card__title">Select Your File</h3>
        <p class="step-card__desc">Drag &amp; drop or tap to pick files from your computer or phone.</p>
      </div>

      <div class="step-card">
        <span class="step-card__num">3</span>
        <h3 class="step-card__title">Process &amp; Download</h3>
        <p class="step-card__desc">Export your converted or compressed file instantly to your device.</p>
      </div>
    </div>
  </section>

  <!-- ── FAQ SECTION ───────────────────────────────────────── -->
  <section class="hub-section faq-section" aria-label="Frequently Asked Questions">
    <div class="section-header">
      <h2 class="section-title">Frequently Asked Questions</h2>
    </div>

    <div class="faq-accordion">
      <details class="faq-item" open>
        <summary class="faq-summary">Are my files uploaded to FreeFileTool servers?</summary>
        <div class="faq-answer">
          <p>
            No. FreeFileTool is built with a zero-backend architecture. All processing is executed 100% locally inside your web browser using HTML5 Canvas, Web Audio API, and JavaScript libraries. Your files never touch a remote server.
          </p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-summary">Is FreeFileTool completely free?</summary>
        <div class="faq-answer">
          <p>
            Yes. All tools on FreeFileTool are 100% free to use without mandatory user sign-ups, accounts, daily usage limits, or hidden fees.
          </p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-summary">Can I use FreeFileTool on my phone or tablet?</summary>
        <div class="faq-answer">
          <p>
            Yes! FreeFileTool is designed mobile-first. All tool file pickers, options, and download buttons are fully responsive and touch-optimized for iOS Safari, Android Chrome, and mobile browsers.
          </p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-summary">What is the maximum supported file size?</summary>
        <div class="faq-answer">
          <p>
            We support file processing up to 50 MB per file (and 200 MB for batch queues). Because processing runs in your device's memory (RAM), modern smartphones and computers can comfortably handle standard files.
          </p>
        </div>
      </details>
    </div>
  </section>
</BaseLayout>

<script>
  // Instant search & filter for homepage tool cards
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = /** @type {HTMLInputElement} */ (document.getElementById('tool-search-input'));
    const clearBtn = document.getElementById('search-clear-btn');
    const kbdBadge = document.querySelector('.search-kbd');
    const toolCards = document.querySelectorAll('.tools-grid .tool-card, .category-grid .category-card');
    const emptyState = document.getElementById('search-empty-state');
    const queryTextSpan = document.getElementById('search-query-text');
    const emptyClearBtn = document.getElementById('search-empty-clear');

    if (!searchInput) return;

    const updateSearch = () => {
      const query = searchInput.value.trim().toLowerCase();
      let matchCount = 0;

      // Toggle clear button & kbd badge
      if (clearBtn) {
        clearBtn.style.display = query.length > 0 ? 'inline-flex' : 'none';
      }
      if (kbdBadge) {
        (/** @type {HTMLElement} */ (kbdBadge)).style.display = query.length > 0 ? 'none' : '';
      }

      toolCards.forEach((card) => {
        const keywords = card.getAttribute('data-keywords') || '';
        const text = card.textContent?.toLowerCase() || '';

        if (!query || keywords.toLowerCase().includes(query) || text.includes(query)) {
          (/** @type {HTMLElement} */ (card)).style.display = '';
          matchCount++;
        } else {
          (/** @type {HTMLElement} */ (card)).style.display = 'none';
        }
      });

      if (emptyState) {
        if (matchCount === 0 && query !== '') {
          emptyState.style.display = 'block';
          if (queryTextSpan) queryTextSpan.textContent = searchInput.value.trim();
        } else {
          emptyState.style.display = 'none';
        }
      }
    };

    const clearSearch = () => {
      searchInput.value = '';
      updateSearch();
      searchInput.focus();
    };

    searchInput.addEventListener('input', updateSearch);

    if (clearBtn) {
      clearBtn.addEventListener('click', clearSearch);
    }
    if (emptyClearBtn) {
      emptyClearBtn.addEventListener('click', clearSearch);
    }

    // Keyboard navigation: Escape to clear/blur, '/' or Ctrl/Cmd+K to focus
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && document.activeElement === searchInput) {
        if (searchInput.value) {
          clearSearch();
        } else {
          searchInput.blur();
        }
      } else if (
        (e.key === '/' || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) &&
        document.activeElement !== searchInput &&
        !['INPUT', 'TEXTAREA', 'SELECT'].includes((/** @type {HTMLElement} */ (document.activeElement))?.tagName || '')
      ) {
        e.preventDefault();
        searchInput.focus();
      }
    });
  });
</script>

<style>
  /* ── Hero Section ──────────────────────────────────────── */
  .hero-section {
    text-align: center;
    padding: var(--space-8) 0 var(--space-6);
    max-width: 48rem;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1-5) var(--space-3.5);
    background: color-mix(in srgb, var(--color-brand-500) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-brand-400) 30%, transparent);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-brand-300);
    margin-bottom: var(--space-4);
  }

  .hero-badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-400);
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin-bottom: var(--space-4);
  }

  .hero-title__accent {
    color: var(--color-brand-400);
  }

  .hero-desc {
    font-size: var(--font-size-base);
    color: var(--text-secondary);
    line-height: var(--line-height-loose);
    margin-bottom: var(--space-6);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .btn-hero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transition: transform var(--transition-fast), filter var(--transition-fast);
  }

  .btn-hero.primary {
    background: var(--color-brand-500);
    color: #ffffff;
    box-shadow: var(--shadow-md);
  }
  .btn-hero.primary:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }

  .btn-hero.secondary {
    background: var(--surface-2);
    color: var(--text-primary);
    border: 1px solid var(--border-default);
  }
  .btn-hero.secondary:hover {
    background: var(--surface-3);
    border-color: var(--color-brand-400);
  }

  /* ── Search Section ────────────────────────────────────── */
  .search-section {
    max-width: 36rem;
    margin: 0 auto var(--space-8);
    padding: 0 var(--space-4);
  }

  .search-container {
    position: relative;
    width: 100%;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--surface-1);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast);
  }

  .search-box:hover {
    border-color: color-mix(in srgb, var(--color-brand-400) 40%, var(--border-default));
    background: var(--surface-2);
  }

  .search-box:focus-within {
    border-color: var(--color-brand-400);
    background: var(--surface-2);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-brand-400) 20%, transparent), var(--shadow-md);
  }

  .search-icon {
