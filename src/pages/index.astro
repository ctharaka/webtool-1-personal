---
/**
 * index.astro — FreeFileTool Modern Widescreen Landing Page
 * Designed with senior UI/UX engineering principles:
 * - Expansive widescreen bento architecture (spreads naturally across desktop & collapses cleanly on mobile)
 * - Pure CSS ambient light animations, floating glow meshes & micro-interactions
 * - Spotlight-style instant client-side command search with keyboard shortcuts (⌘K / /)
 * - Complete internal linking preservation across all 35+ file utilities
 * - Zero external bloated dependencies; 100% privacy and lightning-fast performance
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import RecentHistory from '../components/RecentHistory.astro';
---

<BaseLayout
  title="FreeFileTool — Free Browser-Side Image, PDF, Audio & Text Utilities"
  description="Fast, free, and private online file tools. Convert images, merge & compress PDFs, trim audio, and format code 100% inside your browser. Zero uploads, zero telemetry."
  canonicalURL="https://freefiletool.app/"
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "name": "FreeFileTool",
        "url": "https://freefiletool.app/",
        "description": "Free browser-based file conversion, compression, and utility tools running 100% client-side."
      },
      {
        "@type": "SoftwareApplication",
        "name": "FreeFileTool Suite",
        "operatingSystem": "Any (Browser-based)",
        "applicationCategory": "UtilitiesApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        }
      }
    ]
  }
  </script>

  <div class="landing-canvas">
    <!-- ── AMBIENT GLOW BACKDROP ──────────────────────────────── -->
    <div class="ambient-glow orb-1" aria-hidden="true"></div>
    <div class="ambient-glow orb-2" aria-hidden="true"></div>
    <div class="ambient-glow orb-3" aria-hidden="true"></div>
    <div class="canvas-grid-pattern" aria-hidden="true"></div>

    <!-- ── EXPANSIVE HERO SECTION ─────────────────────────────── -->
    <section class="hero-stage" aria-label="Introduction">
      <div class="hero-inner">
        <!-- Live Status Pill -->
        <div class="status-pill" role="status">
          <span class="status-dot">
            <span class="status-dot__ping"></span>
            <span class="status-dot__core"></span>
          </span>
          <span class="status-pill__label">Client-Side Processing Engine</span>
          <span class="status-pill__divider"></span>
          <span class="status-pill__highlight">0 KB Uploaded</span>
        </div>

        <!-- Big Display Headline -->
        <h1 class="hero-headline">
          Private, Instant File Tools.<br />
          <span class="gradient-shimmer">Built Into Your Browser.</span>
        </h1>

        <!-- Editorial Subtitle -->
        <p class="hero-lead">
          Convert media, merge and compress PDFs, trim audio, and format developer code directly inside your device's memory. No wait queues, no accounts, and zero bytes uploaded to any remote server.
        </p>

        <!-- ── SPOTLIGHT COMMAND PALETTE & SEARCH ──────────────── -->
        <div class="command-center" role="search">
          <div class="command-bar-box">
            <svg class="cmd-search-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>

            <input
              type="search"
              id="global-tool-search"
              class="cmd-input"
              placeholder="Search by tool name, format, or task (e.g. PDF merge, WebP, audio trim, JSON, EXIF)..."
              aria-label="Search all file tools"
              autocomplete="off"
              spellcheck="false"
            />

            <button
              type="button"
              id="search-clear-action"
              class="cmd-clear-btn"
              aria-label="Clear search input"
              style="display: none;"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>

            <div class="cmd-shortcut" aria-hidden="true" title="Press / or Ctrl+K to focus search">
              <kbd class="key-badge">⌘</kbd>
              <kbd class="key-badge">K</kbd>
            </div>
          </div>

          <!-- Category Segmented Control Ribbon -->
          <div class="category-segmented-ribbon" role="tablist" aria-label="Filter tools by category">
            <button type="button" class="segment-btn active" data-category="all" role="tab" aria-selected="true">
              <span class="segment-icon">⚡</span>
              <span>All Utilities</span>
              <span class="segment-count">35+</span>
            </button>
            <button type="button" class="segment-btn" data-category="image" role="tab" aria-selected="false">
              <span class="segment-icon">🖼️</span>
              <span>Image Tools</span>
            </button>
            <button type="button" class="segment-btn" data-category="pdf" role="tab" aria-selected="false">
              <span class="segment-icon">📑</span>
              <span>PDF Suite</span>
            </button>
            <button type="button" class="segment-btn" data-category="audio" role="tab" aria-selected="false">
              <span class="segment-icon">🎵</span>
              <span>Audio Studio</span>
            </button>
            <button type="button" class="segment-btn" data-category="text" role="tab" aria-selected="false">
              <span class="segment-icon">🛠️</span>
              <span>Developer &amp; Code</span>
            </button>
            <button type="button" class="segment-btn" data-category="privacy" role="tab" aria-selected="false">
              <span class="segment-icon">🛡️</span>
              <span>Privacy &amp; Security</span>
            </button>
          </div>

          <!-- Quick Query Suggestions -->
          <div class="quick-chips-row">
            <span class="chips-label">Quick Jump:</span>
            <div class="chips-scrollable">
              <button type="button" class="quick-chip" data-search-term="Image Optimizer">⚡ Image Optimizer</button>
              <button type="button" class="quick-chip" data-search-term="File Inspector">🔍 File Inspector</button>
              <button type="button" class="quick-chip" data-search-term="Merge PDF">📑 Merge PDF</button>
              <button type="button" class="quick-chip" data-search-term="Compress Image">📉 Compress Image</button>
              <button type="button" class="quick-chip" data-search-term="JPG to WebP">🖼️ JPG to WebP</button>
              <button type="button" class="quick-chip" data-search-term="Audio Trimmer">🎵 Audio Trimmer</button>
              <button type="button" class="quick-chip" data-search-term="EXIF Remover">🛡️ EXIF Remover</button>
              <button type="button" class="quick-chip" data-search-term="JSON Formatter">🛠️ JSON Formatter</button>
              <button type="button" class="quick-chip" data-search-term="Optimization Lab">🔬 Compare Lab</button>
            </div>
          </div>

          <!-- Live Result Feedback -->
          <div id="search-feedback" class="search-feedback-bar" style="display: none;">
            <span id="results-count-text">Found 0 matching tools</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── RECENT LOCAL ACTIVITY (PRIVACY-SAFE) ──────────────── -->
    <div class="recent-activity-section">
      <RecentHistory />
    </div>

    <!-- ── BENTO SHOWCASE GRID (ASYMMETRIC WIDESCREEN) ───────── -->
    <section class="section-container" id="flagship-bento" aria-labelledby="bento-title">
      <div class="section-title-wrap">
        <div class="eyebrow-tag">Browser Native</div>
        <h2 id="bento-title" class="title-primary">Flagship Client-Side Studios</h2>
        <p class="subtitle-text">Fast, private processing engines running in your browser.</p>
      </div>

      <div class="bento-grid">
        <!-- 1. IMAGE STUDIO (Large 7-col bento) -->
        <article class="bento-card bento-hero-image" data-category="image">
          <div class="bento-card__glow" aria-hidden="true"></div>
          <div class="bento-card__content">
            <div class="bento-card__top">
              <div class="bento-pill tag-emerald">
                <span class="bento-pill__dot"></span>
                Canvas Engine
              </div>
              <span class="bento-badge">Lossless &amp; Lossy</span>
            </div>

            <h3 class="bento-title">Universal Image Studio</h3>
            <p class="bento-desc">
              Convert between JPG, PNG, WebP, and AVIF in bulk. Shrink files with target KB precision and compare compression visually side-by-side with zero quality compromise.
            </p>

            <div class="format-chips-showcase">
              <span class="fmt-chip">JPG</span>
              <span class="fmt-arrow">&harr;</span>
              <span class="fmt-chip highlight">WebP</span>
              <span class="fmt-arrow">&harr;</span>
              <span class="fmt-chip">AVIF</span>
              <span class="fmt-arrow">&harr;</span>
              <span class="fmt-chip">PNG</span>
            </div>

            <div class="bento-actions-row">
              <a href="/image-optimizer/" class="bento-btn primary">Image Optimizer &rarr;</a>
              <a href="/image-converter/" class="bento-btn secondary">Universal Converter</a>
              <a href="/compress-image/" class="bento-btn tertiary">Compress Image</a>
            </div>
          </div>
        </article>

        <!-- 2. PDF SUITE (5-col bento) -->
        <article class="bento-card bento-hero-pdf" data-category="pdf">
          <div class="bento-card__glow" aria-hidden="true"></div>
          <div class="bento-card__content">
            <div class="bento-card__top">
              <div class="bento-pill tag-rose">
                <span class="bento-pill__dot"></span>
                In-Memory PDF.js
              </div>
              <span class="bento-badge">Vector Sharp</span>
            </div>

            <h3 class="bento-title">PDF Master Suite</h3>
            <p class="bento-desc">
              Merge scattered documents into an organized master file, compress heavy pages, extract ranges, and convert graphics to PDF effortlessly.
            </p>

            <!-- Visual mini PDF deck simulation -->
            <div class="visual-pdf-deck" aria-hidden="true">
              <div class="deck-page page-1"><span>Page 1</span></div>
              <div class="deck-page page-2"><span>Page 2</span></div>
              <div class="deck-page page-3"><span>Combined.pdf</span></div>
            </div>

            <div class="bento-actions-row">
              <a href="/pdf/merge/" class="bento-btn primary">Merge PDFs &rarr;</a>
              <a href="/pdf/compress/" class="bento-btn secondary">Compress PDF</a>
              <a href="/pdf/split/" class="bento-btn tertiary">Split Pages</a>
            </div>
          </div>
        </article>

        <!-- 3. WEBAUDIO LAB (4-col bento) -->
        <article class="bento-card bento-audio" data-category="audio">
          <div class="bento-card__glow" aria-hidden="true"></div>
          <div class="bento-card__content">
            <div class="bento-card__top">
              <div class="bento-pill tag-cyan">
                <span class="bento-pill__dot"></span>
                Web Audio API
              </div>
              <span class="bento-badge">Real-Time</span>
            </div>

            <h3 class="bento-title">Audio Studio</h3>
            <p class="bento-desc">
              Trim tracks with millisecond waveform precision and transcode MP3, WAV, and audio stems locally with custom CBR/VBR bitrates.
            </p>

            <!-- Animated equalizer waveform bars -->
            <div class="waveform-anim" aria-hidden="true">
              <span class="bar b1"></span>
              <span class="bar b2"></span>
              <span class="bar b3"></span>
              <span class="bar b4"></span>
              <span class="bar b5"></span>
              <span class="bar b6"></span>
              <span class="bar b7"></span>
              <span class="bar b8"></span>
              <span class="bar b9"></span>
              <span class="bar b10"></span>
            </div>

            <div class="bento-actions-row">
              <a href="/audio-trimmer/" class="bento-btn primary">Audio Trimmer &rarr;</a>
              <a href="/audio-converter/" class="bento-btn secondary">Audio Converter</a>
            </div>
          </div>
        </article>

        <!-- 4. ZERO-KNOWLEDGE PRIVACY (4-col bento) -->
        <article class="bento-card bento-privacy" data-category="privacy">
          <div class="bento-card__glow" aria-hidden="true"></div>
          <div class="bento-card__content">
            <div class="bento-card__top">
              <div class="bento-pill tag-purple">
                <span class="bento-pill__dot"></span>
                100% Private
              </div>
              <span class="bento-badge">GPS Sanitizer</span>
            </div>

            <h3 class="bento-title">Privacy &amp; EXIF Wiper</h3>
            <p class="bento-desc">
              Strip camera metadata, embedded GPS coordinates, serial numbers, and timestamps from photos before uploading to public social platforms.
            </p>

            <div class="privacy-status-box">
              <div class="privacy-row"><span class="check">✓</span> GPS Geolocation Removed</div>
              <div class="privacy-row"><span class="check">✓</span> Camera &amp; Lens Fingerprint Cleaned</div>
              <div class="privacy-row"><span class="check">✓</span> 0 Bytes Sent to Remote Cloud</div>
            </div>

            <div class="bento-actions-row">
              <a href="/file-inspector/" class="bento-btn primary">File Inspector &rarr;</a>
              <a href="/privacy-tools/exif-remover/" class="bento-btn secondary">Remove EXIF</a>
              <a href="/hash-generator/" class="bento-btn tertiary">Hash Generator</a>
            </div>
          </div>
        </article>

        <!-- 5. DEVELOPER SUITE (4-col bento) -->
        <article class="bento-card bento-dev" data-category="text">
          <div class="bento-card__glow" aria-hidden="true"></div>
          <div class="bento-card__content">
            <div class="bento-card__top">
              <div class="bento-pill tag-indigo">
                <span class="bento-pill__dot"></span>
                Developer Utilities
              </div>
              <span class="bento-badge">RFC Compliant</span>
            </div>

            <h3 class="bento-title">Code &amp; Text Tools</h3>
            <p class="bento-desc">
              Prettify and validate JSON strings with error line diagnostics, create scannable QR codes, generate MD5/SHA hashes, and encode Base64.
            </p>

            <!-- Mini code snippet preview -->
            <div class="code-snippet-preview" aria-hidden="true">
              <div class="code-line"><span class="code-key">"status"</span>: <span class="code-str">"valid"</span>,</div>
              <div class="code-line"><span class="code-key">"security"</span>: <span class="code-num">100</span>,</div>
              <div class="code-line"><span class="code-key">"cloudUpload"</span>: <span class="code-bool">false</span></div>
            </div>

            <div class="bento-actions-row">
              <a href="/json-formatter/" class="bento-btn primary">JSON Formatter &rarr;</a>
              <a href="/qr-code-generator/" class="bento-btn secondary">QR Generator</a>
              <a href="/text-tools/" class="bento-btn tertiary">All Dev Tools</a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- ── COMPLETE EXPANSIVE TOOL CATALOG ───────────────────── -->
    <section class="section-container" id="all-tools-catalog" aria-labelledby="catalog-title">
      <div class="section-title-wrap between">
        <div>
          <div class="eyebrow-tag">Full Directory</div>
          <h2 id="catalog-title" class="title-primary">Explore All 35+ File Utilities</h2>
          <p class="subtitle-text">Click any tool to launch immediately in your browser. Fully functional offline.</p>
        </div>
        <div class="catalog-counter" id="catalog-counter-badge">Showing 35 tools</div>
      </div>

      <div class="catalog-grid" id="full-catalog-grid">
        <!-- Flagship 1. Web Image Optimizer -->
        <a href="/image-optimizer/" class="tool-tile tool-tile--highlight" data-category="image" data-keywords="web image optimizer compress convert webp avif resize strip metadata quality">
          <div class="tool-tile__icon icon-emerald">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
          <div class="tool-tile__body">
            <div class="tool-tile__header">
              <h3 class="tool-tile__name">Web Image Optimizer</h3>
              <span class="tool-tile__tag tag-emerald">Flagship</span>
            </div>
            <p class="tool-tile__desc">Convert to WebP/AVIF, compress, resize dimensions, and batch download as ZIP.</p>
          </div>
          <span class="tool-tile__arrow">&rarr;</span>
        </a>

        <!-- Flagship 2. Browser File Inspector -->
        <a href="/file-inspector/" class="tool-tile tool-tile--highlight" data-category="privacy" data-keywords="file inspector properties metadata mime exif camera gps dimensions sha256 md5 hashes verify">
          <div class="tool-tile__icon icon-purple">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </div>
          <div class="tool-tile__body">
            <div class="tool-tile__header">
              <h3 class="tool-tile__name">Browser File Inspector</h3>
              <span class="tool-tile__tag tag-purple">Flagship</span>
            </div>
            <p class="tool-tile__desc">Inspect MIME types, EXIF GPS tags, dimensions, audio durations, and SHA-256 hashes.</p>
          </div>
          <span class="tool-tile__arrow">&rarr;</span>
        </a>

        <!-- 1. Universal Image Converter -->
        <a href="/image-converter/" class="tool-tile" data-category="image" data-keywords="image convert jpg png webp avif batch formats photo picture resize">
          <div class="tool-tile__icon icon-emerald">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          </div>
          <div class="tool-tile__body">
            <div class="tool-tile__header">
              <h3 class="tool-tile__name">Universal Image Converter</h3>
              <span class="tool-tile__tag tag-emerald">Batch</span>
            </div>
            <p class="tool-tile__desc">Convert between JPG, PNG, WebP, and AVIF with custom quality sliders.</p>
          </div>
          <span class="tool-tile__arrow">&rarr;</span>
        </a>

        <!-- 2. Image Compressor -->
        <a href="/compress-image/" class="tool-tile" data-category="image" data-keywords="image compress shrink reduce size target kb mb jpg png webp">
          <div class="tool-tile__icon icon-emerald">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
          <div class="tool-tile__body">
            <div class="tool-tile__header">
              <h3 class="tool-tile__name">Image Compressor</h3>
              <span class="tool-tile__tag tag-emerald">Target KB</span>
            </div>
            <p class="tool-tile__desc">Shrink raster images with precise byte targets and before/after comparisons.</p>
          </div>
          <span class="tool-tile__arrow">&rarr;</span>
        </a>

        <!-- 3. Visual Quality Compare Lab -->
        <a href="/optimization-lab/" class="tool-tile" data-category="image" data-keywords="optimization lab visual compare side by side quality image slider diff">
          <div class="tool-tile__icon icon-emerald">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="2" x2="12" y2="22"></line></svg>
          </div>
          <div class="tool-tile__body">
            <div class="tool-tile__header">
              <h3 class="tool-tile__name">Visual Quality Lab</h3>
              <span class="tool-tile__tag tag-emerald">Diff Slider</span>
            </div>
            <p class="tool-tile__desc">Inspect pixel-level differences between original and compressed graphics.</p>
          </div>
          <span class="tool-tile__arrow">&rarr;</span>
        </a>

        <!-- 4. Image Resizer -->
        <a href="/image/resize/" class="tool-tile" data-category="image" data-keywords="image resize crop dimensions width height aspect ratio pixels">
          <div class="tool-tile__icon icon-emerald">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path></svg>
          </div>
          <div class="tool-tile__body">
            <div class="tool-tile__header">
              <h3 class="tool-tile__name">Image Resizer</h3>
              <span class="tool-tile__tag tag-emerald">Aspect Lock</span>
            </div>
            <p class="tool-tile__desc">Scale dimensions, crop photos, and adjust aspect ratios with sharp bicubic scaling.</p>
          </div>
          <span class="tool-tile__arrow">&rarr;</span>
        </a>

        <!-- 5. JPG to WebP -->
        <a href="/jpg-to-webp/" class="tool-tile" data-category="image" data-keywords="jpg jpeg to webp lightweight modern format next gen">
          <div class="tool-tile__icon icon-emerald">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
          <div class="tool-tile__body">
            <div class="tool-tile__header">
              <h3 class="tool-tile__name">JPG to WebP Converter</h3>
              <span class="tool-tile__tag tag-emerald">-40% Size</span>
            </div>
            <p class="tool-tile__desc">Upgrade old JPEG files to lightweight WebP for lightning-fast page loading.</p>
          </div>
          <span class="tool-tile__arrow">&rarr;</span>
        </a>

        <!-- 6. PNG to WebP -->
        <a href="/png-to-webp/" class="tool-tile" data-category="image" data-keywords="png to webp transparent alpha channel convert optimize">
          <div class="tool-tile__icon icon-emerald">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8" cy="8" r="2"></circle></svg>
          </div>
          <div class="tool-tile__body">
            <div class="tool-tile__header">
              <h3 class="tool-tile__name">PNG to WebP Converter</h3>
              <span class="tool-tile__tag tag-emerald">Alpha Kept</span>
            </div>
            <p class="tool-tile__desc">Preserve transparency while drastically cutting PNG file weight.</p>
          </div>
          <span class="tool-tile__arrow">&rarr;</span>
        </a>

        <!-- 7. Merge PDF -->
        <a href="/pdf/merge/" class="tool-tile" data-category="pdf" data-keywords="pdf merge combine join documents order bind pages">
          <div class="tool-tile__icon icon-rose">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
          </div>
          <div class="tool-tile__body">
            <div class="tool-tile__header">
              <h3 class="tool-tile__name">Merge PDF Files</h3>
              <span class="tool-tile__tag tag-rose">Combine</span>
            </div>
            <p class="tool-tile__desc">Unify several PDF documents with visual drag-and-drop page reordering.</p>
          </div>
          <span class="tool-tile__arrow">&rarr;</span>
        </a>

        <!-- 8. Compress PDF -->
