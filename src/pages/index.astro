<!-- ── INTERACTIVE SCRIPT: INSTANT SEARCH & FILTER ────────────── -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = /** @type {HTMLInputElement | null} */ (document.getElementById('global-tool-search'));
    const clearBtn = document.getElementById('search-clear-action');
    const resetEmptyBtn = document.getElementById('catalog-reset-btn');
    const shortcutBox = document.querySelector('.cmd-shortcut');
    const segmentBtns = document.querySelectorAll('.segment-btn');
    const quickChips = document.querySelectorAll('.quick-chip');
    const bentoCards = document.querySelectorAll('.bento-grid .bento-card');
    const catalogTiles = document.querySelectorAll('.catalog-grid .tool-tile');
    const emptyState = document.getElementById('catalog-empty-state');
    const feedbackBar = document.getElementById('search-feedback');
    const countText = document.getElementById('results-count-text');
    const counterBadge = document.getElementById('catalog-counter-badge');

    let activeCategory = 'all';

    function applyFilter() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let matchedCount = 0;

      // Toggle Clear Button & Shortcut Badge
      if (clearBtn) {
        clearBtn.style.display = query.length > 0 ? 'inline-flex' : 'none';
      }
      if (shortcutBox) {
        (/** @type {HTMLElement} */ (shortcutBox)).style.display = query.length > 0 ? 'none' : 'flex';
      }

      // Filter Bento Cards
      bentoCards.forEach((card) => {
        const cat = card.getAttribute('data-category') || '';
        const text = card.textContent?.toLowerCase() || '';
        const matchesCategory = activeCategory === 'all' || cat === activeCategory;
        const matchesQuery = !query || text.includes(query);

        if (matchesCategory && matchesQuery) {
          (/** @type {HTMLElement} */ (card)).style.display = '';
        } else {
          (/** @type {HTMLElement} */ (card)).style.display = 'none';
        }
      });

      // Filter Catalog Tiles
      catalogTiles.forEach((tile) => {
        const cat = tile.getAttribute('data-category') || '';
        const keywords = tile.getAttribute('data-keywords') || '';
        const text = tile.textContent?.toLowerCase() || '';

        const matchesCat = activeCategory === 'all' || cat === activeCategory;
        const matchesQ = !query || keywords.toLowerCase().includes(query) || text.includes(query);

        if (matchesCat && matchesQ) {
          (/** @type {HTMLElement} */ (tile)).style.display = '';
          matchedCount++;
        } else {
          (/** @type {HTMLElement} */ (tile)).style.display = 'none';
        }
      });

      // Update Catalog Badge & Feedback Bar
      if (counterBadge) {
        counterBadge.textContent = `Showing ${matchedCount} tool${matchedCount === 1 ? '' : 's'}`;
      }

      if (feedbackBar && countText) {
        if (query.length > 0 || activeCategory !== 'all') {
          feedbackBar.style.display = 'flex';
          countText.textContent = `Found ${matchedCount} tool${matchedCount === 1 ? '' : 's'}${activeCategory !== 'all' ? ` in ${activeCategory}` : ''}${query ? ` matching "${query}"` : ''}`;
        } else {
          feedbackBar.style.display = 'none';
        }
      }

      // Empty State
      if (emptyState) {
        emptyState.style.display = matchedCount === 0 ? 'block' : 'none';
      }
    }

    // Input events
    searchInput?.addEventListener('input', applyFilter);

    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
      applyFilter();
    });

    resetEmptyBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      activeCategory = 'all';
      segmentBtns.forEach((btn) => {
        const isAll = btn.getAttribute('data-category') === 'all';
        btn.classList.toggle('active', isAll);
        btn.setAttribute('aria-selected', String(isAll));
      });
      applyFilter();
      searchInput?.focus();
    });

    // Segmented Buttons
    segmentBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        segmentBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        activeCategory = btn.getAttribute('data-category') || 'all';
        applyFilter();
      });
    });

    // Quick Chips
    quickChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const term = chip.getAttribute('data-search-term') || '';
        if (searchInput) {
          searchInput.value = term;
          searchInput.focus();
        }
        applyFilter();
      });
    });

    // Keyboard Shortcuts (⌘K, /, Escape)
    document.addEventListener('keydown', (e) => {
      const isInputFocused = document.activeElement === searchInput;

      if ((e.key === '/' || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) && !isInputFocused) {
        const tag = document.activeElement?.tagName;
        if (tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT') {
          e.preventDefault();
          searchInput?.focus();
          searchInput?.select();
        }
      } else if (e.key === 'Escape' && isInputFocused) {
        if (searchInput.value) {
          searchInput.value = '';
          applyFilter();
        } else {
          searchInput.blur();
        }
      }
    });
  });
</script>

