---
/**
 * json-formatter.astro — Client-Side JSON Formatter & Validator
 * Pretty-print, validate, minify, and inspect JSON in your browser with zero dependencies.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Free JSON Formatter & Validator — Beautify & Minify JSON Online"
  description="Format, validate, and minify JSON data directly in your browser. Detailed syntax error reporting, instant formatting, copy, and download. 100% private with no server uploads."
>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebApplication",
          "name": "FreeFileTools JSON Formatter & Validator",
          "url": "https://freefiletool.app/json-formatter",
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "All",
          "browserRequirements": "Requires JavaScript",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "featureList": [
            "Beautify and indent JSON with 2-space or 4-space formatting",
            "Minify JSON payloads to eliminate whitespace and reduce file size",
            "Pinpoint syntax errors with line and column highlighting",
            "Direct file upload and download for .json files",
            "100% client-side execution with zero data transmission"
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Is my JSON data uploaded or logged anywhere?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. All formatting, validation, and minification operations are performed directly in your browser using native JavaScript JSON APIs. Your data never leaves your device."
              }
            },
            {
              "@type": "Question",
              "name": "How does the syntax error detection work?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "When invalid JSON is supplied, the browser parser detects syntax errors and extracts exact line and column numbers to help you identify missing commas, unescaped quotes, or unmatched brackets."
              }
            },
            {
              "@type": "Question",
              "name": "Can I format large JSON files?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, standard JSON files up to dozens of megabytes can be parsed effortlessly by modern browser engines without network latency."
              }
            }
          ]
        }
      ]
    }
  </script>

  <section class="tool-hero">
    <div class="tool-hero__badge">Data &amp; Text Tools</div>
    <h1 class="tool-hero__title">Online JSON Formatter &amp; Validator</h1>
    <p class="tool-hero__desc">
      Beautify, inspect, validate, and minify JSON files directly in your browser. Fast, secure, and completely private with zero server uploads.
    </p>
  </section>

  <div class="tool-workspace">
    <!-- Toolbar -->
    <div class="editor-toolbar">
      <div class="toolbar-left">
        <label class="btn btn--file">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
          </svg>
          Upload .json
          <input type="file" id="json-file-input" accept=".json,application/json,text/plain" style="display: none;" />
        </label>
        <button type="button" id="btn-format-2" class="btn btn--primary">Format (2 Spaces)</button>
        <button type="button" id="btn-format-4" class="btn btn--secondary">Format (4 Spaces)</button>
        <button type="button" id="btn-minify" class="btn btn--secondary">Minify</button>
        <button type="button" id="btn-clear" class="btn btn--ghost">Clear</button>
      </div>

      <div class="toolbar-right">
        <button type="button" id="btn-copy" class="btn btn--secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span id="copy-label">Copy</span>
        </button>
        <button type="button" id="btn-download" class="btn btn--primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
          </svg>
          Download
        </button>
      </div>
    </div>

    <!-- Error/Status Bar -->
    <div id="status-bar" class="status-bar status-bar--idle" role="status" aria-live="polite">
      <span id="status-icon">✓</span>
      <span id="status-text">Ready — Paste or upload JSON data to format and validate.</span>
    </div>

    <!-- Dual Text Area / Editor -->
    <div class="editor-container">
      <textarea
        id="json-input"
        class="code-editor"
        spellcheck="false"
        placeholder='Paste raw JSON here, for example:
{
  "name": "FreeFileTools",
  "private": true,
  "tools": ["image", "pdf", "audio", "text"]
}'
      ></textarea>
    </div>

    <div class="privacy-badge">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
      </svg>
      <span>Runs entirely in your browser — nothing is uploaded</span>
    </div>
  </div>

  <!-- Educational Section -->
  <section class="info-section">
    <div class="info-grid">
      <div class="info-card">
        <h3>Secure Local Validation</h3>
        <p>
          API keys, environment configurations, and production JSON payloads often contain confidential information. FreeFileTools validates JSON entirely on your machine without logging or sending payloads across the wire.
        </p>
      </div>
      <div class="info-card">
        <h3>Pinpoint Syntax Errors</h3>
        <p>
          Trailing commas, unclosed brackets, and improperly escaped quotation marks are quickly identified so you can resolve parser bugs in web apps and APIs immediately.
        </p>
      </div>
      <div class="info-card">
        <h3>Compact JSON Minification</h3>
        <p>
          Strip all whitespace, indentations, and newlines with a single click. Minified JSON is ideal for database storage, network payloads, and production caching.
        </p>
      </div>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="related-tools-section">
    <h2 class="related-tools-title">More Data &amp; Text Utilities</h2>
    <div class="related-tools-grid">
      <a href="/text-tools" class="related-tool-card">
        <span class="related-tool-name">Text Tools Hub</span>
        <span class="related-tool-desc">View all text, developer, and data utilities</span>
      </a>
      <a href="/base64-encoder-decoder" class="related-tool-card">
        <span class="related-tool-name">Base64 Encoder/Decoder</span>
        <span class="related-tool-desc">Encode and decode text and binary files</span>
      </a>
      <a href="/hash-generator" class="related-tool-card">
        <span class="related-tool-name">Hash Generator</span>
        <span class="related-tool-desc">Generate MD5 and SHA hashes for text &amp; files</span>
      </a>
    </div>
  </section>

  <script>
    const jsonInput = document.getElementById('json-input');
    const fileInput = document.getElementById('json-file-input');
    const btnFormat2 = document.getElementById('btn-format-2');
    const btnFormat4 = document.getElementById('btn-format-4');
    const btnMinify = document.getElementById('btn-minify');
    const btnClear = document.getElementById('btn-clear');
    const btnCopy = document.getElementById('btn-copy');
    const copyLabel = document.getElementById('copy-label');
    const btnDownload = document.getElementById('btn-download');
    const statusBar = document.getElementById('status-bar');
    const statusIcon = document.getElementById('status-icon');
    const statusText = document.getElementById('status-text');

    function setStatus(type, message) {
      statusBar.className = `status-bar status-bar--${type}`;
      if (type === 'valid') {
        statusIcon.textContent = '✓';
      } else if (type === 'error') {
        statusIcon.textContent = '✕';
      } else {
        statusIcon.textContent = 'ℹ';
      }
      statusText.textContent = message;
    }

    function parseAndFormat(spaces = 2) {
      const raw = jsonInput.value.trim();
      if (!raw) {
        setStatus('idle', 'Ready — Paste or upload JSON data to format and validate.');
        return;
      }

      try {
        const parsed = JSON.parse(raw);
        jsonInput.value = JSON.stringify(parsed, null, spaces);
        setStatus('valid', `Valid JSON — Formatted with ${spaces}-space indentation.`);
      } catch (err) {
        const match = err.message.match(/at position (\d+)/) || err.message.match(/line (\d+) column (\d+)/);
        let locationHint = '';
        if (match) {
          if (match.length === 3) {
            locationHint = ` (at Line ${match[1]}, Column ${match[2]})`;
          } else if (match.length === 2) {
            const pos = parseInt(match[1], 10);
            const lines = raw.substring(0, pos).split('\n');
            const lineNum = lines.length;
            const colNum = lines[lines.length - 1].length + 1;
            locationHint = ` (near Line ${lineNum}, Column ${colNum})`;
          }
        }
        setStatus('error', `Invalid JSON: ${err.message}${locationHint}`);
      }
    }

    function minifyJSON() {
      const raw = jsonInput.value.trim();
      if (!raw) return;

      try {
        const parsed = JSON.parse(raw);
        jsonInput.value = JSON.stringify(parsed);
        setStatus('valid', 'Valid JSON — Minified successfully (all whitespace removed).');
      } catch (err) {
        setStatus('error', `Invalid JSON: ${err.message}`);
      }
    }

    // Auto-validate on input debounce
    let debounceTimer;
    jsonInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        const raw = jsonInput.value.trim();
        if (!raw) {
          setStatus('idle', 'Ready — Paste or upload JSON data to format and validate.');
          return;
        }
        try {
          JSON.parse(raw);
          setStatus('valid', 'Valid JSON syntax.');
        } catch (err) {
          setStatus('error', `Syntax Error: ${err.message}`);
        }
      }, 400);
    });

    btnFormat2.addEventListener('click', () => parseAndFormat(2));
    btnFormat4.addEventListener('click', () => parseAndFormat(4));
    btnMinify.addEventListener('click', minifyJSON);
    btnClear.addEventListener('click', () => {
      jsonInput.value = '';
      setStatus('idle', 'Ready — Paste or upload JSON data to format and validate.');
    });

    fileInput.addEventListener('change', (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        jsonInput.value = reader.result;
        parseAndFormat(2);
      };
      reader.readAsText(file);
    });

    btnCopy.addEventListener('click', async () => {
      const text = jsonInput.value;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        copyLabel.textContent = 'Copied!';
        setTimeout(() => { copyLabel.textContent = 'Copy'; }, 2000);
      } catch (_) {
        jsonInput.select();
        document.execCommand('copy');
        copyLabel.textContent = 'Copied!';
        setTimeout(() => { copyLabel.textContent = 'Copy'; }, 2000);
      }
    });

    btnDownload.addEventListener('click', () => {
      const text = jsonInput.value;
      if (!text) return;
      const blob = new Blob([text], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'data.json';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 60000);
    });
  </script>

  <style>
    .tool-hero {
      text-align: center;
      padding: var(--space-8) var(--space-4) var(--space-6);
      max-width: 800px;
      margin: 0 auto;
    }
    .tool-hero__badge {
      display: inline-block;
      font-size: var(--font-size-xs);
      font-weight: 600;
      color: var(--color-brand-400);
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.2);
      border-radius: var(--radius-full);
      padding: var(--space-1) var(--space-3);
      margin-bottom: var(--space-3);
    }
    .tool-hero__title {
      font-size: var(--font-size-3xl);
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1.2;
      margin-bottom: var(--space-3);
    }
    .tool-hero__desc {
      font-size: var(--font-size-base);
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .tool-workspace {
      max-width: 1040px;
      margin: 0 auto var(--space-12);
      padding: 0 var(--space-4);
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .editor-toolbar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-3);
      background: var(--surface-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: var(--space-3) var(--space-4);
      align-items: center;
    }
    .toolbar-left, .toolbar-right {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      align-items: center;
    }

    .status-bar {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-md);
      font-size: var(--font-size-sm);
      font-weight: 500;
      transition: all var(--transition-base);
    }
    .status-bar--idle {
      background: var(--surface-elevated);
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
    }
    .status-bar--valid {
      background: rgba(34, 197, 94, 0.1);
      color: var(--color-brand-400);
      border: 1px solid rgba(34, 197, 94, 0.25);
    }
    .status-bar--error {
      background: rgba(239, 68, 68, 0.1);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.25);
    }

    .editor-container {
      background: var(--surface-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }
    .code-editor {
      width: 100%;
      min-height: 420px;
      background: transparent;
      color: var(--text-primary);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: var(--font-size-sm);
      line-height: 1.6;
      padding: var(--space-4);
      border: none;
      resize: vertical;
      box-sizing: border-box;
      outline: none;
      white-space: pre;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--font-size-xs);
      font-weight: 500;
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      cursor: pointer;
      border: none;
      transition: all var(--transition-base);
    }
    .btn--primary {
      background: var(--color-brand-500);
      color: #000000;
      font-weight: 600;
    }
    .btn--primary:hover {
      background: var(--color-brand-400);
    }
    .btn--secondary {
      background: var(--surface-elevated);
      color: var(--text-primary);
      border: 1px solid var(--border-subtle);
    }
    .btn--secondary:hover {
      background: var(--surface-card);
      border-color: var(--border-default);
    }
    .btn--ghost {
      background: transparent;
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
    }
    .btn--ghost:hover {
      color: var(--text-primary);
    }
    .btn--file {
      background: var(--surface-elevated);
      color: var(--text-primary);
      border: 1px solid var(--border-subtle);
    }
    .btn--file:hover {
      border-color: var(--color-brand-500);
    }

    .privacy-badge {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--font-size-xs);
      color: var(--color-brand-400);
      background: rgba(34, 197, 94, 0.06);
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      border: 1px solid rgba(34, 197, 94, 0.15);
      margin-top: var(--space-2);
    }

    .info-section {
      max-width: 1040px;
      margin: 0 auto var(--space-12);
      padding: 0 var(--space-4);
    }
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-6);
    }
    .info-card {
      background: var(--surface-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
    }
    .info-card h3 {
      font-size: var(--font-size-md);
      font-weight: 600;
      color: var(--text-primary);
      margin: 0 0 var(--space-2);
    }
    .info-card p {
      font-size: var(--font-size-sm);
      color: var(--text-secondary);
      line-height: 1.6;
      margin: 0;
    }

    .related-tools-section {
      max-width: 1040px;
      margin: 0 auto var(--space-12);
      padding: 0 var(--space-4);
    }
    .related-tools-title {
      font-size: var(--font-size-xl);
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: var(--space-6);
    }
    .related-tools-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: var(--space-4);
    }
    .related-tool-card {
      background: var(--surface-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: var(--space-4);
      text-decoration: none;
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      transition: all var(--transition-base);
    }
    .related-tool-card:hover {
      border-color: var(--color-brand-500);
      transform: translateY(-2px);
    }
    .related-tool-name {
      font-size: var(--font-size-sm);
      font-weight: 600;
      color: var(--text-primary);
    }
    .related-tool-desc {
      font-size: var(--font-size-xs);
      color: var(--text-secondary);
    }
  </style>
</BaseLayout>
