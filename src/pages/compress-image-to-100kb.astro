---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrivacyBadge from '../components/PrivacyBadge.astro';
import RelatedTools from '../components/RelatedTools.astro';

const title = "Compress Image to 100KB Online Free — Reduce JPG & PNG Size | FreeFileTool";
const description = "Compress images to under 100 KB online. Automatic binary search quality tuning for online form uploads, passport photos, and web applications. 100% private.";
const canonicalURL = "https://freefiletool.app/compress-image-to-100kb/";

const faqItems = [
  {
    question: "How does the compressor guarantee the image stays under 100 KB?",
    answer: "Our client-side engine uses a binary search algorithm to test encoding quality levels and resolution scales directly in your browser memory until your file size falls below 100 KB."
  },
  {
    question: "What happens if a high-resolution photo cannot fit into 100 KB?",
    answer: "If quality reduction alone is insufficient to reach 100 KB (e.g. for a 20 MB RAW photo), the engine intelligently rescales pixel dimensions while preserving aspect ratio. If the target is unreachable, an honest status message will show the lowest achieved size."
  },
  {
    question: "Is this compressor suitable for government and job portal uploads?",
    answer: "Yes! Many portal forms (e.g. visa applications, exam registrations, employment portals) mandate image files strictly under 100 KB. Our tool formats images to meet these exact portal constraints."
  }
];
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "name": "FreeFileTool Compress Image to 100KB",
        "url": canonicalURL,
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "All",
        "browserRequirements": "Requires JavaScript",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": { "@type": "Answer", "text": item.answer }
        }))
      }
    ]
  })} />

  <div class="tool-page-container max-w-6xl mx-auto px-4 py-8">
    <header class="tool-hero text-center mb-8">
      <div class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-400 border border-brand-500/20 mb-3">
        Target Size Compressor
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-100 mb-3">Compress Image to 100KB</h1>
      <p class="text-slate-400 max-w-2xl mx-auto text-base sm:text-lg mb-4">
        Automatically reduce JPG, PNG, or WebP image size to under 100 KB. Ideal for online application forms, resumes, and official portals.
      </p>
      <div class="flex justify-center">
        <PrivacyBadge variant="badge" tech="HTML5 Canvas & Client JS" />
      </div>
    </header>

    <main class="tool-workspace my-8 bg-slate-900/60 border border-slate-800 rounded-xl p-4 sm:p-6 shadow-xl">
      <div id="drop-zone" class="border-2 border-dashed border-slate-700 hover:border-brand-500 rounded-xl p-8 text-center cursor-pointer transition-colors">
        <input type="file" id="image-input" accept="image/jpeg,image/png,image/webp" class="hidden" />
        <div class="text-4xl mb-3">📉</div>
        <p class="text-slate-200 font-semibold mb-1">Click to browse or drop image here</p>
        <p class="text-slate-400 text-sm">Target: strictly &le; 100 KB · 100% private in-browser compression</p>
      </div>

      <div id="status-msg" class="hidden my-4 p-4 rounded-lg text-sm text-center"></div>

      <div id="result-box" class="hidden mt-6 bg-slate-800/80 border border-slate-700 rounded-xl p-6 text-center">
        <h2 class="text-lg font-bold text-slate-100 mb-2">Compression Complete</h2>
        <div class="flex flex-wrap justify-center gap-6 text-sm text-slate-300 my-4">
          <div>Original: <span id="orig-size" class="font-bold text-slate-100">0 KB</span></div>
          <div>Compressed: <span id="new-size" class="font-bold text-brand-400">0 KB</span></div>
          <div>Quality Used: <span id="quality-used" class="font-bold text-slate-100">0%</span></div>
        </div>

        <a id="download-btn" class="inline-block px-6 py-2.5 bg-brand-600 hover:bg-brand-500 text-white font-bold rounded-lg text-sm transition-colors shadow-lg cursor-pointer">
          Download Image (&le;100 KB)
        </a>
      </div>
    </main>

    <section class="tool-guide-content prose prose-invert max-w-none my-12 bg-slate-900/40 border border-slate-800/80 rounded-xl p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">Why Compress Images to 100KB?</h2>
      <p class="text-slate-300">
        Many government portals, job application forms, university admission systems, and visa application websites impose a strict upper file size limit of 100 KB for photo uploads. Attempting to submit a 2 MB or 5 MB photo results in immediate rejection errors. FreeFileTool automatically adjusts lossy encoding parameters using client-side binary search to deliver a crisp image file under 100 KB.
      </p>

      <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">How Target Size Compression Works</h3>
      <ol class="list-decimal pl-5 space-y-2 text-slate-300">
        <li><strong>Binary Search Quality Tuning:</strong> The compressor iteratively tests JPEG/WebP quality ratios (e.g. 75%, 50%, 35%) directly in device memory.</li>
        <li><strong>Adaptive Resolution Scaling:</strong> If reducing image quality alone does not bring a high-resolution photo below 100 KB, the engine downsamples pixel dimensions while preserving exact aspect ratios.</li>
        <li><strong>Honest Size Guarantee:</strong> You are provided exact byte measurements. If an extreme file cannot reach 100 KB without severe distortion, the tool informs you honestly of the lowest achievable size.</li>
      </ol>

      <div class="tool-faq-block mt-10 pt-8 border-t border-slate-800">
        <h2 class="text-2xl font-bold text-slate-100 mb-6">Frequently Asked Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {faqItems.map(item => (
            <div class="faq-item-card bg-slate-800/50 border border-slate-700/50 rounded-lg p-5">
              <h3 class="text-lg font-semibold text-slate-200 mb-2">{item.question}</h3>
              <p class="text-slate-400 text-sm leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <RelatedTools currentSlug="compress-image" limit={4} />
  </div>
</BaseLayout>

<script>
  import { compressToTargetSize } from '../lib/imageCompressor';

  const dropZone = document.getElementById('drop-zone')!;
  const imageInput = document.getElementById('image-input') as HTMLInputElement;
  const statusMsg = document.getElementById('status-msg')!;
  const resultBox = document.getElementById('result-box')!;
  const origSizeSpan = document.getElementById('orig-size')!;
  const newSizeSpan = document.getElementById('new-size')!;
  const qualityUsedSpan = document.getElementById('quality-used')!;
  const downloadBtn = document.getElementById('download-btn') as HTMLAnchorElement;

  function formatKB(bytes: number) {
    return (bytes / 1024).toFixed(1) + ' KB';
  }

  function showStatus(msg: string, type: 'info' | 'error' | 'success') {
    statusMsg.classList.remove('hidden', 'bg-blue-950', 'text-blue-300', 'bg-red-950', 'text-red-300', 'bg-emerald-950', 'text-emerald-300');
    if (type === 'error') {
      statusMsg.classList.add('bg-red-950', 'text-red-300', 'border', 'border-red-800');
    } else if (type === 'success') {
      statusMsg.classList.add('bg-emerald-950', 'text-emerald-300', 'border', 'border-emerald-800');
    } else {
      statusMsg.classList.add('bg-blue-950', 'text-blue-300', 'border', 'border-blue-800');
    }
    statusMsg.textContent = msg;
  }

  dropZone.addEventListener('click', () => imageInput.click());
  dropZone.addEventListener('dragover', (e) => e.preventDefault());
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer?.files.length) handleFile(e.dataTransfer.files[0]);
  });

  imageInput.addEventListener('change', () => {
    if (imageInput.files?.length) handleFile(imageInput.files[0]);
  });

  async function handleFile(file: File) {
    if (!file.type.startsWith('image/')) {
      showStatus('Please select a valid image file (JPG, PNG, WebP).', 'error');
      return;
    }

    showStatus('Compressing image to under 100 KB in browser memory...', 'info');

    try {
      const targetBytes = 100 * 1024; // 100 KB
      const res = await compressToTargetSize(file, targetBytes, 'jpg');

      origSizeSpan.textContent = formatKB(file.size);
      newSizeSpan.textContent = formatKB(res.finalSize);
      qualityUsedSpan.textContent = res.quality + '%';

      const url = URL.createObjectURL(res.blob);
      downloadBtn.href = url;
      const base = file.name.replace(/\.[^/.]+$/, '');
      downloadBtn.download = `${base}-100kb.jpg`;

      resultBox.classList.remove('hidden');

      if (res.targetReached) {
        showStatus(`Success! Image compressed to ${formatKB(res.finalSize)} (under 100 KB).`, 'success');
      } else {
        showStatus(`Compressed to ${formatKB(res.finalSize)}. Target 100 KB reached best-effort quality limit.`, 'info');
      }
    } catch (err: any) {
      showStatus(err.message || 'Failed to compress image.', 'error');
    }
  }
</script>
