---
/**
 * image-tools/index.astro — Image Tools Index / Hub Page
 * Scalable category index for image optimization and conversion tools.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecentHistory from '../../components/RecentHistory.astro';
import PrivacyBadge from '../../components/PrivacyBadge.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
---

<BaseLayout
  title="Browser-Side Image Optimization & Conversion Tools — FreeFileTool"
  description="Explore our suite of 100% private browser-side image conversion, compression, and editing tools. Convert JPG, PNG, WebP, and AVIF locally without cloud uploads."
>
  <header class="hub-hero">
    <div class="hub-hero__badge">Image Studio</div>
    <h1 class="hub-title">Online Image Optimization &amp; Conversion Tools</h1>
    <p class="hub-desc">
      All conversion, compression, and editing processes occur locally inside your browser memory. Your files are never uploaded to any remote server.
    </p>
    <PrivacyBadge variant="badge" />
  </header>

  <AdSlot position="top-leaderboard" />

  <section class="tools-hub" aria-label="Available Image Tools">
    <!-- Category: Convert Formats -->
    <div class="category-block">
      <h2 class="category-title">
        <span class="category-icon">🔄</span> Format Converters &amp; Optimizers
      </h2>
      <p class="category-desc">Convert between JPG, PNG, WebP, and AVIF formats with custom quality controls, dimension scaling, and batch processing.</p>
      
      <div class="category-grid">
        <div class="tool-card tool-card--featured">
          <div class="tool-badge">Flagship</div>
          <h3 class="tool-title"><a href="/image-optimizer/">Web Image Optimizer</a></h3>
          <p class="tool-desc">
            All-in-one optimizer: convert to WebP/AVIF, compress file size, resize dimensions, and batch download as ZIP with live savings metrics.
          </p>
          <a href="/image-optimizer/" class="tool-link">Launch Image Optimizer &rarr;</a>
        </div>

        <div class="tool-card tool-card--featured">
          <div class="tool-badge">Hub</div>
          <h3 class="tool-title"><a href="/image-converter/">Universal Image Converter</a></h3>
          <p class="tool-desc">
            All-in-one format converter supporting any combination of JPG, PNG, WebP, and AVIF. Batch processing with ZIP downloads.
          </p>
          <a href="/image-converter/" class="tool-link">Open Converter &rarr;</a>
        </div>

        <div class="tool-card tool-card--featured">
          <div class="tool-badge">Featured</div>
          <h3 class="tool-title"><a href="/heic-to-jpg/">HEIC to JPG Converter</a></h3>
          <p class="tool-desc">
            Convert Apple iPhone HEIC/HEIF photos to JPG or PNG format with custom quality slider and local decoding.
          </p>
          <a href="/heic-to-jpg/" class="tool-link">Convert HEIC &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/social-image-resizer/">Social Media Image Resizer</a></h3>
          <p class="tool-desc">
            Resize and crop images for Instagram, YouTube, LinkedIn, and WhatsApp using exact pixel dimension presets.
          </p>
          <a href="/social-image-resizer/" class="tool-link">Resize Image &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/favicon-generator/">Favicon &amp; App Icon Generator</a></h3>
          <p class="tool-desc">
            Generate website favicons in PNG sizes plus multi-resolution .ico files bundled into a ZIP archive.
          </p>
          <a href="/favicon-generator/" class="tool-link">Generate Favicon &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/image-crop-rotate/">Image Crop &amp; Rotate Tool</a></h3>
          <p class="tool-desc">
            Rotate photos 90/180/270 degrees, flip horizontal/vertical, and crop custom image regions locally.
          </p>
          <a href="/image-crop-rotate/" class="tool-link">Crop &amp; Rotate &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/svg-to-png/">SVG to PNG Converter</a></h3>
          <p class="tool-desc">
            Rasterize Scalable Vector Graphics (SVG) into high-resolution PNG or JPG images with custom scale factors.
          </p>
          <a href="/svg-to-png/" class="tool-link">Convert SVG &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/image/convert-to-avif/">Convert Image to AVIF</a></h3>
          <p class="tool-desc">
            Convert JPG and PNG images to next-generation AVIF format for high compression.
          </p>
          <a href="/image/convert-to-avif/" class="tool-link">Convert to AVIF &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/image/strip-metadata/">Strip Photo Metadata</a></h3>
          <p class="tool-desc">
            Remove GPS location data and EXIF camera tags from photos before sharing online.
          </p>
          <a href="/image/strip-metadata/" class="tool-link">Strip Metadata &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/image/resize/">Image Resizer</a></h3>
          <p class="tool-desc">
            Scale pixel dimensions, maintain aspect ratio, and resize graphics locally.
          </p>
          <a href="/image/resize/" class="tool-link">Resize Image &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/optimize-file/">Optimize File Hub</a></h3>
          <p class="tool-desc">
            Analyze file formats and get instant compression recommendations.
          </p>
          <a href="/optimize-file/" class="tool-link">Optimize File &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/jpg-to-webp/">JPG to WebP Converter</a></h3>
          <p class="tool-desc">
            Re-encode JPEG photos into lightweight WebP format to save up to 40% in page file size for Core Web Vitals.
          </p>
          <a href="/jpg-to-webp/" class="tool-link">Use Converter &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/png-to-webp/">PNG to WebP Converter</a></h3>
          <p class="tool-desc">
            Transform PNG graphics to WebP while retaining full 8-bit alpha transparency and reducing file weight by up to 35%.
          </p>
          <a href="/png-to-webp/" class="tool-link">Use Converter &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/jpg-to-png/">JPG to PNG Converter</a></h3>
          <p class="tool-desc">
            Convert JPEG photos to lossless PNG format to stop compression artifacts during graphic design and editing passes.
          </p>
          <a href="/jpg-to-png/" class="tool-link">Use Converter &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/png-to-jpg/">PNG to JPG Converter</a></h3>
          <p class="tool-desc">
            Convert oversized PNGs to lightweight JPGs with clean white background compositing for email and web sharing.
          </p>
          <a href="/png-to-jpg/" class="tool-link">Use Converter &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/webp-to-jpg/">WebP to JPG Converter</a></h3>
          <p class="tool-desc">
            Convert downloaded WebP web graphics to standard JPEG files for legacy desktop photo viewers and office software.
          </p>
          <a href="/webp-to-jpg/" class="tool-link">Use Converter &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/webp-to-png/">WebP to PNG Converter</a></h3>
          <p class="tool-desc">
            Extract WebP graphics into uncompressed, pixel-perfect PNG format with complete alpha transparency preserved.
          </p>
          <a href="/webp-to-png/" class="tool-link">Use Converter &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/jpg-to-avif/">JPG to AVIF Converter</a></h3>
          <p class="tool-desc">
            Convert JPEG images to next-generation AVIF format for up to 50% byte savings using modern AV1 compression.
          </p>
          <a href="/jpg-to-avif/" class="tool-link">Use Converter &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/png-to-avif/">PNG to AVIF Converter</a></h3>
          <p class="tool-desc">
            Compress transparent PNG graphics into high-efficiency AVIF format with alpha channel support.
          </p>
          <a href="/png-to-avif/" class="tool-link">Use Converter &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/avif-to-jpg/">AVIF to JPG Converter</a></h3>
          <p class="tool-desc">
            Convert AVIF images into standard JPEG format for universal compatibility with all photo software and devices.
          </p>
          <a href="/avif-to-jpg/" class="tool-link">Use Converter &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/avif-to-png/">AVIF to PNG Converter</a></h3>
          <p class="tool-desc">
            Convert next-generation AVIF files into lossless PNG format with transparent background retention.
          </p>
          <a href="/avif-to-png/" class="tool-link">Use Converter &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/image/convert-to-avif/">Convert to AVIF</a></h3>
          <p class="tool-desc">
            Convert uploaded images to modern AVIF format for superior compression directly in your browser.
          </p>
          <a href="/image/convert-to-avif/" class="tool-link">Use Converter &rarr;</a>
        </div>
      </div>
    </div>

    <!-- Category: Compress & Optimize -->
    <div class="category-block">
      <h2 class="category-title">
        <span class="category-icon">📉</span> Compress &amp; Optimize
      </h2>
      <p class="category-desc">Shrink the raw byte weight of digital graphics and assets without altering their original visual dimensions.</p>

      <div class="category-grid">
        <div class="tool-card">
          <h3 class="tool-title"><a href="/compress-image/">Image Compressor</a></h3>
          <p class="tool-desc">
            Compress JPG, PNG, and WebP images. Select lossy or lossless compression standards to fit Web Vitals LCP scoring targets.
          </p>
          <a href="/compress-image/" class="tool-link">Use Compressor &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/compress-image-to-100kb/">Compress Image to 100KB</a></h3>
          <p class="tool-desc">
            Automatically reduce image size to strictly under 100 KB for online application forms and identity portals.
          </p>
          <a href="/compress-image-to-100kb/" class="tool-link">Compress to 100KB &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/compress-image-to-50kb/">Compress Image to 50KB</a></h3>
          <p class="tool-desc">
            Shrink photos to under 50 KB for strict exam registration portals and profile picture uploads.
          </p>
          <a href="/compress-image-to-50kb/" class="tool-link">Compress to 50KB &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/compress-image-to-200kb/">Compress Image to 200KB</a></h3>
          <p class="tool-desc">
            Optimize image files to remain under 200 KB for digital job portals and online submissions.
          </p>
          <a href="/compress-image-to-200kb/" class="tool-link">Compress to 200KB &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/heic-to-png/">HEIC to PNG Converter</a></h3>
          <p class="tool-desc">
            Convert Apple iPhone HEIC/HEIF photos to lossless PNG format 100% locally with zero server uploads.
          </p>
          <a href="/heic-to-png/" class="tool-link">Convert to PNG &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/optimization-lab/">Optimization Lab</a></h3>
          <p class="tool-desc">
            Interactive playground for benchmarking compression ratios, format comparisons, and visual quality trade-offs.
          </p>
          <a href="/optimization-lab/" class="tool-link">Open Lab &rarr;</a>
        </div>
      </div>
    </div>

    <!-- Category: Edit & Privacy -->
    <div class="category-block">
      <h2 class="category-title">
        <span class="category-icon">✂️</span> Edit &amp; Privacy
      </h2>
      <p class="category-desc">Resize image dimensions and remove tracking metadata before publishing online.</p>

      <div class="category-grid">
        <div class="tool-card">
          <h3 class="tool-title"><a href="/image/resize/">Resize Images</a></h3>
          <p class="tool-desc">
            Resize images to custom width and height dimensions while preserving aspect ratio. No uploads – all processing in-browser.
          </p>
          <a href="/image/resize/" class="tool-link">Resize Images &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/privacy-tools/exif-remover/">Strip Image Metadata (EXIF)</a></h3>
          <p class="tool-desc">
            Remove hidden EXIF camera data, timestamps, and GPS coordinates from photos to protect privacy before sharing.
          </p>
          <a href="/privacy-tools/exif-remover/" class="tool-link">Strip Metadata &rarr;</a>
        </div>
      </div>
    </div>

    <!-- Category: PDF Tools Cross-Link -->
    <div class="category-block">
      <h2 class="category-title">
        <span class="category-icon">📄</span> Need PDF Utilities?
      </h2>
      <p class="category-desc">Turn images into documents or edit PDFs directly in your browser with 100% privacy.</p>
      
      <div class="category-grid">
        <div class="tool-card">
          <h3 class="tool-title"><a href="/pdf/jpg-to-pdf/">JPG to PDF Converter</a></h3>
          <p class="tool-desc">
            Combine multiple JPEG photos into a clean multi-page PDF document with standardized A4 layout options.
          </p>
          <a href="/pdf/jpg-to-pdf/" class="tool-link">Convert JPG to PDF &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/pdf/png-to-pdf/">PNG to PDF Converter</a></h3>
          <p class="tool-desc">
            Convert high-resolution PNG images into standard PDF documents with client-side processing.
          </p>
          <a href="/pdf/png-to-pdf/" class="tool-link">Convert PNG to PDF &rarr;</a>
        </div>

        <div class="tool-card">
          <h3 class="tool-title"><a href="/pdf/compress/">Compress PDF</a></h3>
          <p class="tool-desc">
            Reduce PDF document size using in-browser object stream optimization without degrading text clarity.
          </p>
          <a href="/pdf/compress/" class="tool-link">Compress PDF &rarr;</a>
        </div>
      </div>
      <div style="margin-top: var(--space-4);">
        <a href="/pdf/" class="tool-link" style="font-weight: var(--font-weight-bold);">Explore all 7 PDF Tools &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Recent History Widget -->
  <RecentHistory />

  <!-- AdSense Slot: Below tools list -->
  <div class="adsense-slot" aria-label="Advertisement"></div>
</BaseLayout>

<style>
  .hub-hero {
    text-align: center;
    padding: var(--space-10) 0 var(--space-8);
  }

  .hub-title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .hub-desc {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    max-width: 50ch;
    margin-inline: auto;
    line-height: var(--line-height-loose);
  }

  .tools-hub {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .category-block {
    border-top: 1px solid var(--border-default);
    padding-top: var(--space-8);
  }

  .category-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .category-icon {
    font-size: 1.25em;
    user-select: none;
  }

  .category-desc {
    font-size: var(--font-size-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-6);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  @media (max-width: 600px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }

  .tool-card {
    background: var(--surface-1);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    transition: transform var(--transition-base), border-color var(--transition-base);
  }

  .tool-card--featured {
    border-color: color-mix(in srgb, var(--color-brand-400) 50%, var(--border-default));
    background: color-mix(in srgb, var(--color-brand-500) 5%, var(--surface-1));
  }

  .tool-badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-brand-300);
    background: color-mix(in srgb, var(--color-brand-500) 20%, transparent);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--color-brand-400) 30%, transparent);
  }

  .tool-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand-400);
  }

  .tool-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .tool-title a {
    text-decoration: none;
    color: inherit;
  }

  .tool-title a:hover {
    color: var(--color-brand-400);
  }

  .tool-desc {
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
    line-height: var(--line-height-loose);
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .tool-link {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-brand-400);
    text-decoration: none;
  }

  .tool-link:hover {
    text-decoration: underline;
  }
</style>
