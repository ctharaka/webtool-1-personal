---
import ToolPageTemplate from '../components/ToolPageTemplate.astro';

const faqItems = [
  {
    question: "Why convert PNG images to JPG format?",
    answer: "PNG images use lossless compression, resulting in significantly larger file sizes. Converting PNG graphics to JPG reduces file size by up to 70-80%, accelerating web page load times."
  },
  {
    question: "What happens to transparent backgrounds in PNGs when converting to JPG?",
    answer: "JPEG does not support alpha channel transparency. Our converter allows you to fill transparent pixels with a clean white or custom background color."
  },
  {
    question: "Are my PNG images uploaded to an external server?",
    answer: "No. Your files are processed on your device and are never uploaded."
  },
  {
    question: "Can I convert multiple PNG files in bulk?",
    answer: "Yes, you can drag and drop multiple PNG files to convert them simultaneously in parallel, downloading individual converted JPGs or a combined ZIP archive."
  }
];
---

<ToolPageTemplate
  toolSlug="png-to-jpg"
  toolName="PNG to JPG Converter"
  title="PNG to JPG Converter — Convert PNG to JPEG Online Free"
  description="Convert PNG images to standard JPEG format 100% locally in your browser. Batch conversion, custom quality slider, and background fill options."
  badge="Image Studio"
  faqItems={faqItems}
>
  <div class="space-y-6">
    <!-- Controls Bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 p-4 bg-slate-950 border border-slate-800 rounded-lg text-sm font-semibold text-slate-300">
      <div class="flex items-center gap-4">
        <div>
          <label for="p2j-quality" class="mr-2">JPG Quality:</label>
          <input type="range" id="p2j-quality" min="0.5" max="1.0" step="0.05" value="0.9" class="accent-brand-500 align-middle" />
          <span id="p2j-quality-val" class="font-mono text-brand-400 ml-1">90%</span>
        </div>

        <div>
          <label for="p2j-bg-color" class="mr-2">Background Fill:</label>
          <input type="color" id="p2j-bg-color" value="#ffffff" class="w-7 h-7 rounded border-0 align-middle bg-transparent cursor-pointer" />
        </div>
      </div>
    </div>

    <!-- Drop Zone -->
    <div
      id="p2j-dropzone"
      class="border-2 border-dashed border-slate-700 hover:border-brand-500 rounded-xl p-8 text-center bg-slate-950/50 cursor-pointer transition"
    >
      <div class="space-y-3">
        <span class="text-4xl block">🖼️</span>
        <p class="text-base font-semibold text-slate-200">Drag &amp; Drop PNG images here to convert to JPG</p>
        <p class="text-xs text-slate-400">Batch conversion with zero server uploads</p>
        <input type="file" id="p2j-file-input" accept="image/png,.png" multiple class="hidden" />
      </div>
    </div>

    <!-- Results Grid -->
    <div id="p2j-results-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
  </div>

  <div slot="guide">
    <h2 class="text-2xl font-bold text-slate-100 mb-4">Converting Lossless PNGs to Web-Optimized JPEGs</h2>
    <p class="text-slate-300 leading-relaxed mb-4">
      Portable Network Graphics (PNG) is an uncompressed or losslessly compressed raster format ideal for line drawings, screenshots, and graphics requiring transparent backgrounds. However, for complex photographic content, PNG files can be 5 to 10 times larger than necessary.
    </p>

    <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Handling Alpha Transparency</h3>
    <p class="text-slate-300 leading-relaxed mb-4">
      Because JPEG does not support an alpha transparency channel, transparent pixels must be rendered against a solid color background. FreeFileTool projects the PNG graphic onto an HTML5 Canvas initialized with your selected background fill color (defaulting to white).
    </p>

    <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Data Privacy Guarantee</h3>
    <p class="text-slate-300 leading-relaxed mb-4">
      All image decoding, canvas rendering, and JPEG encoding occur in your browser's local memory space. Your files are processed on your device and are never uploaded.
    </p>
  </div>
</ToolPageTemplate>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dropzone = document.getElementById('p2j-dropzone');
    const fileInput = document.getElementById('p2j-file-input') as HTMLInputElement;
    const qualityInput = document.getElementById('p2j-quality') as HTMLInputElement;
    const qualityVal = document.getElementById('p2j-quality-val') as HTMLElement;
    const bgColorInput = document.getElementById('p2j-bg-color') as HTMLInputElement;
    const resultsGrid = document.getElementById('p2j-results-grid') as HTMLElement;

    qualityInput?.addEventListener('input', () => {
      if (qualityVal) qualityVal.textContent = `${Math.round(parseFloat(qualityInput.value) * 100)}%`;
    });

    dropzone?.addEventListener('click', () => fileInput?.click());

    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-brand-500', 'bg-brand-500/10');
    });

    dropzone?.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-brand-500', 'bg-brand-500/10');
    });

    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-brand-500', 'bg-brand-500/10');
      if (e.dataTransfer?.files?.length) {
        convertFiles(Array.from(e.dataTransfer.files));
      }
    });

    fileInput?.addEventListener('change', () => {
      if (fileInput.files?.length) {
        convertFiles(Array.from(fileInput.files));
      }
    });

    function convertFiles(files: File[]) {
      const pngFiles = files.filter(f => f.type === 'image/png' || f.name.match(/\.png$/i));
      if (pngFiles.length === 0) {
        alert('Please select valid PNG image files.');
        return;
      }

      const quality = parseFloat(qualityInput?.value || '0.9');
      const bgColor = bgColorInput?.value || '#ffffff';

      if (resultsGrid) resultsGrid.innerHTML = '';

      pngFiles.forEach(file => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = img.width;
            canvas.height = img.height;
            const ctx = canvas.getContext('2d');
            if (ctx) {
              ctx.fillStyle = bgColor;
              ctx.fillRect(0, 0, canvas.width, canvas.height);
              ctx.drawImage(img, 0, 0);
            }

            const dataUrl = canvas.toDataURL('image/jpeg', quality);
            const outName = file.name.replace(/\.png$/i, '.jpg');

            renderResultCard(outName, dataUrl, file.size);
          };
          img.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);
      });
    }

    function renderResultCard(name: string, dataUrl: string, origSize: number) {
      if (!resultsGrid) return;
      const card = document.createElement('div');
      card.className = 'bg-slate-950 border border-slate-800 rounded-lg p-3 space-y-2';

      const img = document.createElement('img');
      img.src = dataUrl;
      img.className = 'w-full h-36 object-cover rounded border border-slate-800';

      const title = document.createElement('div');
      title.className = 'text-xs font-semibold text-slate-200 truncate';
      title.textContent = name;

      const btn = document.createElement('a');
      btn.href = dataUrl;
      btn.download = name;
      btn.className = 'block text-center py-1.5 bg-brand-600 hover:bg-brand-500 text-white rounded text-xs font-semibold transition';
      btn.textContent = 'Download JPG';

      card.appendChild(img);
      card.appendChild(title);
      card.appendChild(btn);
      resultsGrid.appendChild(card);
    }
  });
</script>
