<BaseLayout
  title="How to Reduce Image Size Without Losing Quality — FreeFileTools"
  description="Master the art of image compression. Learn how lossy quantization, the 80% quality sweet spot, and human visual perception can help you optimize images."
>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          "headline": "How to Reduce Image Size Without Losing Quality",
          "description": "A comprehensive guide explaining the mechanics of image compression, quantization, and optimizing images for core web vitals without visual loss.",
