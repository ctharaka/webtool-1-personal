---
import ToolPageTemplate from '../components/ToolPageTemplate.astro';

const faqItems = [
  {
    question: "How does SVG to PNG conversion work in the browser?",
    answer: "FreeFileTool converts Scalable Vector Graphics (SVG) into raster PNG images using HTML5 Canvas rendering. The SVG vector code is loaded into an Image object and rendered at your target resolution."
  },
  {
    question: "Are my SVG vector files uploaded to an external server?",
    answer: "No. All vector parsing, canvas rasterization, and PNG file exports run 100% in local browser memory. Your files are processed on your device and are never uploaded."
  },
  {
    question: "Can I preserve transparent backgrounds in converted PNGs?",
    answer: "Yes! By default, PNG export preserves full alpha channel transparency. You can also toggle a solid background color if desired."
  },
  {
    question: "What resolution scaling options are supported?",
    answer: "You can render SVG graphics at 1x, 2x (Retina), 4x (Ultra HD), or specify custom pixel widths and heights without loss of sharpness."
  }
];
---

<ToolPageTemplate
  toolSlug="svg-to-png"
  toolName="SVG to PNG Converter"
  title="SVG to PNG Converter — Convert Vector SVG to High-Res PNG Free"
  description="Convert Scalable Vector Graphics (SVG) into high-resolution PNG or JPG images 100% locally in your browser with custom scale factors."
  badge="Image Studio"
  faqItems={faqItems}
>
  <div class="space-y-6">
    <!-- Controls Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 p-4 bg-slate-950 border border-slate-800 rounded-lg text-xs font-semibold text-slate-300">
      <div class="flex items-center gap-4">
        <div>
          <label for="svg-scale" class="mr-2">Scale Factor:</label>
          <select id="svg-scale" class="bg-slate-900 border border-slate-700 rounded px-2.5 py-1.5 text-slate-200">
            <option value="1">1x (Original Size)</option>
            <option value="2" selected>2x (High-DPI / Retina)</option>
            <option value="4">4x (Ultra-HD / 4K)</option>
          </select>
        </div>

        <div class="flex items-center space-x-2">
          <input type="checkbox" id="chk-svg-bg" class="rounded border-slate-700 text-brand-500 bg-slate-900" />
          <label for="chk-svg-bg">White Background (No Alpha)</label>
        </div>
      </div>

      <button type="button" id="btn-download-svg-png" class="px-5 py-2 bg-brand-600 hover:bg-brand-500 text-white font-bold rounded-lg text-xs transition disabled:opacity-50" disabled>
        Download PNG Image
      </button>
    </div>

    <!-- Drop Zone -->
    <div
      id="svg-dropzone"
      class="border-2 border-dashed border-slate-700 hover:border-brand-500 rounded-xl p-8 text-center bg-slate-950/50 cursor-pointer transition"
    >
      <div class="space-y-3">
        <span class="text-4xl block">🎨</span>
        <p class="text-base font-semibold text-slate-200">Drag &amp; Drop an SVG file here</p>
        <p class="text-xs text-slate-400">or paste raw SVG code below to rasterize to PNG</p>
        <input type="file" id="svg-file-input" accept=".svg,image/svg+xml" class="hidden" />
      </div>
    </div>

    <!-- Raw SVG Code Input -->
    <div class="space-y-2">
      <label for="svg-code-area" class="text-xs font-bold uppercase tracking-wider text-slate-300">Raw SVG Code (Optional)</label>
      <textarea
        id="svg-code-area"
        rows="6"
        class="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 text-xs font-mono text-slate-200 focus:outline-none focus:border-brand-500"
        placeholder="<svg xmlns='http://www.w3.org/2000/svg' ...>...</svg>"
      ></textarea>
    </div>

    <!-- Preview Canvas Box -->
    <div id="svg-preview-container" class="hidden space-y-3 p-4 bg-slate-950 border border-slate-800 rounded-xl">
      <span id="svg-res-info" class="font-mono text-xs text-slate-400 block">Output Resolution: 0 x 0 px</span>
      <div class="flex justify-center bg-slate-900 p-4 rounded-lg overflow-auto max-h-[400px]">
        <canvas id="svg-canvas" class="max-w-full h-auto border border-slate-800 rounded shadow-md"></canvas>
      </div>
    </div>
  </div>

  <div slot="guide">
    <h2 class="text-2xl font-bold text-slate-100 mb-4">Rasterizing SVG Vectors into Crisp PNG Images</h2>
    <p class="text-slate-300 leading-relaxed mb-4">
      Scalable Vector Graphics (SVG) use mathematical formulas to define lines, curves, and shapes, ensuring infinite scalability without pixelation. However, many email clients, word processors, social platforms, and legacy graphic workflows require traditional raster PNG or JPEG graphics.
    </p>

    <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">High-Resolution Canvas Rasterization</h3>
    <p class="text-slate-300 leading-relaxed mb-4">
      FreeFileTool rasterizes SVG vector documents using your browser's native HTML5 Canvas 2D engine. By increasing the target scale factor (2x or 4x), you can generate ultra-crisp PNG images for high-density mobile screens and print layouts without vector distortion.
    </p>

    <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Data Privacy Guarantee</h3>
    <p class="text-slate-300 leading-relaxed mb-4">
      Your proprietary SVG logos, icon sets, and diagrams are processed locally in your browser memory space. Your files are processed on your device and are never uploaded.
    </p>
  </div>
</ToolPageTemplate>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    let currentSvgStr = '';

    const dropzone = document.getElementById('svg-dropzone');
    const fileInput = document.getElementById('svg-file-input') as HTMLInputElement;
    const codeArea = document.getElementById('svg-code-area') as HTMLTextAreaElement;
    const scaleSelect = document.getElementById('svg-scale') as HTMLSelectElement;
    const bgChk = document.getElementById('chk-svg-bg') as HTMLInputElement;
    const previewContainer = document.getElementById('svg-preview-container') as HTMLElement;
    const resInfo = document.getElementById('svg-res-info') as HTMLElement;
    const canvas = document.getElementById('svg-canvas') as HTMLCanvasElement;
    const btnDownload = document.getElementById('btn-download-svg-png') as HTMLButtonElement;

    dropzone?.addEventListener('click', () => fileInput?.click());

    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-brand-500', 'bg-brand-500/10');
    });

    dropzone?.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-brand-500', 'bg-brand-500/10');
    });

    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-brand-500', 'bg-brand-500/10');
      if (e.dataTransfer?.files?.length) {
        loadSvgFile(e.dataTransfer.files[0]);
      }
    });

    fileInput?.addEventListener('change', () => {
      if (fileInput.files?.length) {
        loadSvgFile(fileInput.files[0]);
      }
    });

    codeArea?.addEventListener('input', () => {
      currentSvgStr = codeArea.value.trim();
      renderSvg();
    });

    scaleSelect?.addEventListener('change', renderSvg);
    bgChk?.addEventListener('change', renderSvg);

    function loadSvgFile(file: File) {
      const reader = new FileReader();
      reader.onload = (e) => {
        currentSvgStr = e.target?.result as string;
        if (codeArea) codeArea.value = currentSvgStr;
        renderSvg();
      };
      reader.readAsText(file);
    }

    function renderSvg() {
      if (!currentSvgStr || !canvas) {
        if (previewContainer) previewContainer.classList.add('hidden');
        if (btnDownload) btnDownload.disabled = true;
        return;
      }

      const scale = parseFloat(scaleSelect?.value || '2');
      const addWhiteBg = bgChk?.checked;

      const blob = new Blob([currentSvgStr], { type: 'image/svg+xml;charset=utf-8' });
      const url = URL.createObjectURL(blob);

      const img = new Image();
      img.onload = () => {
        let width = img.width || 300;
        let height = img.height || 300;

        const targetW = Math.round(width * scale);
        const targetH = Math.round(height * scale);

        canvas.width = targetW;
        canvas.height = targetH;

        const ctx = canvas.getContext('2d');
        if (ctx) {
          ctx.clearRect(0, 0, targetW, targetH);
          if (addWhiteBg) {
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, targetW, targetH);
          }
          ctx.drawImage(img, 0, 0, targetW, targetH);
        }

        URL.revokeObjectURL(url);

        if (resInfo) resInfo.textContent = `Output Resolution: ${targetW} x ${targetH} px (${scale}x Scale)`;
        if (previewContainer) previewContainer.classList.remove('hidden');
        if (btnDownload) btnDownload.disabled = false;
      };
      img.src = url;
    }

    btnDownload?.addEventListener('click', () => {
      if (!canvas) return;
      const dataUrl = canvas.toDataURL('image/png');
      const a = document.createElement('a');
      a.href = dataUrl;
      a.download = 'converted-vector.png';
      a.click();
    });
  });
</script>
