---
import BaseLayout from '../layouts/BaseLayout.astro';

if (typeof Astro !== 'undefined' && Astro.response) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}
---
<BaseLayout title="404 - Page Not Found | FreeFileTool" description="Page not found.">
  <section class="flex flex-col items-center justify-center min-h-[60vh] text-center p-8">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">404 – Page Not Found</h1>
    <p class="text-lg mb-6 text-gray-400">Sorry, we couldn’t find the page you were looking for.</p>
    <div class="flex gap-4">
      <a href="/" class="btn btn--secondary">Home</a>
      <a href="/" class="btn btn--ghost">Browse Tools</a>
    </div>
  </section>
</BaseLayout>
