---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrivacyBadge from '../components/PrivacyBadge.astro';
import RelatedTools from '../components/RelatedTools.astro';

const title = "Text to PDF Converter — Convert Plain Text & Markdown to PDF Online | FreeFileTool";
const description = "Convert plain text and Markdown text into a clean PDF document 100% locally in your browser with custom page sizes, margins, and font settings.";
const canonicalURL = "https://freefiletool.app/text-to-pdf";

const faqItems = [
  {
    question: "Is my text saved or uploaded to any server?",
    answer: "No. Text formatting and PDF generation run entirely in your local browser memory using pdf-lib. Your text content is never sent over any network."
  },
  {
    question: "Can I choose between A4 and US Letter page sizes?",
    answer: "Yes, you can toggle between standard A4 and US Letter page dimensions before generating your PDF."
  },
  {
    question: "How does line wrapping work?",
    answer: "The client engine automatically wraps long sentences based on your chosen margin width and creates multi-page PDF documents for longer articles."
  }
];
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "name": "FreeFileTool Text to PDF Converter",
        "url": canonicalURL,
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "All",
        "browserRequirements": "Requires JavaScript",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": { "@type": "Answer", "text": item.answer }
        }))
      }
    ]
  })} />

  <div class="tool-page-container max-w-6xl mx-auto px-4 py-8">
    <header class="tool-hero text-center mb-8">
      <div class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-400 border border-brand-500/20 mb-3">
        Text & PDF Tools
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-100 mb-3">Text to PDF Converter</h1>
      <p class="text-slate-400 max-w-2xl mx-auto text-base sm:text-lg mb-4">
        Type or paste plain text or Markdown to instantly generate a formatted, downloadable PDF document.
      </p>
      <div class="flex justify-center">
        <PrivacyBadge variant="badge" tech="pdf-lib" />
      </div>
    </header>

    <main class="tool-workspace my-8 bg-slate-900/60 border border-slate-800 rounded-xl p-4 sm:p-6 shadow-xl space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-slate-800/80 border border-slate-700 rounded-xl p-4">
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Page Size</label>
          <select id="pagesize-select" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm text-slate-200">
            <option value="a4" selected>A4 (210 x 297 mm)</option>
            <option value="letter">US Letter (8.5 x 11 in)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Font Size (pt)</label>
          <input type="number" id="fontsize-input" value="12" min="8" max="24" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm text-slate-200" />
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Margin (pt)</label>
          <input type="number" id="margin-input" value="40" min="20" max="72" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm text-slate-200" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-slate-300 mb-2">Enter or Paste Text Content</label>
        <textarea id="text-input" rows="12" placeholder="Paste your text or notes here to convert into a clean PDF document..." class="w-full bg-slate-950 border border-slate-800 rounded-lg p-4 text-sm text-slate-200 leading-relaxed focus:outline-none focus:ring-1 focus:ring-brand-500"></textarea>
      </div>

      <div id="status-msg" class="hidden my-4 p-4 rounded-lg text-sm text-center"></div>

      <button id="generate-btn" class="w-full sm:w-auto px-8 py-3 bg-brand-600 hover:bg-brand-500 text-white font-bold rounded-lg text-sm transition-colors shadow-lg">
        Generate & Download PDF
      </button>
    </main>

    <section class="tool-guide-content prose prose-invert max-w-none my-12 bg-slate-900/40 border border-slate-800/80 rounded-xl p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">How to Convert Plain Text to PDF</h2>
      <p class="text-slate-300">
        Converting raw notes, code snippets, or draft writing into a PDF makes it easy to print, share, or store formatted documents across devices. FreeFileTool performs 100% client-side text wrapping and page creation using pdf-lib.
      </p>

      <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Simple Instructions</h3>
      <ol class="list-decimal pl-5 space-y-2 text-slate-300">
        <li><strong>Paste Text:</strong> Enter your plain text or Markdown into the editor box.</li>
        <li><strong>Adjust Formatting:</strong> Choose page size (A4 or US Letter), font size, and margins.</li>
        <li><strong>Generate PDF:</strong> Click "Generate & Download PDF" to export the compiled document instantly.</li>
      </ol>

      <div class="tool-faq-block mt-10 pt-8 border-t border-slate-800">
        <h2 class="text-2xl font-bold text-slate-100 mb-6">Frequently Asked Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {faqItems.map(item => (
            <div class="faq-item-card bg-slate-800/50 border border-slate-700/50 rounded-lg p-5">
              <h3 class="text-lg font-semibold text-slate-200 mb-2">{item.question}</h3>
              <p class="text-slate-400 text-sm leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <RelatedTools currentSlug="text-to-pdf" limit={4} />
  </div>
</BaseLayout>

<script>
  import { convertTextToPdf } from '../lib/pdf/pdfEngine.js';

  const textInput = document.getElementById('text-input') as HTMLTextAreaElement;
  const pagesizeSelect = document.getElementById('pagesize-select') as HTMLSelectElement;
  const fontsizeInput = document.getElementById('fontsize-input') as HTMLInputElement;
  const marginInput = document.getElementById('margin-input') as HTMLInputElement;
  const statusMsg = document.getElementById('status-msg')!;
  const generateBtn = document.getElementById('generate-btn')!;

  function showStatus(msg: string, type: 'info' | 'error' | 'success') {
    statusMsg.classList.remove('hidden', 'bg-blue-950', 'text-blue-300', 'bg-red-950', 'text-red-300', 'bg-emerald-950', 'text-emerald-300');
    if (type === 'error') {
      statusMsg.classList.add('bg-red-950', 'text-red-300', 'border', 'border-red-800');
    } else if (type === 'success') {
      statusMsg.classList.add('bg-emerald-950', 'text-emerald-300', 'border', 'border-emerald-800');
    } else {
      statusMsg.classList.add('bg-blue-950', 'text-blue-300', 'border', 'border-blue-800');
    }
    statusMsg.textContent = msg;
  }

  generateBtn.addEventListener('click', async () => {
    const content = textInput.value.trim();
    if (!content) {
      showStatus('Please enter or paste text content first.', 'error');
      return;
    }

    showStatus('Generating PDF document in browser memory...', 'info');

    try {
      const res = await convertTextToPdf(content, {
        pageSize: pagesizeSelect.value,
        fontSize: parseInt(fontsizeInput.value || '12', 10),
        margin: parseInt(marginInput.value || '40', 10),
      });

      const a = document.createElement('a');
      a.href = res.url;
      a.download = res.filename;
      a.click();

      showStatus(`PDF generated successfully (${res.pageCount} pages, ${res.formattedSize}).`, 'success');
    } catch (err: any) {
      showStatus(err.message || 'Failed to generate PDF.', 'error');
    }
  });
</script>
