---
import ToolPageTemplate from '../components/ToolPageTemplate.astro';

const faqItems = [
  {
    question: "What is a Unix timestamp?",
    answer: "A Unix timestamp (also known as Epoch time or POSIX time) is the total number of seconds that have elapsed since 00:00:00 Coordinated Universal Time (UTC), Thursday, 1 January 1970, excluding leap seconds."
  },
  {
    question: "How do I know if a timestamp is in seconds or milliseconds?",
    answer: "Timestamps in seconds currently have 10 digits (e.g. 1700000000), whereas timestamps in milliseconds have 13 digits (e.g. 1700000000000). Our tool automatically detects 13-digit millisecond inputs."
  },
  {
    question: "What is the Year 2038 problem (Y2K38)?",
    answer: "On January 19, 2038, 32-bit signed integers will overflow beyond 2,147,483,647 seconds. Modern 64-bit systems and JavaScript's 64-bit numbers completely resolve this limit."
  },
  {
    question: "Are timezone offsets included in Unix timestamps?",
    answer: "No. Unix timestamps are strictly based on UTC (Coordinated Universal Time) regardless of your geographical location or daylight saving time adjustments."
  }
];
---

<ToolPageTemplate
  toolSlug="unix-timestamp-converter"
  toolName="Unix Timestamp Converter"
  title="Unix Timestamp Converter — Epoch to Human Date Free"
  description="Convert Unix epoch timestamps (seconds & milliseconds) to UTC and local human-readable date strings, and convert dates back to Unix epoch."
  faqItems={faqItems}
>
  <div class="space-y-6">
    <!-- Live Epoch Banner -->
    <div class="p-4 bg-slate-950 border border-slate-800 rounded-lg flex flex-wrap items-center justify-between gap-4">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-brand-400 block">Current Unix Epoch Timestamp</span>
        <span id="live-epoch-val" class="font-mono text-2xl font-bold text-slate-100">---</span>
        <span class="text-xs text-slate-400 ml-2">seconds</span>
      </div>
      <button type="button" id="btn-toggle-live" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300 rounded transition">
        Pause Counter
      </button>
    </div>

    <!-- Converter Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Card 1: Timestamp -> Human Date -->
      <div class="p-4 bg-slate-950 border border-slate-800 rounded-lg space-y-4">
        <h3 class="text-sm font-bold text-slate-200 border-b border-slate-800 pb-2">Unix Timestamp &rarr; Human Readable Date</h3>
        <div>
          <label for="input-ts" class="block text-xs font-semibold text-slate-400 mb-1">Enter Timestamp (Seconds or Milliseconds)</label>
          <input
            type="number"
            id="input-ts"
            placeholder="e.g. 1700000000"
            class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm text-slate-100 font-mono focus:outline-none focus:border-brand-500"
          />
        </div>
        <div class="space-y-2 text-sm">
          <div>
            <span class="text-xs text-slate-400 block">GMT / UTC Time:</span>
            <span id="out-utc" class="font-mono text-emerald-400 font-semibold">---</span>
          </div>
          <div>
            <span class="text-xs text-slate-400 block">Your Local Time:</span>
            <span id="out-local" class="font-mono text-cyan-400 font-semibold">---</span>
          </div>
          <div>
            <span class="text-xs text-slate-400 block">Relative Time:</span>
            <span id="out-relative" class="font-mono text-purple-300">---</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Human Date -> Timestamp -->
      <div class="p-4 bg-slate-950 border border-slate-800 rounded-lg space-y-4">
        <h3 class="text-sm font-bold text-slate-200 border-b border-slate-800 pb-2">Human Date &rarr; Unix Timestamp</h3>
        <div>
          <label for="input-date" class="block text-xs font-semibold text-slate-400 mb-1">Select Date and Time</label>
          <input
            type="datetime-local"
            id="input-date"
            class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm text-slate-100 font-mono focus:outline-none focus:border-brand-500"
          />
        </div>
        <div class="space-y-2 text-sm">
          <div>
            <span class="text-xs text-slate-400 block">Unix Timestamp (Seconds):</span>
            <span id="out-ts-sec" class="font-mono text-emerald-400 font-bold text-lg">---</span>
          </div>
          <div>
            <span class="text-xs text-slate-400 block">Unix Timestamp (Milliseconds):</span>
            <span id="out-ts-ms" class="font-mono text-cyan-400 font-semibold">---</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div slot="guide">
    <h2 class="text-2xl font-bold text-slate-100 mb-4">Understanding Unix Epoch Time</h2>
    <p class="text-slate-300 leading-relaxed mb-4">
      Unix time (also known as Epoch time or POSIX time) is a system for describing a point in time. It is defined as the number of seconds that have elapsed since 00:00:00 Coordinated Universal Time (UTC), Thursday, 1 January 1970, minus leap seconds. Epoch time is used extensively in operating systems, databases, logging frameworks, and network protocols.
    </p>

    <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Seconds vs. Milliseconds</h3>
    <p class="text-slate-300 leading-relaxed mb-4">
      Traditional Unix timestamps in C, Python, and SQL databases measure elapsed time in <strong>seconds</strong> (10-digit integers). However, modern JavaScript (<code>Date.now()</code>), Java (<code>System.currentTimeMillis()</code>), and high-precision APIs use <strong>milliseconds</strong> (13-digit integers). FreeFileTool automatically detects 13-digit inputs and normalizes them for accurate conversion.
    </p>

    <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">The Year 2038 Problem (Y2K38)</h3>
    <p class="text-slate-300 leading-relaxed mb-4">
      The Year 2038 problem affects programs that store Unix timestamps as 32-bit signed integers. At 03:14:07 UTC on 19 January 2038, the integer value reaches its maximum limit of <code>2,147,483,647</code>. The next second overflows into negative numbers (<code>-2,147,483,648</code>), causing affected software to interpret the date as 13 December 1901. Modern 64-bit systems extend the limit by over 290 billion years.
    </p>

    <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Timezone Independence</h3>
    <p class="text-slate-300 leading-relaxed mb-4">
      A Unix timestamp is identical regardless of where you are located on Earth. <code>1700000000</code> represents the exact same absolute instant whether accessed from Tokyo, London, or San Francisco. The local human date display simply formats that universal instant according to your web browser's active timezone settings.
    </p>
  </div>
</ToolPageTemplate>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const liveVal = document.getElementById('live-epoch-val') as HTMLElement;
    const btnToggle = document.getElementById('btn-toggle-live');
    const inputTs = document.getElementById('input-ts') as HTMLInputElement;
    const outUtc = document.getElementById('out-utc') as HTMLElement;
    const outLocal = document.getElementById('out-local') as HTMLElement;
    const outRelative = document.getElementById('out-relative') as HTMLElement;
    const inputDate = document.getElementById('input-date') as HTMLInputElement;
    const outTsSec = document.getElementById('out-ts-sec') as HTMLElement;
    const outTsMs = document.getElementById('out-ts-ms') as HTMLElement;

    let isLive = true;
    let timerId: any = null;

    function updateLiveCounter() {
      if (liveVal && isLive) {
        liveVal.textContent = Math.floor(Date.now() / 1000).toString();
      }
    }

    timerId = setInterval(updateLiveCounter, 1000);
    updateLiveCounter();

    btnToggle?.addEventListener('click', () => {
      isLive = !isLive;
      if (btnToggle) {
        btnToggle.textContent = isLive ? 'Pause Counter' : 'Resume Counter';
      }
    });

    function convertTimestamp() {
      const raw = (inputTs?.value || '').trim();
      if (!raw) {
        outUtc.textContent = '---';
        outLocal.textContent = '---';
        outRelative.textContent = '---';
        return;
      }

      let num = Number(raw);
      if (isNaN(num)) {
        outUtc.textContent = 'Invalid Number';
        outLocal.textContent = 'Invalid Number';
        outRelative.textContent = '---';
        return;
      }

      // Check if millisecond (13 digits)
      if (raw.length >= 13) {
        num = Math.floor(num / 1000);
      }

      const d = new Date(num * 1000);
      if (isNaN(d.getTime())) {
        outUtc.textContent = 'Invalid Date';
        outLocal.textContent = 'Invalid Date';
        outRelative.textContent = '---';
        return;
      }

      outUtc.textContent = d.toUTCString();
      outLocal.textContent = d.toLocaleString();

      const diffSec = Math.floor(Date.now() / 1000) - num;
      if (Math.abs(diffSec) < 60) {
        outRelative.textContent = 'Just now';
      } else if (diffSec > 0) {
        const mins = Math.floor(diffSec / 60);
        const hours = Math.floor(mins / 60);
        const days = Math.floor(hours / 24);
        outRelative.textContent = days > 0 ? `${days} days ago` : hours > 0 ? `${hours} hours ago` : `${mins} mins ago`;
      } else {
        const mins = Math.floor(Math.abs(diffSec) / 60);
        const hours = Math.floor(mins / 60);
        const days = Math.floor(hours / 24);
        outRelative.textContent = days > 0 ? `In ${days} days` : hours > 0 ? `In ${hours} hours` : `In ${mins} mins`;
      }
    }

    inputTs?.addEventListener('input', convertTimestamp);

    function convertDateToTs() {
      const val = inputDate?.value;
      if (!val) {
        outTsSec.textContent = '---';
        outTsMs.textContent = '---';
        return;
      }

      const d = new Date(val);
      if (isNaN(d.getTime())) {
        outTsSec.textContent = 'Invalid Date';
        outTsMs.textContent = 'Invalid Date';
        return;
      }

      const ms = d.getTime();
      outTsSec.textContent = Math.floor(ms / 1000).toString();
      outTsMs.textContent = ms.toString();
    }

    inputDate?.addEventListener('input', convertDateToTs);

    // Initial default input date
    if (inputDate) {
      const nowIso = new Date().toISOString().slice(0, 16);
      inputDate.value = nowIso;
      convertDateToTs();
    }
  });
</script>
