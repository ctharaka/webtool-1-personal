---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivacyBadge from '../../components/PrivacyBadge.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const title = "Delete PDF Pages Online Free — Remove Unwanted Pages from PDF | FreeFileTool";
const description = "Delete unwanted pages from PDF files online for free. Remove blank pages, cover sheets, or sensitive information 100% locally with zero server uploads.";
const canonicalURL = "https://freefiletool.app/pdf/delete-pages/";

const faqItems = [
  {
    question: "How do I remove specific pages from a PDF?",
    answer: "Upload your document. Our tool generates page thumbnails locally. Click the trash icon or select pages to delete, then click 'Download Updated PDF'."
  },
  {
    question: "Is my original PDF file affected or uploaded anywhere?",
    answer: "No. Your original file remains untouched on your computer. All processing happens in local browser RAM, so your PDF is never sent over the internet."
  },
  {
    question: "Can I delete multiple pages at once?",
    answer: "Yes. You can select and remove as many pages as you want, provided at least one page remains in the final document."
  }
];
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "name": "FreeFileTool Delete PDF Pages",
        "url": canonicalURL,
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "All",
        "browserRequirements": "Requires JavaScript",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": { "@type": "Answer", "text": item.answer }
        }))
      }
    ]
  })} />

  <div class="tool-page-container max-w-6xl mx-auto px-4 py-8">
    <header class="tool-hero text-center mb-8">
      <div class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-400 border border-brand-500/20 mb-3">
        PDF Studio
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-100 mb-3">Delete PDF Pages</h1>
      <p class="text-slate-400 max-w-2xl mx-auto text-base sm:text-lg mb-4">
        Remove blank pages, extra cover sheets, or sensitive information from your PDF documents 100% locally in your browser.
      </p>
      <div class="flex justify-center">
        <PrivacyBadge variant="badge" tech="pdf-lib & pdf.js" />
      </div>
    </header>

    <main class="tool-workspace my-8 bg-slate-900/60 border border-slate-800 rounded-xl p-4 sm:p-6 shadow-xl">
      <div id="drop-zone" class="border-2 border-dashed border-slate-700 hover:border-brand-500 rounded-xl p-8 text-center cursor-pointer transition-colors">
        <input type="file" id="pdf-input" accept=".pdf,application/pdf" class="hidden" />
        <div class="text-4xl mb-3">🗑️</div>
        <p class="text-slate-200 font-semibold mb-1">Click to browse or drop your PDF here</p>
        <p class="text-slate-400 text-sm">Supports PDF files up to 50 MB · Processed locally</p>
      </div>

      <div id="status-msg" class="hidden my-4 p-4 rounded-lg text-sm text-center"></div>

      <div id="editor-section" class="hidden mt-6">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-4 pb-4 border-b border-slate-800">
          <div>
            <h2 class="text-lg font-bold text-slate-100">Select Pages to Keep / Remove (<span id="page-count">0</span> pages)</h2>
            <p class="text-xs text-slate-400">Click page thumbnails or trash buttons to delete unwanted pages.</p>
          </div>
          <div class="flex gap-2">
            <button id="reset-btn" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded text-xs font-medium transition-colors">Reset All Pages</button>
            <button id="export-btn" class="px-4 py-1.5 bg-brand-600 hover:bg-brand-500 text-white rounded text-sm font-semibold transition-colors">Download Updated PDF</button>
          </div>
        </div>

        <div id="page-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 max-h-[600px] overflow-y-auto p-2"></div>
      </div>
    </main>

    <section class="tool-guide-content prose prose-invert max-w-none my-12 bg-slate-900/40 border border-slate-800/80 rounded-xl p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">How to Remove Pages from a PDF Document</h2>
      <p class="text-slate-300">
        Extraneous pages such as blank sheets, duplicate forms, or confidential attachments often need to be deleted prior to emailing or submitting official documents. FreeFileTool provides a quick, visual page deletion tool that operates entirely on your client machine.
      </p>

      <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Step-by-Step Guide</h3>
      <ol class="list-decimal pl-5 space-y-2 text-slate-300">
        <li><strong>Upload PDF:</strong> Open your PDF file in the editor workspace.</li>
        <li><strong>Identify Pages:</strong> Review the page thumbnails rendered in real time.</li>
        <li><strong>Delete Pages:</strong> Click the red trash button on any unwanted page to remove it from the output document.</li>
        <li><strong>Download:</strong> Click "Download Updated PDF" to save the trimmed PDF document immediately.</li>
      </ol>

      <div class="tool-faq-block mt-10 pt-8 border-t border-slate-800">
        <h2 class="text-2xl font-bold text-slate-100 mb-6">Frequently Asked Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {faqItems.map(item => (
            <div class="faq-item-card bg-slate-800/50 border border-slate-700/50 rounded-lg p-5">
              <h3 class="text-lg font-semibold text-slate-200 mb-2">{item.question}</h3>
              <p class="text-slate-400 text-sm leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <RelatedTools currentSlug="pdf/organize" limit={4} />
  </div>
</BaseLayout>

<script>
  import { renderPdfThumbnails, organizePdfFile } from '../../lib/pdf/pdfEngine.js';

  let currentFile: File | null = null;
  let pageList: Array<{ originalIndex: number; rotation: number; dataUrl: string }> = [];

  const dropZone = document.getElementById('drop-zone')!;
  const pdfInput = document.getElementById('pdf-input') as HTMLInputElement;
  const statusMsg = document.getElementById('status-msg')!;
  const editorSection = document.getElementById('editor-section')!;
  const pageGrid = document.getElementById('page-grid')!;
  const pageCountSpan = document.getElementById('page-count')!;
  const exportBtn = document.getElementById('export-btn')!;
  const resetBtn = document.getElementById('reset-btn')!;

  function showStatus(msg: string, type: 'info' | 'error' | 'success') {
    statusMsg.classList.remove('hidden', 'bg-blue-950', 'text-blue-300', 'bg-red-950', 'text-red-300', 'bg-emerald-950', 'text-emerald-300');
    if (type === 'error') {
      statusMsg.classList.add('bg-red-950', 'text-red-300', 'border', 'border-red-800');
    } else if (type === 'success') {
      statusMsg.classList.add('bg-emerald-950', 'text-emerald-300', 'border', 'border-emerald-800');
    } else {
      statusMsg.classList.add('bg-blue-950', 'text-blue-300', 'border', 'border-blue-800');
    }
    statusMsg.textContent = msg;
  }

  dropZone.addEventListener('click', () => pdfInput.click());
  dropZone.addEventListener('dragover', (e) => e.preventDefault());
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer?.files.length) {
      handleFile(e.dataTransfer.files[0]);
    }
  });

  pdfInput.addEventListener('change', () => {
    if (pdfInput.files?.length) {
      handleFile(pdfInput.files[0]);
    }
  });

  async function handleFile(file: File) {
    if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
      showStatus('Please select a valid PDF file.', 'error');
      return;
    }

    currentFile = file;
    showStatus('Rendering page thumbnails in memory...', 'info');

    try {
      const thumbs = await renderPdfThumbnails(file, 0.35, (curr, total) => {
        showStatus(`Rendering thumbnail for page ${curr} of ${total}...`, 'info');
      });

      pageList = thumbs.map((t, idx) => ({
        originalIndex: idx,
        rotation: 0,
        dataUrl: t.dataUrl,
      }));

      renderPageGrid();
      editorSection.classList.remove('hidden');
      statusMsg.classList.add('hidden');
    } catch (err: any) {
      showStatus(err.message || 'Failed to parse PDF file. It may be corrupt or encrypted.', 'error');
    }
  }

  function renderPageGrid() {
    pageGrid.innerHTML = '';
    pageCountSpan.textContent = String(pageList.length);

    pageList.forEach((item, index) => {
      const card = document.createElement('div');
      card.className = 'bg-slate-800 border border-slate-700 rounded-lg p-2 flex flex-col items-center relative group';
      
      const imgWrap = document.createElement('div');
      imgWrap.className = 'w-full h-40 flex items-center justify-center bg-slate-950 rounded overflow-hidden mb-2';
      
      const img = document.createElement('img');
      img.src = item.dataUrl;
      img.className = 'max-h-full max-w-full object-contain';
      imgWrap.appendChild(img);

      const label = document.createElement('span');
      label.className = 'text-xs text-slate-300 font-medium mb-1';
      label.textContent = `Page ${index + 1} (Orig: #${item.originalIndex + 1})`;

      const delBtn = document.createElement('button');
      delBtn.className = 'w-full py-1 bg-red-900/80 hover:bg-red-800 text-red-100 rounded text-xs font-semibold transition-colors mt-1';
      delBtn.textContent = '🗑️ Delete Page';
      delBtn.onclick = () => deletePage(index);

      card.appendChild(imgWrap);
      card.appendChild(label);
      card.appendChild(delBtn);
      pageGrid.appendChild(card);
    });
  }

  function deletePage(index: number) {
    if (pageList.length <= 1) {
      alert('The PDF must retain at least one page.');
      return;
    }
    pageList.splice(index, 1);
    renderPageGrid();
  }

  resetBtn.addEventListener('click', () => {
    if (currentFile) handleFile(currentFile);
  });

  exportBtn.addEventListener('click', async () => {
    if (!currentFile || !pageList.length) return;
    showStatus('Exporting updated PDF in browser memory...', 'info');

    try {
      const res = await organizePdfFile(currentFile, pageList.map(p => ({ originalIndex: p.originalIndex, rotation: p.rotation })));
      const a = document.createElement('a');
      a.href = res.url;
      a.download = currentFile.name.replace(/\.pdf$/i, '-trimmed.pdf');
      a.click();
      showStatus(`Successfully saved updated PDF (${res.formattedSize}, ${res.pageCount} pages).`, 'success');
    } catch (err: any) {
      showStatus(err.message || 'Failed to export PDF.', 'error');
    }
  });
</script>
