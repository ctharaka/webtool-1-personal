---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivacyBadge from '../../components/PrivacyBadge.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const title = "Add Watermark to PDF Online — Free & Custom Text Watermarking | FreeFileTool";
const description = "Add text watermarks to PDF documents 100% locally in your browser. Customize watermark text, opacity, font size, and rotation angle with zero file uploads.";
const canonicalURL = "https://freefiletool.app/pdf/watermark";

const faqItems = [
  {
    question: "Does adding a watermark upload my PDF to a server?",
    answer: "No. All text overlay rendering and document modification take place inside your browser memory using pdf-lib. Your files never leave your device."
  },
  {
    question: "Can I adjust watermark transparency and angle?",
    answer: "Yes! You can set custom opacity (from subtle 10% to full 100%), font size, and rotation angle (e.g. 45° diagonal or horizontal)."
  },
  {
    question: "Will watermarking alter the existing PDF text or formatting?",
    answer: "No, the watermark text layer is stamped on top of existing pages without modifying underlying vector graphics or text content."
  }
];
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "name": "FreeFileTool PDF Watermark Generator",
        "url": canonicalURL,
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "All",
        "browserRequirements": "Requires JavaScript",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": { "@type": "Answer", "text": item.answer }
        }))
      }
    ]
  })} />

  <div class="tool-page-container max-w-6xl mx-auto px-4 py-8">
    <header class="tool-hero text-center mb-8">
      <div class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-400 border border-brand-500/20 mb-3">
        PDF Utilities
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-100 mb-3">Add Watermark to PDF</h1>
      <p class="text-slate-400 max-w-2xl mx-auto text-base sm:text-lg mb-4">
        Protect confidential documents or stamp status markers (e.g. "CONFIDENTIAL", "DRAFT", "SAMPLE") onto your PDF pages.
      </p>
      <div class="flex justify-center">
        <PrivacyBadge variant="badge" tech="pdf-lib" />
      </div>
    </header>

    <main class="tool-workspace my-8 bg-slate-900/60 border border-slate-800 rounded-xl p-4 sm:p-6 shadow-xl">
      <div id="drop-zone" class="border-2 border-dashed border-slate-700 hover:border-brand-500 rounded-xl p-8 text-center cursor-pointer transition-colors">
        <input type="file" id="pdf-input" accept=".pdf,application/pdf" class="hidden" />
        <div class="text-4xl mb-3">💧</div>
        <p class="text-slate-200 font-semibold mb-1">Click to browse or drop your PDF here</p>
        <p class="text-slate-400 text-sm">Select any PDF file · 100% in-browser processing</p>
      </div>

      <div id="status-msg" class="hidden my-4 p-4 rounded-lg text-sm text-center"></div>

      <div id="options-workspace" class="hidden mt-6 bg-slate-800/80 border border-slate-700 rounded-xl p-6">
        <h2 class="text-lg font-bold text-slate-100 mb-4">Watermark Options</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-slate-300 mb-1">Watermark Text</label>
            <input type="text" id="text-input" value="CONFIDENTIAL" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm text-slate-200" />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Opacity (<span id="opacity-val">0.3</span>)</label>
            <input type="range" id="opacity-input" min="0.1" max="1.0" step="0.05" value="0.3" class="w-full" />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Font Size (pt)</label>
            <input type="number" id="fontsize-input" value="48" min="16" max="120" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm text-slate-200" />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Rotation Angle (°)</label>
            <input type="number" id="rotation-input" value="45" min="0" max="360" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm text-slate-200" />
          </div>
        </div>

        <button id="apply-btn" class="w-full sm:w-auto px-6 py-2.5 bg-brand-600 hover:bg-brand-500 text-white font-bold rounded-lg text-sm transition-colors shadow-lg">
          Add Watermark & Download PDF
        </button>
      </div>
    </main>

    <section class="tool-guide-content prose prose-invert max-w-none my-12 bg-slate-900/40 border border-slate-800/80 rounded-xl p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">How to Watermark PDF Documents Online</h2>
      <p class="text-slate-300">
        Watermarking PDF files is essential for protecting intellectual property, marking preliminary drafts, or preventing unauthorized distribution of internal documents. FreeFileTool provides client-side watermarking that runs completely in your local browser without requiring file uploads.
      </p>

      <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Step-by-Step Instructions</h3>
      <ol class="list-decimal pl-5 space-y-2 text-slate-300">
        <li><strong>Select your document:</strong> Drop or select your PDF file.</li>
        <li><strong>Customize watermark:</strong> Enter custom text (e.g. "DRAFT", "DO NOT COPY"), opacity, size, and rotation angle.</li>
        <li><strong>Generate & Download:</strong> Click "Add Watermark & Download PDF" to save the stamped PDF to your computer.</li>
      </ol>

      <div class="tool-faq-block mt-10 pt-8 border-t border-slate-800">
        <h2 class="text-2xl font-bold text-slate-100 mb-6">Frequently Asked Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {faqItems.map(item => (
            <div class="faq-item-card bg-slate-800/50 border border-slate-700/50 rounded-lg p-5">
              <h3 class="text-lg font-semibold text-slate-200 mb-2">{item.question}</h3>
              <p class="text-slate-400 text-sm leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <RelatedTools currentSlug="pdf/watermark" limit={4} />
  </div>
</BaseLayout>

<script>
  import { addWatermarkToPdf } from '../../lib/pdf/pdfEngine.js';

  let currentFile: File | null = null;
  const dropZone = document.getElementById('drop-zone')!;
  const pdfInput = document.getElementById('pdf-input') as HTMLInputElement;
  const statusMsg = document.getElementById('status-msg')!;
  const optionsWorkspace = document.getElementById('options-workspace')!;
  const textInput = document.getElementById('text-input') as HTMLInputElement;
  const opacityInput = document.getElementById('opacity-input') as HTMLInputElement;
  const opacityVal = document.getElementById('opacity-val')!;
  const fontsizeInput = document.getElementById('fontsize-input') as HTMLInputElement;
  const rotationInput = document.getElementById('rotation-input') as HTMLInputElement;
  const applyBtn = document.getElementById('apply-btn')!;

  function showStatus(msg: string, type: 'info' | 'error' | 'success') {
    statusMsg.classList.remove('hidden', 'bg-blue-950', 'text-blue-300', 'bg-red-950', 'text-red-300', 'bg-emerald-950', 'text-emerald-300');
    if (type === 'error') {
      statusMsg.classList.add('bg-red-950', 'text-red-300', 'border', 'border-red-800');
    } else if (type === 'success') {
      statusMsg.classList.add('bg-emerald-950', 'text-emerald-300', 'border', 'border-emerald-800');
    } else {
      statusMsg.classList.add('bg-blue-950', 'text-blue-300', 'border', 'border-blue-800');
    }
    statusMsg.textContent = msg;
  }

  opacityInput?.addEventListener('input', () => {
    opacityVal.textContent = opacityInput.value;
  });

  dropZone.addEventListener('click', () => pdfInput.click());
  dropZone.addEventListener('dragover', (e) => e.preventDefault());
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer?.files.length) handleFile(e.dataTransfer.files[0]);
  });

  pdfInput.addEventListener('change', () => {
    if (pdfInput.files?.length) handleFile(pdfInput.files[0]);
  });

  function handleFile(file: File) {
    if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
      showStatus('Please select a valid PDF file.', 'error');
      return;
    }
    currentFile = file;
    optionsWorkspace.classList.remove('hidden');
    statusMsg.classList.add('hidden');
  }

  applyBtn.addEventListener('click', async () => {
    if (!currentFile) return;

    showStatus('Applying watermark in browser memory...', 'info');

    try {
      const res = await addWatermarkToPdf(currentFile, {
        text: textInput.value || 'CONFIDENTIAL',
        opacity: parseFloat(opacityInput.value || '0.3'),
        fontSize: parseInt(fontsizeInput.value || '48', 10),
        rotationAngle: parseInt(rotationInput.value || '45', 10),
      });

      const a = document.createElement('a');
      a.href = res.url;
      a.download = res.filename;
      a.click();

      showStatus(`Watermark applied successfully (${res.pageCount} pages, ${res.formattedSize}).`, 'success');
    } catch (err: any) {
      showStatus(err.message || 'Failed to apply watermark.', 'error');
    }
  });
</script>
