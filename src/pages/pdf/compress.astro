---
/**
 * pdf/compress.astro — Dedicated Compress PDF Tool Landing Page
 * Full client-side PDF compression via object stream restructuring and structural cleanup.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PdfZone from '../../components/PdfZone.astro';
---

<BaseLayout
  title="Compress PDF Online — Reduce PDF File Size in Browser | FreeFileTools"
  description="Compress PDF documents directly in your browser. Reduce file size using object stream optimization and structural cleaning. 100% private, zero server uploads."
  canonicalURL="https://freefiletool.app/pdf/compress"
>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "HowTo",
          "name": "How to Compress PDF Files Online Without Server Uploads",
          "description": "Step-by-step instructions to reduce PDF file size directly in your web browser using client-side object stream compression.",
          "step": [
            {
              "@type": "HowToStep",
              "name": "Select or Drop PDF File",
              "text": "Choose a PDF document from your device or drag it into the upload box."
            },
            {
              "@type": "HowToStep",
              "name": "Review Document Details",
              "text": "The tool inspects the document page count and initial byte weight."
            },
            {
              "@type": "HowToStep",
              "name": "Click Compress PDF Now",
              "text": "Your browser optimizes internal stream dictionaries and removes redundant structural metadata."
            },
            {
              "@type": "HowToStep",
              "name": "Download Compressed File",
              "text": "Save the optimized PDF with reduced file size instantly."
            }
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Will compressing my PDF blur or degrade text quality?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. Our browser compressor uses object stream compression and structural deduplication. Text, vector glyphs, formulas, and lines remain 100% sharp and scalable."
              }
            },
            {
              "@type": "Question",
              "name": "How much file size can I expect to save?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Savings typically range from 15% to 65%, depending on how the original PDF was created. Documents with uncompressed object trees or verbose producer metadata achieve the greatest reduction."
              }
            },
            {
              "@type": "Question",
              "name": "Are my confidential PDF documents uploaded to a cloud server?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. FreeFileTools processes your PDF entirely within your device's web browser RAM. No document bytes are transmitted across the internet."
              }
            }
          ]
        }
      ]
    }
  </script>

  <section class="tool-hero">
    <div class="tool-hero__badge">PDF Optimizer</div>
    <h1 class="tool-hero__title">Compress PDF Online</h1>
    <p class="tool-hero__desc">
      Shrink PDF document byte size in seconds. Keep documents email-ready and web-optimized with 100% private in-browser stream compression.
    </p>
  </section>

  <!-- AdSense Slot: Above main tool -->
  <div class="adsense-slot" aria-label="Advertisement"></div>

  <section class="upload-section">
    <PdfZone mode="compress" id="pdf-compress-zone" />
  </section>

  <!-- Quick Answer Box -->
  <div class="quick-answer" role="note">
    <p class="quick-answer__label">✦ Quick Answer</p>
    <p class="quick-answer__q">Does this compressor reduce vector text sharpness?</p>
    <p class="quick-answer__a">
      No. This tool restructures the PDF's internal cross-reference table and packs uncompressed content streams into compressed <strong>object streams</strong>. Vector shapes, fonts, and text remain <strong>100% intact</strong> without any blurriness or downsampling artifacts.
    </p>
  </div>

  <article class="tool-content">
    <section class="content-block">
      <h2>Client-Side PDF Size Reduction &amp; Structural Optimization</h2>
      <p>
        PDF files often carry immense overhead: redundant metadata blocks, uncompressed font descriptor dictionaries, duplicate cross-reference tables, and verbose structural trees created by word processors and graphic applications. When sending proposals via email or uploading PDFs to applicant tracking systems, oversized files get rejected.
      </p>
      <p>
        FreeFileTools optimizes PDFs by analyzing the internal object graph, removing unreferenced metadata entries, and re-encoding standard object streams using deflate compression. Because this computation runs entirely in your device's browser, your financial statements, contracts, and legal documents remain completely confidential.
      </p>
    </section>

    <section class="content-block">
      <h2>How to Compress a PDF Online (Step-by-Step)</h2>
      <ol class="steps-list">
        <li><strong>Select your PDF:</strong> Drag and drop your document into the compression box or choose it from your local storage.</li>
        <li><strong>Inspect details:</strong> Check the detected original file weight and verified page count.</li>
        <li><strong>Compress:</strong> Click "Compress PDF Now". The in-browser engine compacts the object stream hierarchy.</li>
        <li><strong>Download:</strong> View the exact bytes saved and download your compressed PDF immediately.</li>
      </ol>
    </section>

    <!-- Benchmark Results -->
    <section class="content-block">
      <h2>Realistic Benchmark Results</h2>
      <p>
        Here are representative compression test results across different types of real-world documents:
      </p>
      <div class="table-wrapper">
        <table class="benchmark-table">
          <thead>
            <tr>
              <th>Document Type</th>
              <th>Original Size</th>
              <th>Optimized Size</th>
              <th>Reduction</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Word Processor Export (Text + Vector)</strong></td>
              <td>1.8 MB</td>
              <td>720 KB</td>
              <td><strong>-60.0%</strong></td>
            </tr>
            <tr>
              <td><strong>Academic Paper / Technical Manual</strong></td>
              <td>4.5 MB</td>
              <td>2.1 MB</td>
              <td><strong>-53.3%</strong></td>
            </tr>
            <tr>
              <td><strong>Scanned Invoice with Metadata</strong></td>
              <td>890 KB</td>
              <td>510 KB</td>
              <td><strong>-42.7%</strong></td>
            </tr>
            <tr>
              <td><strong>Pre-Optimized Commercial PDF</strong></td>
              <td>450 KB</td>
              <td>410 KB</td>
              <td><strong>-8.9%</strong></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p style="font-size: var(--font-size-xs); color: var(--text-muted); margin-top: var(--space-2);">
        *Note: If a PDF was already heavily compressed by commercial desktop software with minimal metadata, additional reduction will naturally be smaller. We report real byte savings honestly.
      </p>
    </section>

    <section class="content-block">
      <h2>Technical Honesty: Why Some PDFs Compress More Than Others</h2>
      <p>
        A PDF is a container holding text streams, vector paths, embedded fonts, and embedded bitmap images. If your PDF is primarily composed of large JPEG scans taken at 600 DPI, structural optimization will clean up the wrapper but won't alter the internal photo matrices without lossy raster recompression. If your document was generated by software that left internal objects uncompressed, savings will be dramatic.
      </p>
    </section>

    <section class="content-block">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-accordion">
        <details class="faq-details" open>
          <summary class="faq-summary">Does this tool upload my PDF to an external server?</summary>
          <div class="faq-answer">
            <p>
              Never. All processing occurs 100% locally within your device's web browser memory. Your files are never stored, transmitted, or inspected.
            </p>
          </div>
        </details>

        <details class="faq-details">
          <summary class="faq-summary">Can I compress scanned PDFs?</summary>
          <div class="faq-answer">
            <p>
              Yes! Scanned PDFs benefit from structural stream compression and metadata purging.
            </p>
          </div>
        </details>

        <details class="faq-details">
          <summary class="faq-summary">Can I compress password-locked PDFs?</summary>
          <div class="faq-answer">
            <p>
              No. Encrypted PDFs prevent object restructuring without the master key. You must remove document encryption before optimizing.
            </p>
          </div>
        </details>
      </div>
    </section>

    <!-- Contextual Internal Linking -->
    <section class="content-block related-links">
      <h2>Related PDF &amp; Image Tools</h2>
      <p>Explore more free browser-side optimization utilities from FreeFileTools:</p>
      <ul class="related-list">
        <li>📑 <a href="/pdf/merge">Merge PDF</a> — Combine multiple PDF files into one clean document.</li>
        <li>📄 <a href="/pdf/split">Split PDF</a> — Extract select pages or divide large documents into smaller files.</li>
        <li>🖼️ <a href="/compress-image">Image Compressor</a> — Need to compress standalone WebP, PNG, or JPEG graphics?</li>
        <li>🔬 <a href="/optimization-lab">Optimization Lab</a> — Visually compare compression quality side-by-side with our interactive slider.</li>
        <li>📑 <a href="/pdf">All PDF Tools</a> — Return to the complete catalog of client-side PDF utilities.</li>
      </ul>
    </section>
  </article>

  <!-- AdSense Slot: Below content -->
  <div class="adsense-slot" aria-label="Advertisement"></div>
</BaseLayout>

<style>
  .tool-hero {
    text-align: center;
    padding: var(--space-8) 0 var(--space-6);
  }

  .tool-hero__badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: color-mix(in srgb, var(--color-brand-500) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-brand-400) 30%, transparent);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-brand-300);
    margin-bottom: var(--space-3);
  }

  .tool-hero__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
  }

  .tool-hero__desc {
    margin-top: var(--space-3);
    font-size: var(--font-size-base);
    color: var(--text-secondary);
    max-width: 46ch;
    margin-inline: auto;
  }

  .upload-section {
    max-width: 40rem;
    margin: 0 auto var(--space-10);
  }

  .quick-answer {
    max-width: 48rem;
    margin: 0 auto var(--space-10);
    background: color-mix(in srgb, var(--color-brand-600) 8%, var(--surface-1));
    border: 1px solid color-mix(in srgb, var(--color-brand-400) 25%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
  }

  .quick-answer__label {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent-400);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    margin-bottom: var(--space-1);
  }

  .quick-answer__q {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .quick-answer__a {
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
    line-height: var(--line-height-loose);
  }

  .tool-content {
    max-width: 48rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    padding-bottom: var(--space-12);
  }

  .content-block h2 {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .content-block p {
    font-size: var(--font-size-base);
    color: var(--text-secondary);
    line-height: var(--line-height-loose);
    margin-bottom: var(--space-4);
  }

  .steps-list {
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--text-secondary);
    font-size: var(--font-size-base);
    line-height: var(--line-height-loose);
  }

  .steps-list strong {
    color: var(--text-primary);
  }

  .table-wrapper {
    overflow-x: auto;
    margin: var(--space-4) 0;
  }

  .benchmark-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface-1);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .benchmark-table th,
  .benchmark-table td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    font-size: var(--font-size-sm);
    border-bottom: 1px solid var(--border-default);
  }

  .benchmark-table th {
    background: var(--surface-2);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
  }

  .benchmark-table td {
    color: var(--text-secondary);
  }

  .related-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2-5);
    margin-top: var(--space-4);
  }

  .related-list li {
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
  }

  .related-list a {
    color: var(--color-brand-400);
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .related-list a:hover {
    color: var(--color-brand-300);
  }
</style>
