---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivacyBadge from '../../components/PrivacyBadge.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const title = "Add Page Numbers to PDF Online — Free & Custom Page Numbering | FreeFileTool";
const description = "Add page numbers to your PDF documents 100% locally in your browser. Choose placement, format, and font size with zero file uploads.";
const canonicalURL = "https://freefiletool.app/pdf/page-numbers";

const faqItems = [
  {
    question: "How do I add page numbers to a PDF?",
    answer: "Select your PDF file, choose your preferred page number format (e.g. 'Page X of Y' or 'X') and position (top/bottom left, center, right), then click 'Add Page Numbers' to download the updated PDF."
  },
  {
    question: "Are my documents uploaded to a cloud server?",
    answer: "No. All page numbering calculations and text placement occur entirely inside your web browser using pdf-lib. No files ever leave your device."
  },
  {
    question: "Can I customize the font size and margins for the page numbers?",
    answer: "Yes, you can adjust font size, edge margins, and text position (bottom center, top right, etc.) before exporting."
  }
];
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "name": "FreeFileTool PDF Page Numbers",
        "url": canonicalURL,
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "All",
        "browserRequirements": "Requires JavaScript",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": { "@type": "Answer", "text": item.answer }
        }))
      }
    ]
  })} />

  <div class="tool-page-container max-w-6xl mx-auto px-4 py-8">
    <header class="tool-hero text-center mb-8">
      <div class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-400 border border-brand-500/20 mb-3">
        PDF Utilities
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-100 mb-3">Add Page Numbers to PDF</h1>
      <p class="text-slate-400 max-w-2xl mx-auto text-base sm:text-lg mb-4">
        Stamp clear, customizable page numbers onto every page of your PDF file instantly in your browser.
      </p>
      <div class="flex justify-center">
        <PrivacyBadge variant="badge" tech="pdf-lib" />
      </div>
    </header>

    <main class="tool-workspace my-8 bg-slate-900/60 border border-slate-800 rounded-xl p-4 sm:p-6 shadow-xl">
      <div id="drop-zone" class="border-2 border-dashed border-slate-700 hover:border-brand-500 rounded-xl p-8 text-center cursor-pointer transition-colors">
        <input type="file" id="pdf-input" accept=".pdf,application/pdf" class="hidden" />
        <div class="text-4xl mb-3">🔢</div>
        <p class="text-slate-200 font-semibold mb-1">Click to browse or drop your PDF here</p>
        <p class="text-slate-400 text-sm">Select any PDF document · Processed 100% in local RAM</p>
      </div>

      <div id="status-msg" class="hidden my-4 p-4 rounded-lg text-sm text-center"></div>

      <div id="options-workspace" class="hidden mt-6 bg-slate-800/80 border border-slate-700 rounded-xl p-6">
        <h2 class="text-lg font-bold text-slate-100 mb-4">Page Numbering Settings</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Position</label>
            <select id="position-select" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm text-slate-200">
              <option value="bottom-center" selected>Bottom Center</option>
              <option value="bottom-right">Bottom Right</option>
              <option value="bottom-left">Bottom Left</option>
              <option value="top-center">Top Center</option>
              <option value="top-right">Top Right</option>
              <option value="top-left">Top Left</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Format</label>
            <select id="format-select" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm text-slate-200">
              <option value="page-of-total" selected>Page X of Y</option>
              <option value="number-only">Page X</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Font Size (pt)</label>
            <input type="number" id="fontsize-input" value="10" min="6" max="24" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm text-slate-200" />
          </div>
        </div>

        <button id="apply-btn" class="w-full sm:w-auto px-6 py-2.5 bg-brand-600 hover:bg-brand-500 text-white font-bold rounded-lg text-sm transition-colors shadow-lg">
          Add Page Numbers & Download
        </button>
      </div>
    </main>

    <section class="tool-guide-content prose prose-invert max-w-none my-12 bg-slate-900/40 border border-slate-800/80 rounded-xl p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">How to Add Page Numbers to PDF Files</h2>
      <p class="text-slate-300">
        When compiling academic papers, legal exhibits, or business proposals, adding sequential page numbers ensures readers can easily reference specific pages. FreeFileTool adds page numbering to your PDF documents locally without uploading your files to remote web servers.
      </p>

      <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Quick Steps</h3>
      <ol class="list-decimal pl-5 space-y-2 text-slate-300">
        <li><strong>Select PDF:</strong> Drop or select your file.</li>
        <li><strong>Configure settings:</strong> Pick position (bottom center, top right, etc.) and format ("Page X of Y").</li>
        <li><strong>Apply & Download:</strong> Click the process button to stamp page numbers onto all pages instantly.</li>
      </ol>

      <div class="tool-faq-block mt-10 pt-8 border-t border-slate-800">
        <h2 class="text-2xl font-bold text-slate-100 mb-6">Frequently Asked Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {faqItems.map(item => (
            <div class="faq-item-card bg-slate-800/50 border border-slate-700/50 rounded-lg p-5">
              <h3 class="text-lg font-semibold text-slate-200 mb-2">{item.question}</h3>
              <p class="text-slate-400 text-sm leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <RelatedTools currentSlug="pdf/page-numbers" limit={4} />
  </div>
</BaseLayout>

<script>
  import { addPageNumbersToPdf } from '../../lib/pdf/pdfEngine.js';

  let currentFile: File | null = null;
  const dropZone = document.getElementById('drop-zone')!;
  const pdfInput = document.getElementById('pdf-input') as HTMLInputElement;
  const statusMsg = document.getElementById('status-msg')!;
  const optionsWorkspace = document.getElementById('options-workspace')!;
  const positionSelect = document.getElementById('position-select') as HTMLSelectElement;
  const formatSelect = document.getElementById('format-select') as HTMLSelectElement;
  const fontsizeInput = document.getElementById('fontsize-input') as HTMLInputElement;
  const applyBtn = document.getElementById('apply-btn')!;

  function showStatus(msg: string, type: 'info' | 'error' | 'success') {
    statusMsg.classList.remove('hidden', 'bg-blue-950', 'text-blue-300', 'bg-red-950', 'text-red-300', 'bg-emerald-950', 'text-emerald-300');
    if (type === 'error') {
      statusMsg.classList.add('bg-red-950', 'text-red-300', 'border', 'border-red-800');
    } else if (type === 'success') {
      statusMsg.classList.add('bg-emerald-950', 'text-emerald-300', 'border', 'border-emerald-800');
    } else {
      statusMsg.classList.add('bg-blue-950', 'text-blue-300', 'border', 'border-blue-800');
    }
    statusMsg.textContent = msg;
  }

  dropZone.addEventListener('click', () => pdfInput.click());
  dropZone.addEventListener('dragover', (e) => e.preventDefault());
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer?.files.length) handleFile(e.dataTransfer.files[0]);
  });

  pdfInput.addEventListener('change', () => {
    if (pdfInput.files?.length) handleFile(pdfInput.files[0]);
  });

  function handleFile(file: File) {
    if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
      showStatus('Please select a valid PDF file.', 'error');
      return;
    }
    currentFile = file;
    optionsWorkspace.classList.remove('hidden');
    statusMsg.classList.add('hidden');
  }

  applyBtn.addEventListener('click', async () => {
    if (!currentFile) return;

    showStatus('Stamping page numbers in browser memory...', 'info');

    try {
      const res = await addPageNumbersToPdf(currentFile, {
        position: positionSelect.value,
        format: formatSelect.value,
        fontSize: parseInt(fontsizeInput.value || '10', 10),
      });

      const a = document.createElement('a');
      a.href = res.url;
      a.download = res.filename;
      a.click();

      showStatus(`Page numbers added successfully (${res.pageCount} pages, ${res.formattedSize}).`, 'success');
    } catch (err: any) {
      showStatus(err.message || 'Failed to add page numbers.', 'error');
    }
  });
</script>
