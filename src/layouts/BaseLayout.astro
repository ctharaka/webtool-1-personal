---
/**
 * BaseLayout.astro
 * Global shell — locked dark mode, SEO metadata, JSZip CDN integration,
 * header navigation (Home, Tools, Guides, About, Contact), and AdSense-compliant footer navigation.
 *
 * Security hardening:
 *  - CSP restricts scripts to 'self' + cdnjs.cloudflare.com (JSZip) + fonts.googleapis.com
 *  - X-Frame-Options: DENY — prevents clickjacking
 *  - X-Content-Type-Options: nosniff — prevents MIME-sniffing
 *  - Referrer-Policy: strict-origin-when-cross-origin
 */
export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  robots?: string;
}

const siteName = "FreeFileTool";
const {
  title = "FreeFileTool - Online File Utilities & Optimization Lab",
  description = "Free online file tools: compress, convert, and optimize images directly in your browser. 100% private and fast.",
  robots = "index, follow",
} = Astro.props;
let { canonicalURL = Astro.url.href } = Astro.props;
canonicalURL = canonicalURL.endsWith('/') ? canonicalURL : `${canonicalURL}/`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || "https://freefiletool.app";
const ogImageUrl = `${siteUrl}/og-image.png`;
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- ── Security Headers (via meta tags for static hosting) ── -->
    <!--
      Content-Security-Policy:
        - default-src 'self'         : Only our own origin by default
        - script-src 'self' cdnjs    : Allow our scripts + JSZip CDN
        - style-src 'self' fonts.googleapis.com 'unsafe-inline' : Google Fonts + scoped Astro styles
        - font-src fonts.gstatic.com : Google Fonts files
        - img-src 'self' blob: data: : Local images + canvas blob URLs
        - worker-src 'self' blob:    : Blob workers + same-origin workers (PDF.js)
        - object-src 'none'           : Block plugins (Flash etc.)
        - base-uri 'self'             : Prevent base-tag injection
        - form-action 'self' mailto:  : Contact form mailto links
        - frame-ancestors 'none'      : Deny embedding in iframes
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none';"
    />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL || Astro.url.href} />
    <meta name="robots" content={robots} />

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalURL || siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL || siteUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "alternateName": ["Free File Tools"],
      "url": siteUrl
    })} />

    <!-- Fonts (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site-header" role="banner">
      <div class="header-inner">
        <a href="/" class="logo" aria-label="FreeFileTools home">
          <svg class="logo-icon" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <rect x="2" y="2" width="24" height="24" rx="6" stroke="var(--color-brand-400)" stroke-width="2" />
            <path d="M9 14h10M14 9v10" stroke="var(--color-accent-400)" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span class="logo-text">Free<strong>FileTools</strong></span>
        </a>

        <nav class="site-nav" aria-label="Main Navigation">
          <!-- Mobile menu toggle button (min 44px touch target) -->
          <button
            id="mobile-menu-toggle"
            class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-lg text-secondary hover:text-primary hover:bg-surface-2 focus:outline-none focus:ring-2 focus:ring-brand-400"
            aria-label="Toggle navigation"
            aria-controls="mobile-nav"
            aria-expanded="false"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
          <ul id="mobile-nav" class="nav-list hidden md:flex md:flex-row md:items-center md:space-x-4">
            <li class="nav-item"><a href="/" class="nav-link">Home</a></li>
            <li class="nav-item"><a href="/image-tools" class="nav-link">Image Tools</a></li>
            <li class="nav-item"><a href="/pdf" class="nav-link">PDF Tools</a></li>
            <li class="nav-item"><a href="/text-tools" class="nav-link">Text Tools</a></li>
            <li class="nav-item"><a href="/audio-tools" class="nav-link">Audio Tools</a></li>
            <li class="nav-item"><a href="/optimization-lab" class="nav-link nav-link--highlight">Optimization Lab</a></li>
            <li class="nav-item"><a href="/guides" class="nav-link">Guides</a></li>
            <li class="nav-item"><a href="/about" class="nav-link">About</a></li>
            <li class="nav-item"><a href="/privacy-tools" class="nav-link">Privacy &amp; Security</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content">
      {Astro.url.pathname !== '/' && (
        <div class="breadcrumb-container" style="max-width: 88rem; margin: 0 auto; padding: var(--space-4) var(--space-6) 0;">
          <Breadcrumbs />
        </div>
      )}
      <slot />
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="logo" aria-label="FreeFileTool home">
            <svg class="logo-icon" viewBox="0 0 28 28" fill="none" aria-hidden="true">
              <rect x="2" y="2" width="24" height="24" rx="6" stroke="var(--color-brand-400)" stroke-width="2" />
              <path d="M9 14h10M14 9v10" stroke="var(--color-accent-400)" stroke-width="2" stroke-linecap="round" />
            </svg>
            <span class="logo-text">Free<strong>FileTool</strong></span>
          </a>
          <p class="footer-desc">
            Your files are processed on your device and are never uploaded.
          </p>
          <p class="footer-contact-info">
            Support: <a href="mailto:freefiletool@gmail.com" class="footer-email-link">freefiletool@gmail.com</a>
          </p>
        </div>

        <div class="footer-grid">
          <div class="footer-col">
            <h3 class="footer-heading">Image Tools</h3>
            <ul class="footer-links">
              <li><a href="/heic-to-jpg">HEIC to JPG Converter</a></li>
              <li><a href="/social-image-resizer">Social Image Resizer</a></li>
              <li><a href="/favicon-generator">Favicon Generator</a></li>
              <li><a href="/image-crop-rotate">Image Crop &amp; Rotate</a></li>
              <li><a href="/svg-to-png">SVG to PNG Converter</a></li>
              <li><a href="/png-to-jpg">PNG to JPG Converter</a></li>
              <li><a href="/jpg-to-png">JPG to PNG Converter</a></li>
              <li><a href="/image-optimizer">Web Image Optimizer</a></li>
              <li><a href="/image-converter">Image Converter (All Formats)</a></li>
              <li><a href="/image-tools">All Image Tools</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h3 class="footer-heading">Privacy &amp; Security</h3>
            <ul class="footer-links">
              <li><a href="/file-inspector">Browser File Inspector</a></li>
              <li><a href="/privacy-tools/exif-remover">Free EXIF Remover</a></li>
              <li><a href="/privacy-tools">All Privacy Tools</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h3 class="footer-heading">PDF Tools</h3>
            <ul class="footer-links">
              <li><a href="/pdf/organize">Organize PDF Pages</a></li>
              <li><a href="/pdf/sign">Sign PDF Document</a></li>
              <li><a href="/pdf/page-numbers">Add Page Numbers</a></li>
              <li><a href="/pdf/watermark">Add PDF Watermark</a></li>
              <li><a href="/pdf/to-text">PDF to Text</a></li>
              <li><a href="/pdf/merge">Merge PDF</a></li>
              <li><a href="/pdf/split">Split PDF</a></li>
              <li><a href="/pdf/compress">Compress PDF</a></li>
              <li><a href="/pdf">All PDF Tools</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h3 class="footer-heading">Text &amp; Archives</h3>
            <ul class="footer-links">
              <li><a href="/text-to-pdf">Text to PDF</a></li>
              <li><a href="/zip-creator">ZIP Creator</a></li>
              <li><a href="/zip-extractor">ZIP Extractor</a></li>
              <li><a href="/qr-code-generator">QR Code Generator</a></li>
              <li><a href="/json-formatter">JSON Formatter</a></li>
              <li><a href="/base64-encoder-decoder">Base64 Converter</a></li>
              <li><a href="/hash-generator">Hash Generator</a></li>
              <li><a href="/text-tools">All Text Tools</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h3 class="footer-heading">Audio Tools</h3>
            <ul class="footer-links">
              <li><a href="/mp4-to-mp3">MP4 to MP3 Converter</a></li>
              <li><a href="/audio-converter">Universal Audio Converter</a></li>
              <li><a href="/wav-to-mp3">WAV to MP3</a></li>
              <li><a href="/mp3-to-wav">MP3 to WAV</a></li>
              <li><a href="/audio-trimmer">Audio Trimmer</a></li>
              <li><a href="/audio-tools">All Audio Tools</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h3 class="footer-heading">Guides</h3>
            <ul class="footer-links">
              <li><a href="/guides/pdf-tools">Complete PDF Guide</a></li>
              <li><a href="/guides/webp-vs-png-vs-jpeg-which-format-to-use">WebP vs PNG vs JPEG</a></li>
              <li><a href="/guides/how-to-reduce-image-size-without-losing-quality">How to Reduce Image Size</a></li>
              <li><a href="/guides/what-is-a-hash-and-when-do-you-need-one">What is a Hash?</a></li>
              <li><a href="/guides/wav-vs-mp3-which-audio-format-to-use">WAV vs MP3 Guide</a></li>
              <li><a href="/guides">All Guides</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h3 class="footer-heading">Legal &amp; Info</h3>
            <ul class="footer-links">
              <li><a href="/about">About Us</a></li>
              <li><a href="/contact">Contact Us</a></li>
              <li><a href="/privacy-policy">Privacy Policy</a></li>
              <li><a href="/terms">Terms of Service</a></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} FreeFileTool. All rights reserved. Support: <a href="mailto:freefiletool@gmail.com" class="footer-email-link">freefiletool@gmail.com</a></p>
      </div>
    </footer>
  <script>
    // Mobile navigation interaction & accessibility enhancements
    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.getElementById('mobile-menu-toggle');
      const nav = document.getElementById('mobile-nav');
      if (!toggle || !nav) return;

      const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
      const navLinks = nav.querySelectorAll('.nav-link');

      // Highlight active link matching current path
      navLinks.forEach((link) => {
        const href = (link.getAttribute('href') || '').replace(/\/$/, '') || '/';
        if (href === currentPath || (href !== '/' && currentPath.startsWith(href))) {
          link.classList.add('nav-link--active');
          link.setAttribute('aria-current', 'page');
        }
      });

      const toggleMenu = (show?: boolean) => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        const targetState = typeof show === 'boolean' ? show : !isExpanded;
        
        toggle.setAttribute('aria-expanded', String(targetState));
        if (targetState) {
          nav.classList.remove('hidden');
          const firstLink = nav.querySelector('a');
          firstLink && firstLink.focus();
        } else {
          nav.classList.add('hidden');
        }
      };

      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      toggle.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleMenu();
        }
      });

      // Auto-close menu when clicking a link inside
      navLinks.forEach((link) => {
        link.addEventListener('click', () => {
          if (toggle.getAttribute('aria-expanded') === 'true') {
            toggleMenu(false);
          }
        });
      });

      // Close when clicking outside header navigation
      document.addEventListener('click', (e) => {
        if (toggle.getAttribute('aria-expanded') === 'true' && !nav.contains(e.target as Node) && !toggle.contains(e.target as Node)) {
          toggleMenu(false);
        }
      });

      // Close menu on Escape key press
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
          e.preventDefault();
          toggleMenu(false);
          toggle.focus();
        }
      });
    });
  </script>
  
</body>
</html>
<style is:global>
  @import '../styles/tokens.css';

  /* ── Reset ─────────────────────────────────────────────── */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 100%;
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-family-sans);
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
    color: var(--text-primary);
    background: var(--surface-0);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
    color: inherit;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* ── Skip-link ─────────────────────────────────────────── */
  .skip-link {
    position: fixed;
    top: -100%;
    left: var(--space-4);
    z-index: 9999;
    padding: var(--space-2) var(--space-4);
    background: var(--color-brand-600);
    color: #fff;
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-semibold);
    transition: top var(--transition-fast);
  }

  .skip-link:focus {
    top: var(--space-4);
  }

  /* ── Header ────────────────────────────────────────────── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    background: color-mix(in srgb, var(--surface-1) 85%, transparent);
    border-bottom: 1px solid var(--border-default);
  }

  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 88rem;
    margin: 0 auto;
    padding: var(--space-3) var(--space-6);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-normal);
    letter-spacing: var(--letter-spacing-tight);
    transition: opacity var(--transition-fast);
    white-space: nowrap;
  }

  .logo:hover {
    opacity: 0.85;
  }

  .logo-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  .logo-text strong {
    font-weight: var(--font-weight-bold);
    background: linear-gradient(135deg, var(--color-brand-400), var(--color-accent-400));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* ── Navigation ────────────────────────────────────────── */
  .site-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--text-secondary);
    transition: color var(--transition-fast), background var(--transition-fast);
    padding: var(--space-2) 0;
    cursor: pointer;
  }

  .nav-link:hover,
  .nav-link.nav-link--active {
    color: var(--text-primary);
  }

  .nav-link--highlight {
    color: var(--color-accent-400);
    font-weight: var(--font-weight-semibold);
  }

  .nav-link--highlight:hover {
    color: var(--color-accent-400);
    opacity: 0.8;
  }

  /* Mobile Dropdown Panel */
  @media (max-width: 767px) {
    .header-inner {
      padding: var(--space-2.5) var(--space-4);
    }

    #mobile-nav {
      list-style: none;
      margin: 0;
    }

    #mobile-nav:not(.hidden) {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: calc(100% + var(--space-2));
      left: var(--space-4);
      right: var(--space-4);
      background: var(--surface-2);
      border: 1px solid var(--border-default);
      border-radius: var(--radius-xl);
      padding: var(--space-3);
      gap: var(--space-1);
      box-shadow: var(--shadow-xl);
      max-height: calc(100vh - 80px);
      max-height: calc(100dvh - 80px);
      overflow-y: auto;
      z-index: 500;
    }

    #mobile-nav .nav-item {
      width: 100%;
    }

    #mobile-nav .nav-link {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 0 var(--space-4);
      border-radius: var(--radius-md);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-medium);
      color: var(--text-secondary);
    }

    #mobile-nav .nav-link:hover,
    #mobile-nav .nav-link:focus,
    #mobile-nav .nav-link.nav-link--active {
      background: var(--surface-3);
      color: var(--text-primary);
    }

    #mobile-nav .nav-link--highlight {
      color: var(--color-accent-400);
      background: color-mix(in srgb, var(--color-accent-500) 10%, transparent);
    }

    .breadcrumb-container {
      padding: var(--space-3) var(--space-4) 0 !important;
    }
  }

  /* Dropdown Menu */
  .has-dropdown:hover .dropdown-menu,
  .has-dropdown:focus-within .dropdown-menu {
    display: block;
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 180px;
    padding: var(--space-2);
    background: var(--surface-2);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
    z-index: 200;
  }

  .dropdown-link {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
    border-radius: var(--radius-md);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .dropdown-link:hover {
    background: var(--surface-3);
    color: var(--color-brand-300);
  }

  /* ── Main Content ──────────────────────────────────────── */
  #main-content {
    flex: 1;
    width: 100%;
    max-width: 88rem;
    margin: 0 auto;
    padding: clamp(var(--space-5), 3vw, var(--space-8)) clamp(var(--space-4), 3vw, var(--space-6));
  }

  /* ── Footer ────────────────────────────────────────────── */
  .site-footer {
    background: var(--surface-1);
    border-top: 1px solid var(--border-default);
    padding: var(--space-12) var(--space-6) var(--space-6);
    margin-top: auto;
  }

  .footer-inner {
    max-width: 88rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-10);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-desc {
    font-size: var(--font-size-sm);
    color: var(--text-muted);
    line-height: var(--line-height-loose);
    max-width: 32ch;
  }

  .footer-contact-info {
    font-size: var(--font-size-xs);
    color: var(--text-secondary);
  }

  .footer-email-link {
    color: var(--color-brand-400);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-email-link:hover {
    color: var(--color-brand-300);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-6);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  .footer-heading {
